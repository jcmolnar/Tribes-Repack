$MDESC::Creator = "EEPROM";
$MDESC::Type = "Football Extreme";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium: <f0> Mud-R-Us" @
         "\n<f1>Visibility: <f0> Foggy" @
         "\n<f1># of Teams: <f0> 2" @
         "\n<f1>Specials: <f0> Jump pads, Hilly terrain" @
         "\n\n<f1>Description:\n<f0>The loget stadium yet folks!! Built using the Rollercoaster terrain this fine map features rolling hills and mudy terrain within the stadium itself. Your team must grab the ball and ski jump, run, walk, whatever to the other teams end zone box. The team that scores 15 touchdowns wins the game." @
         "\n\n<jc><f1>**<f0>Map engineered and designed by:<f1>**\n<f2>EEPROM (Mappers Extreme)\n\n\n<f0>Completed 10/24/00\n<f0>Re-mix completed 11/27/00";

