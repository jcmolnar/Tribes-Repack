$MDESC::Creator = "EEPROM";
$MDESC::Type = "Football Extreme";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium: <f0> Slopes" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Description:\n<f0>This dark stadium features three long slides, with flat sections in between, and a huge flat plain at the bottom (where the endzones are located). Each team starts out at the top of the massive, sloping stadium, and players can choose between two paths to the goal: One slide brings them past the ball's spawn point; the other takes them straight to the endzone. To score, the ball carrier must jump into the other team's goal hole. The team that scores 15 touchdowns wins the game." @
         "\n\n<jc><f1>**<f0>Map engineered and designed by:<f1>**\n<f2>EEPROM (Mappers Extreme)\n\n\n<f0>Completed 10/24/00";

