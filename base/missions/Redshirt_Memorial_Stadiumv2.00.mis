//--- export object end ---//
$teamScoreLimit = 40;
exec(objectives);
$Game::missionType = "football";
$cdTrack = 8;
$cdPlayMode = 1;

function GroupTrigger::onEnter( %this, %object )
{
  %clientId = Player::getClient( %object );

  if(( %this.isNML == "True" ) && ( getObjectType( %object ) == "Player" ))
    {
      if( Player::getItemCount( %clientId, "Football" ))
	if( %this.isOnEZ == "True" )
	  {
	    Player::decItemCount( %clientId, Football );
	    Player::unMountItem( %clientId, $FlagSlot );

	    SpawnFootball( AppropriateSide( GameBase::getTeam( %this )));

            $CurrentFootball.owner = %clientId;
	  }
	else
	  LoseFootball( %clientId, drop );
      
      if( %this.isOnEZ == "True" )
	Client::sendMessage( %clientId, $MsgRed, "Thou shalt not climb the endzone. ~wLeftMissionArea.wav" );
      else
	Client::sendMessage( %clientId, $MsgRed, "Thou shalt not climb the walls. ~wLeftMissionArea.wav" );
      
      GameBase::setPosition( %clientId, "0 0 0" );		
    }

  if( %this.isDamageZone == "True" )
    {
      %pTeam = GameBase::getTeam( %clientId );
      %tTeam = AppropriateSide( GameBase::getTeam( %this ));

      if( %pTeam != %tTeam )
	%object.outArea = 1;
    }
}

function GroupTrigger::onTrigLeave( %this, %object )
{
  %clientId = Player::getClient( %object );

  if( %this.isDamageZone == "True" )
    %object.outArea = 0;
}
