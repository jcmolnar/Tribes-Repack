$MDESC::Type = "Football";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium:<f0> LN2 Stadium" @
         "\n<f1>Weather:<f0> Clear" @
         "\n<f1>Time of Day:<f0> Night" @
         "\n<f1># of Teams:<f0> 2" @
         "\n\n<f1>Description:\n<f0> Relatives of the victims turned the former site of the great Blood Eagle Slaughter on Deus Sanguinus into a memorial stadium, where Blood Eagle and Diamond Sword teams can fight it out on the gridiron with a football instead of on the harsh, moonlit planet's surface with spinfusors. Don't try running through the endzone goalposts to score: you need to run across the force fields above the endzones to make a touchdown." @
         "\n\n<f1>Map by:<f0> Lackey No. 2 (Uploaded 30 October 2000)";

