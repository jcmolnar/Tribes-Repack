$MDESC::Type = "GSL Football";
$MDESC::Text = "<s3><f1>Mission Type: <f0>GSL Football" @
         "\n<f1>Stadium: <f0> Redshirt Memorial Stadium" @
	 "\n<f1>Version: <f0> 1.11" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing: <f0> The <vServer::TeamName0> and <vServer::TeamName1> face off in a game of Tribes football at Redshirt Memorial Stadium." @
	 "\n\n\"He`s dead, Jim.\"" @
	 "\n\"Jim, he`s dead.\"" @
	 "\n\"Dammit Jim, I`ve lost him.\"" @
	 "\n\"He`s dead.\"" @
	 "\n\"I`m sorry, Jim, he`s dead.\"" @
	 "\n        -- Dr. Leonard McCoy" @
	 "\n           TV`s Star Trek" @
	 "\n" @
	 "\nChanges in v1.11:  Prevent players from potentially getting on walls." @
	 "\nChanges in v1.10:  Modifications made to map to prevent skiing out of the stadium and getting on top of the endzones." @
         "\n\n<f1>Map by: <f0> Lackey No. 2";

