function ForceFieldBlue::onCollision(%this,%obj){
	if(getObjectType(%obj)!="Player" || Player::isDead(%obj)) {
		return;
	}
	%c = Player::getClient(%obj);
	%playerTeam = GameBase::getTeam(%obj);
	%Team = GameBase::getTeam(%this);
		if(%Team != %playerTeam){ 
		   %energy = GameBase::getEnergy(%obj);
 		   %energy = %energy - 30;
		   if (%energy < 0)  %energy = 0;
		   GameBase::setEnergy(%obj, %energy);
		   client::sendmessage(%c, 1, "Access Denied ~wAccess_Denied.wav");
		   Player::setDamageFlash(%obj,0.5);
		%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),-100,4);
		Player::applyImpulse(%obj,%jumpDir);
		   return;
		}
	schedule("ForceFieldBlue::openDoor("@%this@");",1);
	return;
	}


function ForceFieldBlue::openDoor(%this) {

	//GameBase::startfadeout(%this);
	%pos=GameBase::getPosition(%this);
	GameBase::playSound(%this, forcefieldopen, 0);
	%pos=Vector::add(%pos,"0 0 -7");
	GameBase::setPosition(%this,%pos);
	schedule("ForceFieldBlue::closeDoor("@%this@");",2.5);
	}

function ForceFieldBlue::closeDoor(%this) {
	%pos=GameBase::getPosition(%this);
	%pos=Vector::add(%pos,"0 0 7");
	GameBase::setPosition(%this,%pos);
	GameBase::playSound(%this, forcefieldopen, 0);
	}

function BigBlueTele::onCollision(%this,%obj){
	//client::sendmessage(%c, 0, "~wshieldhit.wav"); 
	if(getObjectType(%obj)!="Player" || Player::isDead(%obj)) {
		return;
	}
	%c = Player::getClient(%obj);
	%playerTeam = GameBase::getTeam(%obj);
	%Team = GameBase::getTeam(%this);
	if(%Team != %playerTeam) return;
	%pos = "-376.595 -696.988 476.808";
      GameBase::setPosition(%c, %pos);
	client::sendmessage(%c, 0, "Hey! This Map is by {-o-} Plasmatic~wmale1.wwatchsh.wav"); 
	return;
	}

function Mortarific::ondamage(%this,%type,%value,%pos,%vec,%mom,%object){
	centerprint(%object, "<jc><f1>You cannot kill that, you're wasting ammo.", 5);
	client::sendmessage(%object, 0, "~wshieldhit.wav"); 
	}

