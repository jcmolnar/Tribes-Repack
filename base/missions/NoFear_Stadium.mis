//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function elevator6x6Octa::onCollision(%this,%obj)
{
	%c = Player::getClient(%obj);
	if (floor(getRandom() * 30) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 600; %zVec = 20;
		%rnd = floor(getRandom() * 3);
		if (%rnd == 0)
		{ 
		} 
		else if (%rnd == 1) 
		{
		} 
		else if (%rnd == 2) 
		{ 
		}
	} 
	else if (floor(getRandom() * 7) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 600; %zVec = 20;
	} 
	else 
	{ 
		GameBase::playSound(%this, SoundFireMortar, 0);
		%velocity = 600;
		%zVec = 20;
	} 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
} 


//grenadeAmmo flasher\\
temImageData GrenadeAmmo
{
description = "";
shapeFile = "breath";
showInventory = false;
shadowDetailMask = 4;
lightType = 2;
lightRadius = 20; //radius of the light
lightTime = 0.1;
lightColor = { 0, 1, 0 }; //color(tribes uniscale)
};

function GrenadeAmmo::onDrop(%player)
{
%playerid = player::getclient(%player);
client::sendmessage(%playerid, 0, "Unable to drop item");
}

function GrenadeAmmo::onDamage()
{