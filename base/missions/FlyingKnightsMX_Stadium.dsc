$MDESC::Type = "Football Extreme";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium: <f0> Flying Knights" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Descrition:\n<f0>A dark stadium with black floors and mid size walls all around. The goals are two vertical hoops. Two jump pads for each team, use them to score. <f2>Disc Launchers and Mortar turrets have been provided for enhanced game play.<f0>40 points wins the game." @
         "\n\n<jc><f1>**<f0>Map engineered and designed by:<f1>**\n<f2>EEPROM (Mappers Extreme)\n\n\n<f0>Completed: 10/30/00";


