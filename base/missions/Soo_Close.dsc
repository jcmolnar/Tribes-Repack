$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Cant remember" @
         "\n<f1>Weather: <f0> Clearing" @
         "\n<f1>Time of Day: <f0> Noon" @ 
         "\n<f1># of Teams: <f0> 2" @
	 "\n\n<f1>Description:<f0> <vServer::teamName1> and <vServer::teamName0> Battle with their flag very very close together. You can actually see the other flag in front of yours only a few feet away. Though, there is an added twist!" @

"\n\n<f1>Briefing:<f0> Each team must grab the other's flag and bring it back to your base to capture it for <f1>1 point" @
"\nThe first team to reach <f1> 8 points<f4> shall be the victor." @

"\n\n<f1>Map By:<f4> t0xic" @" \nCheck This site weekly for new maps http://www.planetstarsiege.com/catalog/custom_maps.html" ;
