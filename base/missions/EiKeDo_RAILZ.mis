$teamScoreLimit = 190;
exec(objectives);
$Game::MissionType = "Football";
$cdTrack = 3;
$cdPlayMode = 1;

//==[Enter the EiKeDo]
function LargeAntenna::onCollision(%this,%obj)
{
   if(%this.rtype == "Grind Rail")
   {
	%c = Player::getClient(%obj);
	GameBase::playSound(%this, SoundPlasmaTurretTurn, 0);
	%velocity = 250;
	%zVec = 0;
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Item::setVelocity(%c, "0 0 0");
	Player::applyImpulse(%obj,%jumpDir);
   }
   else if(%this.rtype == "")
   {
   return;
   }
}
function SmallAntenna::onCollision(%this,%obj)
{
   if(%this.rtype == "Boost Rail")
   {
	%c = Player::getClient(%obj);
	GameBase::playSound(%this, SoundPlasmaTurretTurn, 0);
	%velocity = 0;
	%zVec = 250;
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
   }
   else if(%this.rtype == "")
   {
   return;
   }
}
function elevator8x4::onCollision(%this,%obj)
{
	if(%this.rtype == "Respawn")
	{
		%c = Player::getClient(%obj);
		%team = GameBase::getTeam(%c);
		%spawn = Game::pickRandomSpawn(%team);
		Item::setVelocity(%c, "0 0 0");
		GameBase::setPosition(%c, GameBase::getPosition(%spawn));
	}
	else if(%this.rtype == "")
	{
		%c = Player::getClient(%obj);
		if (floor(getRandom() * 30) == 0)
		{ 
			GameBase::playSound(%this, debrisLargeExplosion, 0);
			%velocity = 600; %zVec = 0;
			%rnd = floor(getRandom() * 3);
			if (%rnd == 0)
			{ 
			} 
			else if (%rnd == 1) 
			{
			} 
			else if (%rnd == 2) 
			{ 
			}
		} 
		else if (floor(getRandom() * 7) == 0)
		{ 
			GameBase::playSound(%this, debrisLargeExplosion, 0);
			%velocity = 600; %zVec = 0;
		} 
		else 
		{ 
			GameBase::playSound(%this, SoundFireMortar, 0);
			%velocity = 600;
			%zVec = 0;
		} 
		%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
		Player::applyImpulse(%obj,%jumpDir);
	}
}	
