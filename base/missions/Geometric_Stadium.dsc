$MDESC::Creator = "EEPROM";
$MDESC::Type = "Football";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium: <f0> Flying Knights" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Description:\n<f0>A dark stadium with black floors and no walls. Tower markers are set to show out-of-bounds. Goals are two huge pyramid structures, climb to the top to score.<f2>Disc Launchers have been provided for enhanced game play.<f0>40 points wins the game." @
         "\n\n<jc><f1>**<f0>Map engineered and designed by:<f1>**\n<f2>EEPROM (Mappers Extreme)";

