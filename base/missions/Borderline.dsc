$MDESC::Type = "Capture the Flag";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Zenophen" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Dusk" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> tribes have both setup watch stations near the border on planet Zenophen. Your team has compiled the most elite tribe unit anywhere. Your mission is to make it past the border troops, go into the enemy territory and steal their flag 8 times. The winner will declare rule over the entire planet until the next battle is waged!";
