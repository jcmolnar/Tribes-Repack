//Teleport
function GroupTrigger::onEnter(%this, %object)
{
  if(%this.num == "Teleport"){
    %client = Player::getClient(%object);
  
    %clPos = GameBase::getPosition(%object);
    %posX = getWord(%clPos, 0);
    %posY = getWord(%clPos, 1);
    %posZ = getWord(%clPos, 2);
    
    %trigX = getWord(GameBase::getPosition(%this), 0);
    %trigXRoof = %trigX + (%this.side / 2) + 2;
    %trigXFloor = %trigX - (%this.side / 2) - 2;
  
    %displacement = 2;

    if((%posX < %trigX) && (%posX > %trigXFloor) && (%posX < %trigXRoof)){
      %posX = %trigXRoof + %displacement;
      Client::SendMessage(%client,0,"~wshieldhit.wav");
    }
    else if((%posX >= %trigX) && (%posX > %trigXFloor) && (%posX < %trigXRoof)){
      %posX = %trigXFloor - %displacement;
      Client::SendMessage(%client,0,"~wshieldhit.wav");
    }
    else {
	// DO NOTHING! ) :P ;) :D
    }

    GameBase::setPosition(%client, %posX @ " " @ %posY @ " " @ %posZ);
  }
}


//--- export object end ---//
$teamScoreLimit = 400;
exec(objectives);
$Game::missionType = "Football";
$cdTrack = 9;
$cdPlayMode = 1;
