//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function elevator9x9::onCollision(%this,%obj)
{
	%c = Player::getClient(%obj);
	if (floor(getRandom() * 30) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 900; %zVec = 20;
		%rnd = floor(getRandom() * 3);
		if (%rnd == 0)
		{ 
		} 
		else if (%rnd == 1) 
		{
		} 
		else if (%rnd == 2) 
		{ 
		}
	} 
	else if (floor(getRandom() * 7) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 900; %zVec = 20;
	} 
	else 
	{ 
		GameBase::playSound(%this, SoundFireMortar, 0);
		%velocity = 900;
		%zVec = 20;
	} 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
} 


//HERE IT IS...POINTLIGHT USE IT WELL!...IF YOU WANT ONE WITH AMBIENT COLORS I CAN MAKE IT FOR YOU TOO, remember this...I don't have a life, scripting is my life
function pointlight(%name, %remaintime, %position,%color, %range)
{
//created by Paul Linebarger(Uranium-235) /w help from Emo1313
%delname = "MissionCleanup\\\\" @ %name;
%posx = getword(%position, 0);
%posy = getword(%position, 1);
%posz = getword(%position, 2);
%R = getword(%color, 0);
%G = getword(%color, 1);
%B = getword(%color, 2);
%plight = Newobject(%name, "Simlight", Point, %range, %R, %G, %B, %posx, %posy, %posz);
addToSet("MissionCleanup", %plight);
schedule("deleteobject(\"" @ %delname @ "\");", %remaintime);
}


function GroupTrigger::onEnter(%this, %object)
{
%client = Player::getClient(%object);
	if(%this.num == "T1"){
      %positionIn = "53.0676 -133.327 427.276";
      %positionOut = "53.0134 -45.1875 171.881";
   }
%client = Player::getClient(%object);
	if(%this.num == "T2"){
      %positionIn = "52.9803 43.9068 426.449";
      %positionOut = "52.9804 43.9069 426.45";
   }      
  	if(%this.in){ 
         GameBase::setPosition(%client, %positionIn);
         pointlight("In", 1, %positionIn, "1 1 0", 20);
         //messageAll(0, "~wshieldhit.wav");
	   Client::SendMessage(%client,0,"~wshieldhit.wav");
      }
      	else if(%this.out){
         GameBase::setPosition(%client, %positionOut);
	Client::sendMessage(%client, 1, "YOU HAVE JUST BROKEN THE NO-FLY-ZONE RULE");
         pointlight("Out", 8, %positionOut,"1 0 0", 40);
         //messageAll(0, "~wshieldhit.wav");
         Client::SendMessage(%client,0,"~wshieldhit.wav");
      } 
} 


