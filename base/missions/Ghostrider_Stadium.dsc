$MDESC::Type = "Football";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Football" @
         "\n<f1>Stadium: <f0> Ghostrider" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Description:<f0> Roofless stadium with low walls all around. A sunken half pipe in the middle with push pads at the bottom. Teams start out on each side and must ride the halppipe to get to the goal way up high. 20 points withs the game." @
         "\n\n<f1>Map engineered and designed by:<f0> EEPROM (Mappers Extreme)";

