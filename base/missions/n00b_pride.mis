$teamScoreLimit = 400;
exec(objectives);
$Game::missionType = "Football";
$cdTrack = 9;
$cdPlayMode = 1;


//teleport//
function GroupTrigger::onEnter(%this, %object)
{
%client = Player::getClient(%object);
	if(%this.num == "T1"){
      %positionIn = "302.962 61.9254 64.7345";
      %positionOut = "300.947 28.9281 186.432";
   }
      
  	if(%this.in){ 
         GameBase::setPosition(%client, %positionIn);
         //messageAll(0, "~wreborn.wav");
	   Client::SendMessage(%client,0,"~wwind1.wav");
      }
      	else if(%this.out){
         GameBase::setPosition(%client, %positionOut);
         //messageAll(0, "~wreborn.wav");
         Client::SendMessage(%client,0,"~wwind1.wav");
	}
 
} 
function MegaSpringPad::onCollision(%this,%obj)
{
	%c = Player::getClient(%obj);
	if (floor(getRandom() * 30) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 600; %zVec = 50;
		%rnd = floor(getRandom() * 3);
		if (%rnd == 0)
		{ 
		} 
		else if (%rnd == 1) 
		{
		} 
		else if (%rnd == 2) 
		{ 
		}
	} 
	else if (floor(getRandom() * 7) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 600; %zVec = 50;
	} 
function LightSpringPad::onCollision(%this,%obj)
{
	%c = Player::getClient(%obj);
	if (floor(getRandom() * 30) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 875; %zVec = 50;
		%rnd = floor(getRandom() * 3);
		if (%rnd == 0)
		{ 
		} 
		else if (%rnd == 1) 
		{
		} 
		else if (%rnd == 2) 
		{ 
		}
	} 
	else if (floor(getRandom() * 7) == 0)
	{ 
		GameBase::playSound(%this, debrisLargeExplosion, 0);
		%velocity = 875; %zVec = 50;
}
function SpringPad::onCollision(%this,%obj)
 {
   %c = Player::getClient(%obj);
   if (floor(getRandom() * 30) == 0)
    { 
     GameBase::playSound(%this, SoundFireTargetingLaser, 0);
     %velocity = 10; %zVec = 100;
     %rnd = floor(getRandom() * 3);
     if (%rnd == 0)
      { 
      } 
     else if (%rnd == 1) 
      {
      } 
     else if (%rnd == 2) 
      { 
      }
    } 
   else if (floor(getRandom() * 7) == 0)
    { 
     GameBase::playSound(%this, SoundFireTargetingLaser, 0);
     %velocity = 10; %zVec = 100;
    } 
   else 
    { 
     GameBase::playSound(%this, SoundFireTargetingLaser, 0);
     %velocity = 10;
     %zVec = 100;
    }


