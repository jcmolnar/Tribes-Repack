$teamScoreLimit = 400;
exec(objectives);
$Game::missionType = "Football";
$cdTrack = 9;
$cdPlayMode = 1;

//$Server::JoinMOTD = "A Map For Tryouts Created By {Flip}!";

$Server::JoinMsgDelay = 0.4;
$Server::JoinMsgHeight = 9;
$Server::JoinMsgLength = 18;
$Server::JoinMsg[0] = "<jc><f2>Map: <f1>Tryouts-Stadium";
$Server::JoinMsg[1] = "";
$Server::JoinMsg[2] = "<jc><f2>**<f1>Created BY<f2>**";
$Server::JoinMsg[3] = "";
