{
  "format": 1,
  "kind": "skin",
  "name": "Chromatic Split",
  "author": "Kingdom of Kronos",
  "notes": [
    "A role-driven tri-colour test of the current renderer: cyan fields, magenta controls, and yellow primaries.",
    "Flat keyed geometry keeps the colour separation crisp without becoming noisy."
  ],
  "select": { "style": "keyed" },
  "palette": {
    "base": "#16171A",
    "baseBottom": "#07080A",
    "primary": "#5B153F",
    "primaryBottom": "#29091C",
    "edge": "#FF4BA8",
    "edgeShadow": "#020203",
    "disabled": "#1A1A1D",
    "disabledEdge": "#5B5660"
  },
  "styles": {
    "chamfer": { "cham": 9, "corners": 5, "ring": 1.4, "bevel": 0 },
    "plate": { "cham": 7, "corners": 15, "ring": 1.4, "bevel": 0 },
    "bracket": { "cham": 0, "corners": 0, "ring": 1.4, "ringMode": 1, "seg": 16, "bevel": 0, "edgeOverride": "#44E8FF" },
    "keyed": { "cham": 7, "corners": 0, "ring": 1.8, "notch": 11, "under": 0.82, "bevel": 0 },
    "blade": { "cham": 0, "corners": 0, "ring": 1.4, "skew": 11, "bevel": 0, "edgeOverride": "#FFE657" },
    "energised": { "cham": 9, "corners": 5, "ring": 1.4, "bar": 4, "scan": 0.04, "bevel": 0, "edgeOverride": "#44E8FF" },
    "segmented": { "cham": 9, "corners": 5, "ring": 1.4, "ringMode": 2, "seg": 13, "bevel": 0, "edgeOverride": "#FFE657" },
    "rail": { "cham": 12, "corners": 1, "ring": 1.4, "rail": 0.58, "notch": 4, "bevel": 0, "edgeOverride": "#44E8FF" }
  },
  "roles": {
    "panel": { "base": "#0B0C0E", "baseBottom": "#030304", "edge": "#5C3060" },
    "button": { "base": "#241326", "baseBottom": "#100811", "edge": "#FF4BA8" },
    "field": { "base": "#07161A", "baseBottom": "#07161A", "edge": "#44E8FF" },
    "listrow": { "base": "#15161A", "baseBottom": "#090A0C", "edge": "#44E8FF" },
    "primary": { "base": "#5B153F", "baseBottom": "#29091C", "edge": "#FFE657" },
    "text": { "edge": "#FFE657" }
