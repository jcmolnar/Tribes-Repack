    {
      "name": "clock::Iterate",
      "args": "",
      "from": "Modules/gameclock.acs.cs",
      "body": [
        "if ($clock::CountingDown)",
        "{",
        "    if ($clock::Sec > 0)",
        "        $clock::Sec--;",
        "    else",
        "    {",
        "        $clock::Sec = 59;",
        "",
        "        if ($clock::Min > 0)",
        "            $clock::Min--;",
        "        else",
        "        {",
        "            $clock::Min = 59;",
        "            $clock::Hour--;",
        "        }",
        "    }",
        "}",
        "else",
        "{",
        "    if ($clock::Sec < 59)",
        "        $clock::Sec++;",
        "    else",
        "    {",
        "        $clock::Sec = 0;",
        "",
        "        if ($clock::Min < 59)",
        "            $clock::Min++;",
        "        else",
        "        {",
        "            $clock::Min = 0;",
        "            $clock::Hour++;",
        "        }",
        "    }",
        "}",
        "clock::Update();",
        "Schedule::Add(\"clock::Iterate();\", 1);"
      ]
    },
    {
      "name": "clock::Reset",
      "args": "",
      "from": "Modules/gameclock.acs.cs",
      "body": [
        "$clock::Hour = 0;",
        "$clock::Min = 0;",
        "$clock::Sec = 0;",
        "$clock::CountingDown = false;",
        "Schedule::Add(\"clock::Iterate();\", 1);"
      ]
    },
    {
      "name": "clock::SetReverse",
      "args": "",
      "from": "Modules/gameclock.acs.cs",
      "body": [
        "$clock::Hour = $clock::Min = $clock::Sec = 0;",
        "$clock::CountingDown = false;",
        "",
        "Schedule::Add(\"clock::Iterate();\", 1);",
        "clock::Update();"
      ]
    },
    {
      "name": "clock::Update",
      "args": "",
      "from": "Modules/gameclock.acs.cs",
      "body": [
        "%x = $ModernHUD::PartX;",
        "%y = $ModernHUD::PartY;",
        "ModernHUD::markup(%x + 0, %y + 0, 180, \"<jc><f1>\" @ ( ( $clock::Hour < 10 ) ? \"0\" @ $clock::Hour : $clock::Hour ) @ \":\" @ ( ( $clock::Min < 10 ) ? \"0\" @ $clock::Min : $clock::Min ) @ \":\" @ ( ( $clock::Sec < 10 ) ? \"0\" @ $clock::Sec : $clock::Sec ), 255);"
      ]
    },
    {
      "name": "clock::UpdateTime",
      "args": "%min, %sec",
      "from": "Modules/gameclock.acs.cs",
      "body": [
        "$clock::Hour = floor(%min / 60);",
        "$clock::Min = %min % 60;",
        "$clock::Sec = %sec;",
        "$clock::CountingDown = true;",
        "Schedule::Add(\"clock::Iterate();\", 1);"
      ]
    },
    {
      "name": "CTFHUD::EnemyTeamValue",
      "args": "%team, %score1",
      "from": "Modules/CTFHud/CTFHud.acs.cs",
      "body": [
        "%x = $ModernHUD::PartX;",
        "%y = $ModernHUD::PartY;",
        "    %team = Team::Enemy();",
        "%loc = Team::Flag::Location(Team::Enemy());",
        "FlagFlash(%team);",
        "",
        "switch ( %loc ) {",
        "    case \"home\":",
        "        %loc = \"<f:CTFHud-Font.pft>:::::: Home ::::::\";",
        "        break;",
        "    case \"field\":",
        "        %loc = $FlagDropFontE ~ Team::Flag::Timer(%team);",
        "        break;",
        "    default:",
        "        %loc = \"<f:CTFHud-Font.pft:3ffd04>\" ~ String::escapeFormatting(Client::GetName(%loc));",
        "        break;",
        "}",
        "",
        "ModernHUD::markup(%x + 16, %y + 56, 89, \"<jc>\" ~ %loc, 255);"
      ]
    },
