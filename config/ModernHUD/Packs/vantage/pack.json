{
  "format": 1,
  "framework": 2,
  "id": "vantage",
  "name": "Vantage",
  "authoring": "manual",
  "reference": { "width": 1920, "height": 1080 },

  "assets": {},

  "prefs": {
    "$pref::miniMapSquare": "True",
    "$pref::miniMapWidth": "180",
    "$pref::miniMapZoom": "6",
    "$pref::miniMapRotate": "False",
    "$pref::miniMapCompass": "True"
  },

  "stockHuds": [
    { "name": "crosshairHud",   "class": "FearGui::Crosshair",          "visible": true  },
    { "name": "chatDisplayHud", "class": "FearGui::FearGuiChatDisplay", "visible": true  },
    { "name": "Minimap",        "class": "FearGui::Minimap",            "visible": true  },
    { "name": "clockHud",       "class": "FearGui::ClockHud",           "visible": true  },
    { "name": "healthHud",      "class": "FearGui::HealthHud",          "visible": false },
    { "name": "jetPackHud",     "class": "FearGui::JetHud",             "visible": false },
    { "name": "weaponHud",      "class": "FearGui::WeaponHud",          "visible": false },
    { "name": "compassHud",     "class": "FearGui::CompassHud",         "visible": false },
    { "name": "sensorHUD",      "class": "FearGui::SensorHud",          "visible": false }
  ],

  "parts": [
    {
      "id": "vitals",
      "slot": "healthenergy",
      "handle": "ModernHUD::VantageVitals",
      "anchor": "bottom-center",
      "offset": [0, 96],
      "size": [260, 22],
      "elements": [
        { "type": "script", "at": [0, 0], "from": "Vantage::Vitals",
          "body": ["Vantage::Vitals(%x, %y, %partW);"] }
      ]
    },
    {
      "id": "weapon",
      "slot": "weapon",
      "handle": "ModernHUD::VantageWeapon",
      "anchor": "bottom-right",
      "offset": [18, 96],
      "size": [220, 34],
      "elements": [
        { "type": "script", "at": [0, 0], "from": "Vantage::Weapon",
          "body": ["Vantage::Weapon(%x, %y, %partW);"] }
      ]
    },
    {
      "id": "ctf",
      "slot": "ctf",
      "handle": "ModernHUD::VantageCtf",
      "anchor": "top-center",
      "offset": [0, 14],
      "size": [420, 34],
      "elements": [
        { "type": "script", "at": [0, 0], "from": "Vantage::Ctf",
          "body": ["Vantage::Ctf(%x, %y, %partW);"] }
      ]
    },
    {
      "id": "items",
      "slot": "items",
      "handle": "ModernHUD::VantageItems",
      "anchor": "top-left",
      "offset": [18, 14],
      "size": [150, 56],
      "elements": [
        { "type": "script", "at": [0, 0], "from": "Vantage::Items",
          "body": ["Vantage::Items(%x, %y, %partW);"] }
      ]
    }
  ],

  "adapters": [
    {
      "part": "scoreboard",
      "status": "manual",
      "reason": "a real scoreboard needs a Team.cs-class data layer; deliberately not lifted from another pack for v1",
      "legacyFiles": []
    },
    {
      "part": "killfeed",
      "status": "manual",
      "reason": "needs the eventClientKilled data layer; same reason as scoreboard",
      "legacyFiles": []
    },
    {
      "part": "clock",
      "status": "manual",
      "reason": "a match clock needs its own data layer (gameclock.acs.cs maintains $clock::Hour/Min/Sec off a server message); the framework's Timer.cs has no current-time accessor. The stock clockHud is left VISIBLE instead of shipping a part that draws nothing.",
      "legacyFiles": []
    }
  ]
}
