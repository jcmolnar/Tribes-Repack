function SpawnDummy()
{
%aiName = "Dummy";
%armorType = armorfAngel;
%spawnPos = "2146.4 63.7604 -344.815";
%spawnRot = "0 0 0";
%name = "Dummy";
$ai = AI::getId(%aiName);
AI::spawn( %aiName, %armorType, %spawnPos, %spawnRot, %name, "male2" ); 
}

function Laserz()
{
%startPos ="-1.97309 -5.13789 103.11";
%laseVec ="0 1 0";
%newTrans ="0 0 0 "@%laseVec@" 0 0 0 "@%startPos;
Projectile::spawnProjectile("SeekerLaser", %newTrans, $ai, "0 0 0", 1.0); 
//---------------------------------------------------------------------------------
%startPos1 ="-1.94852 -6.23479 103.11";
%laseVec1 ="-1 0 0";
%newTrans1 ="0 0 0 "@%laseVec1@" 0 0 0 "@%startPos1;
Projectile::spawnProjectile("SeekerLaser", %newTrans1, $ai, "0 0 0", 1.0); 
//---------------------------------------------------------------------------------
%startPos2 ="-0.865271 -6.25283 103.109";
%laseVec2 ="0 -1 0";
%newTrans2 ="0 0 0 "@%laseVec2@" 0 0 0 "@%startPos2;
Projectile::spawnProjectile("SeekerLaser", %newTrans2, $ai, "0 0 0", 1.0); 
//---------------------------------------------------------------------------------
%startPos3 ="-0.835989 -5.15451 103.109";
%laseVec3 ="1 0 0";
%newTrans3 ="0 0 0 "@%laseVec3@" 0 0 0 "@%startPos3;
Projectile::spawnProjectile("SeekerLaser", %newTrans3, $ai, "0 0 0", 1.0); 
}

function FlingTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);
			%armor = Player::getArmor(%player);
			Client::sendMessage(%player,0,"~wrmt_turret.wav");	
			
		if(%armor == "armorTitan" || %armor == "armorTank") 
		{	
		echo("heavy");
		%velocity1 = 1600;
		%zVec1 = 0;
		%vector1 = Vector::getFromRot(GameBase::getRotation(%player), %velocity1, %zVec1);
	
		Player::applyImpulse(%player, %vector1);	

		}
		
		if(%armor == "armormAngel" || %armor == "armorfAngel" || %armor == "armormSpy" || %armor == "armorfSpy" || %armor == "armormNecro" || %armor == "armorfNecro") 
		{	
		echo("light");
		%velocity3 = 700;
		%zVec3 = 0;
		%vector3 = Vector::getFromRot(GameBase::getRotation(%player), %velocity3, %zVec3);
	
		Player::applyImpulse(%player, %vector3);	

		}
		
		if(%armor == "armormWarrior" || %armor == "armorfWarrior" || %armor == "armormBuilder" || %armor == "armorfBuilder" || %armor == "armorTroll") 
		{	
		echo("medium");
		%velocity2 = 1050;
		%zVec2 = 0;
		%vector2 = Vector::getFromRot(GameBase::getRotation(%player), %velocity2, %zVec2);
	
		Player::applyImpulse(%player, %vector2);		

		}
		

    }
}


