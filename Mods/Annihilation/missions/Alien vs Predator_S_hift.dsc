$MDESC::Type = "CTF_S_hift";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture The Flag" @
	"\n<f1>Planet: <f0> Tombaugh V" @
	"\n<f1>Weather: <f0> Dank & Hazy" @
	"\n<f1>Time of Day: <f0> Midday" @
	"\n<f1># of Teams: <f0> 2" @
	"\n\n<f1>Briefing: <f0> The two tribal factions have stumbled across an old alien ship beacon. There wasn't enough time to set up defenses so their generators and stations are exposed. Who ever controls the objective will be blessed with the sight of a predator.";