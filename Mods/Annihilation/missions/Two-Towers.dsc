$MDESC::Type = "Capture the Flag Air";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> NecroBones' Planet" @
         "\n<f1>Weather: <f0> Foggy" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Author: <f0> Ed T. Toton III, aka [ADP]Bones" @
         "\n<f1>Homepage: <f0> http://www.necrobones.com/" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> " @
         "teams battle it out from their tall towers. Because the " @
         "towers are relatively close together, keeping the enemy " @
         "at bay may be a challenge. On the other hand, the altitude " @
         "and sparse hovering platforms may make jetting into the enemy " @
         "base equally challenging. " @
         "\n\n<f1>Version:<f0> 1.0 (6/4/2000)";

