//Start ^^Plasmatic^^ MAGIC. ziptiezmail@netscape.net//


function SC::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	
	GameBase::playSound(%this, SoundActivateMotionSensor, 0);

	%velocity = 500;
	%zVec = 100;
	 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
	} 


function BOING::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	
	GameBase::playSound(%this, SoundFireMortar, 0);
	%velocity = 0;
	%zVec = 2000;
	 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
	} 

//End ^^Plasmatic^^ MAGIC. ziptiezmail@netscape.net//


