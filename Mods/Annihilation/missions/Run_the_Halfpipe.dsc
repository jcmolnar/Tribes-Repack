$MDESC::Type = "Capture the Flag Air";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Kinyo" @
         "\n<f1>Weather: <f0> Hazey and Raining" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle for control of this planet only known as Kinyo. Each Tribe must Run the Halfpipe to get the flag and bring it back to their own. May the best Tribe become Victorious!!" @
