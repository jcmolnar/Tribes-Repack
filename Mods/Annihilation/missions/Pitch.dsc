$MDESC::Type = "Capture the Flag Air";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Xaos" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Dusk" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other miles above the earth on floating metal and stone in the dark of night.  Each team must grab the other's flag and successfully bring it back to their base. Touch it to their own flag to capture it.  The first team with 5 captures shall be the victor."@
	"\n<f1>Version: <f0> 1.2 - Rebuilt on 02.12.00";