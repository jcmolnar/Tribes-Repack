$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Elerslie" @
         "\n<f1>Weather: <f0> Raining" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n<f1>Map Designer:  <f0> Nemesis - Avenger Designs 1999" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other on the verdant world of Elerslie.  Each team must grab the other's flag and successfully bring it back to their base, touching it to their own flag to capture.  The team that controls the bridge in the middle of the battle field gains a strategic advantage.  The first team with seven points shall be the victor!";