$teamScoreLimit = 10;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 9;
$cdPlayMode = 1;

//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function GroupTrigger::onEnter(%this, %object)
{

// Variable Set Up Toolbox!

// this gets the player's team
	%playerTeam = GameBase::getTeam(%object);
	%triggerTeam = GameBase::getTeam(%this);
// this gets the client's id number
	%client = Player::getClient(%object);
// this gets the client's armor	
	%playerArmor = Player::getArmor(%object);
// this gets the client's name
	%playerName = Client::getName(%client);

//End Variable Set Up Toolbox!


//FYI: Text Colors
//0 = white
//1 = red
//2 = gold
//3 = green


//Start Say Hello!
	if(%this.num == "HAMSTER")
	{
		Client::SendMessage(%client,2,"There is an arcane language written on the stone.~wusepack.wav");
		Client::SendMessage(%client,2,"Your HUD translates the message: Hamster_of_Doom! was here.");
		Client::SendMessage(%client,2,"E-Mail: rvr279@home.com");
	}
//End Say Hello!

//Start Teleporter.
	
	// Teleporter One
	else if(%this.num == "TOneUp")
	{	
		GameBase::setPosition(%client, "-385.506 -568.302 1329.46");
		Client::SendMessage(%client,3,"Teleported to sky base.~wshieldhit.wav");
	}

	// Teleporter Two
	else if(%this.num == "TTwoUp")
	{
        	GameBase::setPosition(%client, "-230.017 37.6667 1329.71");
		Client::SendMessage(%client,3,"Teleported to sky base.~wshieldhit.wav");
	}
//End Teleporter.
}