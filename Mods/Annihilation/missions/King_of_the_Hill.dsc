$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Tombaugh V" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> tribes are battling one another at close quarters on the Imperial world of Tombaugh V.  The first tribe to capture the flag 5 times will be the victor! Map made by LL Kunochi of Xtreme Gaming.";
