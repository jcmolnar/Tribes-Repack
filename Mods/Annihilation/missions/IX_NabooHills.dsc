$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture The Flag" @
         "\n<f1>Planet				: <f0> Naboo Prime" @
         "\n<f1>Weather			: <f0> Clear" @
         "\n<f1>Time of day	: <f0> Night" @
         "\n<f1>Visibility			: <f0> 500m." @
         "\n<f1>Teams				: <f0> 2" @
	 "\n<f1>Author 			: <f0> *IX*Led Mirage" @
	 "\n<f1>Version			: <f0> 1.1 March-17-1999" @
         "\n\n<f1>Briefing			: <f0> The <vServer::teamName0> and <vServer::teamName1> tribes battle it out in the grassy hills of Naboo Prime. There are two additional floating bridges with their respective controls, each of them will give your team one additional point. If your primary base is disabled you have a secondary base inside your respective dropships as well. The Point limit for this mission is 10 points.";


