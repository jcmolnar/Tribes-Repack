$teamScoreLimit = 8;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 5;
$cdPlayMode = 1;

AI::spawn("Mark", $AI::defaultArmorType, "0 0 0", "0 0 0", "Mark", "male2");

function ted(%pos)
{
	deleteVariables("LOS::*");
	getLOSInfo(%pos, Vector::add(%pos, "0 0 10000"), 1);
	return $LOS::Position;
}

$bot = AI::getId("Mark");

for(%i = -32; %i < 32; %i++)
{
	%pos1 = "-192 192 36";
	%pos2 = "192 -192 36";
	%vec1 = %i @" 32 0";
	%vec2 = "-32 "@ %i @" 0";
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::add(%pos1, %vec1)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::sub(%pos1, %vec1)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::add(%pos1, %vec2)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::sub(%pos1, %vec2)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::add(%pos2, %vec1)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::sub(%pos2, %vec1)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::add(%pos2, %vec2)),  $bot, "0 0 0", 1.0);	//Boundary Laser
	Projectile::spawnProjectile("SeekerLaser", "0 0 0 0 0 -1 0 0 0 "@ ted(Vector::sub(%pos2, %vec2)),  $bot, "0 0 0", 1.0);	//Boundary Laser
}

function Player::whackAMole(%this)
{
	%client = Player::getClient(%this);
	%pos = GameBase::getPosition(%this);
	if(!Player::isDead(%this) && 0 <= Client::getTeam(%client) && !getLOSInfo(%pos, Vector::sub(%pos, "0 0 10000"), 1))
	{
		messageAll(0, Client::getName(%client) @" was crushed to death.");
		playNextAnim(%client);
		Player::kill(%client);
	}
}

function Whack_A_Mole(%this)
{
	Group::iterateRecursive(MissionCleanup, GameBase::virtual, "whackAMole");
	schedule(sprintf("if($MissionName == \"%1\") Whack_A_Mole(\"%1\");", %this), 1 / 3);
}

Whack_A_Mole($MissionName);
