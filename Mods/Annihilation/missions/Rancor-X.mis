$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function GroupTrigger::onEnter(%this, %object)
{
// this gets the clients id number
%client = Player::getClient(%object);
//Team1
//Teleport 1
	if(%this.num == "tp1"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-116.375 239.375 41";
      %positionOut = "";
   }
//Teleport 2
   else if(%this.num == "tp2"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-116.375 255.395 54.2956";  
      %positionOut = "";
   }
//Teleport 3
  else if(%this.num == "tp3"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-135.607 219.518 26.7998";
      %positionOut = "";
   }
//Teleport 4
  else if(%this.num == "tp4"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-96.7775 258.753 40.7986";
      %positionOut = "";
}
//Teleport 5
  else if(%this.num == "tp5"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-135.444 219.471 11.699";
      %positionOut = "";
}
//Teleport 6
  else if(%this.num == "tp6"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-96.9844 259.375 26.699";
      %positionOut = "";
}
//Teleport 7(BIG TELEPORT)
  else if(%this.num == "tp7"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "-4.45685 -70.9765 -794.818";
      %positionOut = "";
}
//Teleport 8(BIG TELEPORT OUT)
  else if(%this.num == "tp8"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "0 0 210";
      %positionOut = "";
}
//Teleport 9
  else if(%this.num == "tp9"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "103.75 -250.644 40.7999";
      %positionOut = "";
}
//Teleport 10
  else if(%this.num == "tp10"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "103.714 -266.697 54.2976";
      %positionOut = "";
}
//Teleport 11
  else if(%this.num == "tp11"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "122.712 -231.779 26.7999";
      %positionOut = "";
}
//Teleport 12
  else if(%this.num == "tp12"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "84.2906 -270.018 40.7999";
      %positionOut = "";
}
//Teleport 13
  else if(%this.num == "tp13"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "123.186 -231.418 11.7999";
      %positionOut = "";
}

//Teleport 14
  else if(%this.num == "tp14"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "84.4671 -270.056 26.7998";
      %positionOut = "";
}
//Teleport 15
  else if(%this.num == "tp15"){  //the appropriate trigger will have the same num="something"
				//don't use "DS" or "BE" or you may encounter conflicts
      %positionIn = "15.0676 0.938982 -524";
      %positionOut = "";
}

      // this sets the actual position if trigger is in = true
	if(%this.in){
         GameBase::setPosition(%client, %positionIn);  //sets the player's position
         //messageAll(0, "~wlaserhit.WAV");
	   Client::SendMessage(%client,0,"~wteleport2.wav");  //plays sound
      }
      // this sets the position if out = true
	else if(%this.out){
         GameBase::setPosition(%client, %positionOut);  //sets the player's position
         //messageAll(0, "~wlaserhit.WAV");
         Client::SendMessage(%client,0,"~wteleport2.wav");  //plays sound
	}
 
}