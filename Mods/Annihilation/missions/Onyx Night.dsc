$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
		"\n\n<f0> The call for maps has been answered..." @
				"\n\n<f1> Tis a dreamless night... The skies above the world are clear... Tis a dark night..." @
				"\n\n<f1> Tis a black night... The eyes among the world weep fear... Tis a good night..." @
				"\n\n<f1> Tis a red night... The cries upon the world bleed tears... Tis a perfect night..." @
				"\n\n<f1> To die..." @
		"\n\n<f2>Map by Synsilliusarian! Enjoy!";