%ext = getWord(".zip .vol", version() < 1.4);	// Backwards compatibility, FTW! -perrinoia
//--- export object begin ---//
instant SimGroup "MissionGroup" {
	ownsObjects = "True";
	instant SimGroup "Volumes" {
		ownsObjects = "True";
		instant SimVolume "InterfaceVol" {
			fileName = "Interface"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "Entities" {
			fileName = "Entities"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "World" {
			fileName = "desertWorld"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "WorldTerrain" {
			fileName = "desertTerrain"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "desertDML" {
			fileName = "desertDML"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "savanaDML" {
			fileName = "savanaDML"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "human1DML" {
			fileName = "human1DML"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "titanDML" {
			fileName = "titanDML"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
		instant SimVolume "TedFile" {
			fileName = "missions\\Annihilator.ted";
		};
		instant SimVolume "MissionLighting" {
			fileName = "Annihilator"@ %ext;	// Backwards compatibility, FTW! -perrinoia
		};
	};
	instant SimGroup "World" {
		ownsObjects = "True";
		instant SimPalette "Palette" {
			fileName = "desert.day.ppl";
		};
		instant MissionCenterPos "MissionCenter" {
			x = "-128";
			y = "-128";
			w = "256";
			h = "256";
		};
		instant Trigger "Boundary" {
			dataBlock = "GroupTrigger";
			name = "Boundary";
			position = "0 0 1000";
			rotation = "0 0 0";
			boundingBox = "-128 -128 -128 128 128 128";
			isSphere = "False";
		};
		instant Marker "South Marker" {
			dataBlock = "MapMarker";
			name = "Southern Hippo";
			position = "0 -125 13";
			rotation = "0 0 0";
		};
		instant Marker "North Marker" {
			dataBlock = "MapMarker";
			name = "Northern Hippo";
			position = "0 125 13";
			rotation = "0 0 0";
		};
		instant Marker "team0 Marker" {
			dataBlock = "MapMarker";
			name = "<vServer::teamName0>";
			position = "-110 0 11";
			rotation = "0 0 0";
		};
		instant Marker "team1 Marker" {
			dataBlock = "MapMarker";
			name = "<vServer::teamName1>";
			position = "110 0 11";
			rotation = "0 0 0";
		};
	};
