$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Location: <f0> Mappers Heaven" @
         "\n<f1>Weather: <f0> Foggy as usual" @
         "\n<f1>Time of Day: <f0> Still light out" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> Edd's Mapping Super Store and Objects-R-Us are the two main places where I get most of my mapping supplies. They both carry almost the same stuff but some times one has what the other does not. However, those damn Tribes the <vServer::teamName0>'s and the <vServer::teamName1>'s have taken them over hoping to beef up any future bases. Both have dared each other to come get their flag again too. Those damn tribes think they are so tuff!!!!!" @
         "\n\n<f1>Mission designed by:<f0> EEPROM of Mappers Extreme";
