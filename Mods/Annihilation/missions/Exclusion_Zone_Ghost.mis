$teamScoreLimit = 8;
exec(objectives);
$Game::missionType = "Open Call";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Ghost();", 900); 
																											
															
function Ghost()
{		
// Gets called after 15 minutes of gameplay to remind players who their daddy is ;)
messageAll(3, "|Map created by Ghost| ~wmine_act.wav");												
}	

function WeeTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);
			%armor = Player::getArmor(%player);
			Client::sendMessage(%player,0,"~wrmt_turret.wav");	
			
		if(%armor == "armorTitan" || %armor == "armorTank") 
		{	
		echo("heavy");
		%velocity1 = 1600;
		%zVec1 = 0;
		%vector1 = Vector::getFromRot(GameBase::getRotation(%player), %velocity1, %zVec1);
	
		Player::applyImpulse(%player, %vector1);	

		}
		
		if(%armor == "armormAngel" || %armor == "armorfAngel" || %armor == "armormSpy" || %armor == "armorfSpy" || %armor == "armormNecro" || %armor == "armorfNecro") 
		{	
		echo("light");
		%velocity3 = 700;
		%zVec3 = 0;
		%vector3 = Vector::getFromRot(GameBase::getRotation(%player), %velocity3, %zVec3);
	
		Player::applyImpulse(%player, %vector3);	

		}
		
		if(%armor == "armormWarrior" || %armor == "armorfWarrior" || %armor == "armormBuilder" || %armor == "armorfBuilder" || %armor == "armorTroll") 
		{	
		echo("medium");
		%velocity2 = 1050;
		%zVec2 = 0;
		%vector2 = Vector::getFromRot(GameBase::getRotation(%player), %velocity2, %zVec2);
	
		Player::applyImpulse(%player, %vector2);		

		}
		

    }
}
