$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Battle Byte" @
         "\n<f1>Weather: <f0> Clear as day" @
         "\n<f1>Time of Day: <f0> Day (not night)" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> beat the crap out of each other." @
         "In addition to the all this blood shed I can only say, drink, have fun and be marry." @
         "\n\n<f1>Mission designed by:<f0> EEPROM (Mappers Extreme)";
