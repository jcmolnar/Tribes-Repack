function SpawnDummy()
{
%aiName = "Dummy";
%armorType = armorTank;
%spawnPos = "-475.903 301.828 -425.73";
%spawnRot = "0 0 0";
%name = "Dummy";
$ai2 = AI::getId(%aiName);
AI::spawn( %aiName, %armorType, %spawnPos, %spawnRot, %name, "male2" ); 
}	
function SpawnDummy2()
{
%aiName1 = "Dummy2";
%armorType1 = armorTank;
%spawnPos1 = "-475.903 301.828 -425.73";
%spawnRot1 = "0 0 0";
%name1 = "Dummy2";
$ai3 = AI::getId(%aiName1);
AI::spawn( %aiName1, %armorType1, %spawnPos1, %spawnRot1, %name1, "male2" ); 
}
	
function Ghost()
{		
// Gets called after 15 minutes of gameplay to remind players who their daddy is ;)
messageAll(3, "|Map created by Ghost| ~wmine_act.wav");												
}	
function OutTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%Targetid);

				
		%mis2pos = "91.1038 383.029 71.2038";
		%mis2rot = "0 -0 1.57999";
		Item::setVelocity(%player,"0 0 0");
		GameBase::setPosition(%player,%mis2pos);
		GameBase::setRotation(%player, "0 0 " @ GetWord(%mis2rot,2));
	
		messageAll(3,Client::getName(%player)@" returned to the battlefield. ~wmine_act.wav");
 		Client::sendMessage(%player,3,"~wrmt_turret.wav");

    }
}

function WaterTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);

				
		GameBase::setAutoRepairRate(%omega, 0.35);
 		Client::sendMessage(%player,3,"You are being healed by the holy water. ~wfloat_target.wav");

    }
}

function DeathTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);
			%name1 = Client::getName(%player);
			
schedule("Player::Kill(" @ %player @ ");", 0.01);
Schedule("MessageAll(0, \""@%name1@" got sliced in half.\");", 0.01);
schedule("GameBase::playSound("@%object@", SoundLaserHit, 0);",0.01);		


    }
}

function Telein::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);
			
	%inpos = "-47.4914 369.394 2294";
	%inrot = "0 -0 2.96317";
	
	GameBase::setPosition(%player,%inpos);
	GameBase::setRotation(%player, "0 0 " @ GetWord(%inrot,2));
	Item::setVelocity(%player,"0 0 0");
			
messageAll(3,Client::getName(%player)@" entered the ruins. ~wmine_act.wav");
schedule("GameBase::playSound("@%player@", SoundBeaconUse, 0);",0.3);		


    }
}

	function WaterTrig::onLeave(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
                        %omega = Client::getOwnedObject(%player);

                        GameBase::setAutoRepairRate(%omega, 0); 
 
    }
}


function FootTrig::onEnter(%this,%object)
{
    %type = getObjectType(%object);
    if (%type == "Player")
    {


			%player = Player::getClient(%object);
			%targetId = GameBase::getOwnerClient(%player);
            %omega = Client::getOwnedObject(%player);
			%name1 = Client::getName(%player);
GameBase::playSound(%object, SoundFireSeeking, 0);
SpawnSpike1(%object);
SpawnSpike2(%object);
SpawnSpike3(%object);
SpawnSpike4(%object);
SpawnSpike5(%object);
SpawnSpike6(%object);
SpawnSpike7(%object);
SpawnSpike8(%object);
SpawnSpike9(%object);
SpawnSpike10(%object);
SpawnSpike11(%object);
SpawnSpike12(%object);
SpawnSpike13(%object);
SpawnSpike14(%object);
SpawnSpike15(%object);
SpawnSpike16(%object);
SpawnSpike17(%object);
SpawnSpike18(%object);
SpawnSpike19(%object);
SpawnSpike20(%object);
schedule("Player::Kill(" @ %player @ ");", 0.1);
Schedule("MessageAll(0, \""@%name1@" was impaled.\");", 0.1);
schedule("GameBase::playSound("@%object@", SoundPickupAmmo, 0);",1);

    }
}

