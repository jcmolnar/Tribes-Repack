function SpawnSpike1(%object)
{
	%object = newObject("Spike1","StaticShape", "SmallAntenna");
	%pos = "-5.19909 366.535 2294.86";
	%rot = "0.00159239 -3.14146 -3.14146";
	addToSet(MissionCleanup, %object);
	GameBase::setPosition(%object,%pos);
	GameBase::setRotation(%object,%rot);
	schedule("deleteobject("@%object@");",1);
}

