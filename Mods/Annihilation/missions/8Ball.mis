$ext = getWord(".zip .vol", version() < 1.4);	// Backwards compatibility, FTW! -perrinoia
//--- export object begin ---//
instant SimGroup "MissionGroup" {
	ownsObjects = "True";
	instant SimGroup "Volumes" {
		ownsObjects = "True";
		instant SimVolume "InterfaceVol" {
			fileName = "Interface"@ $ext;
		};
		instant SimVolume "Entities" {
			fileName = "Entities"@ $ext;
		};
		instant SimVolume "tedFile" {
