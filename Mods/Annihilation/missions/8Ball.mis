$teamScoreLimit = 8;
exec(getWord("server/game/fandr objectives", version() < 1.4));	// Backwards compatibility, FTW! -perrinoia
$Game::missionType = "F&R";
$cdTrack = 3;
$cdPlayMode = 1;

function onClientMessage( %cl, %msg, %type )
{
	%MagicEightBall0 = "It is certain";
	%MagicEightBall1 = "It is decidedly so";
	%MagicEightBall2 = "Without a doubt";
	%MagicEightBall3 = "Yes definitely";
	%MagicEightBall4 = "You may rely on it";
	%MagicEightBall5 = "As I see it, yes";
	%MagicEightBall6 = "Most likely";
	%MagicEightBall7 = "Outlook good";
	%MagicEightBall8 = "Yes";
	%MagicEightBall9 = "Signs point to yes";
	%MagicEightBall10 = "Reply hazy try again";
	%MagicEightBall11 = "Ask again later";
	%MagicEightBall12 = "Better not tell you now";
	%MagicEightBall13 = "Cannot predict now";
	%MagicEightBall14 = "Concentrate and ask again";
	%MagicEightBall15 = "Don't count on it";
	%MagicEightBall16 = "My reply is no";
	%MagicEightBall17 = "My sources say no";
	%MagicEightBall18 = "Outlook not so good";
	%MagicEightBall19 = "Very doubtful";
	if(0 <= String::findSubStr(%msg, "?"))
		Client::sendMessage(%cl, 0, "Magic 8 Ball: "@ %MagicEightBall[floor(getRandom() * 20)]);
	if( %cl )
		$lastClientMessage = %cl;
	
	// filter messages here
	return true;
}
