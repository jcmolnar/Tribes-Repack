$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0>Kardasian" @
         "\n<f1>Weather: <f0>Clear." @
         "\n<f1>Time of Day: <f0>Midnight" @ 
         "\n<f1># of Teams: <f0> 2" @  
         "\n\n<f1>Briefing :<f0> Kardasian was just descovered. But the <vServer::teamName0> and the <vServer::teamName1> are fighting for control. The 1st team that captures the other teams flag 5 times will gain control of this planet" @
         "\n\n<f1> Map Concept by: <f0> Lord Alucard" @
         "\n\n<f1> Map Constructed and Tweaked by: <f0> Lord Alucard" @
         "\n\n<f1> Story Line: <f0> {|MW|}Oblivion{|CL|}" @
         "\n\n<f1> Contact: <f0> {|MW|}Oblivion{|CL|} via email, kurgan12@hotmail.com \ ICQ UIN # 41829769 \ WEBPAGE ADDRESS      www.angelfire.com/me2/mwclanstartpage/index.html" @
         "\n\n<f1> Special Thanks: <f0> I would like to thank {|MW|}decoy{|SOL-ACL|} for all the hard work hes done (this message brought to you by {|MW|}Oblivion{|CL|}                                                             >>  Lord Alucard is a proud part of Mappers Extreme << > http://members.xoom.com/Goldbergmap/  << ";