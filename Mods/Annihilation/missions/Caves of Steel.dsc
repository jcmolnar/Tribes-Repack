$MDESC::Type = "Capture the Flag Indoor";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> NecroBones' Planet" @
         "\n<f1>Weather: <f0> Who can tell?" @
         "\n<f1>Time of Day: <f0> Who knows?" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Author: <f0> Ed T. Toton III, aka [ADP]Bones" @
         "\n<f1>Homepage: <f0> http://www.necrobones.com/" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> " @
         "both find themselves trapped in the same network of dark caverns " @
         "after a landslide sealed the only escape routes. Only the combined " @
         "resources of both bases could possibly offer an escape method, so " @
         "rather than work together, obviously the only sane choice is " @
         "the total annihilation of one of the teams. Capture the flag " @
         "5 times, and the winner takes all.";
