$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> NecroBones' Planet" @
         "\n<f1>Weather: <f0> Slightly Hazy" @
         "\n<f1>Time of Day: <f0> Midday" @
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Author: <f0> Ed T. Toton III, aka [ADP]Bones" @
         "\n<f1>Homepage: <f0> http://www.necrobones.com/" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> " @
         "teams battle it out for control of a long-range communications " @
         "relay tranceiver shortly after landing in dropships to claim this " @
         "all-important device. The 300m dish is a strategic objective in " @
         "a much larger campaign, but for the time being the challenge is " @
         "just to gain control of the facility itself. Because firepower " @
         "is an expected need, both teams are defaulting to medium armor " @
         "and ammo packs." @
         "\n\n<f1>Version:<f0> 1.0 (5/24/2000)";
