$teamScoreLimit = 10;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 10;
$cdPlayMode = 1;


function SC::onCollision(%this,%obj)
	{
	%c = Player::getClient(%obj);
	
	GameBase::playSound(%this, SoundActivateMotionSensor, 0);

	%velocity = 500;
	%zVec = 100;
	 
	%jumpDir = Vector::getFromRot(GameBase::getRotation(%obj),%velocity,%zVec);
	Player::applyImpulse(%obj,%jumpDir);
	} 

