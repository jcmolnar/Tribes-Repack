$Game::missionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;
schedule("Weather::Trippy();",1); //Rainbow skiez motha fucka
schedule("Ghost();", 900); 	//Credit
schedule("SpawnDummy();", 3); //Laser Owner
schedule("Laserz();", 4);   //Laser 

function Ghost()
{		
// Gets called after 15 minutes of gameplay to remind players who their daddy is ;)
messageAll(3, "|Map created by Ghost| ~wmine_act.wav");												
}

function SpawnDummy()
{
%aiName = "Dummy";
%armorType = armorTank;
%spawnPos = "15.1971 -85.5742 1890.14";
%spawnRot = "0 0 0";
%name = "Dummy";
$ai2 = AI::getId(%aiName);
AI::spawn( %aiName, %armorType, %spawnPos, %spawnRot, %name, "male2" ); 
}	

function Laserz()
{
%startPos0 ="14.1152 13.3272 1879.47";
%laseVec0 ="0 0 1";
%newTrans0 ="0 0 0 "@%laseVec0@" 0 0 0 "@%startPos0;
Projectile::spawnProjectile("SeekerLaser", %newTrans0, $ai2, "0 0 0", 1.0); 
}

function Weather::Trippy()
{
	%Sky = newObject("Sky",Sky,0,0,1); // Blue
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::TrippyRed();",1);
}

function Weather::TrippyRed()
{
	%Sky = newObject("Sky",Sky,1,0,0); // Red
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::TrippyGreen();",1);
}

function Weather::TrippyGreen()
{
	%Sky = newObject("Sky",Sky,0,1,0); // Green
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::TrippyPurple();",1);
}

function Weather::TrippyPurple()
{
	%Sky = newObject("Sky",Sky,1,0,1); // Purple
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::TrippyBabyBlue();",1);
}

function Weather::TrippyBabyBlue()
{
	%Sky = newObject("Sky",Sky,0,0.7,1); // Baby Blue
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::TrippyYellow();",1);
}

function Weather::TrippyYellow()
{
	%Sky = newObject("Sky",Sky,1,1,0); // Yellow
	$cursky = %sky;
	addToSet("MissionCleanup",%Sky);
	schedule("deleteobject($cursky);",1);
	schedule("Weather::Trippy();",1);
}


