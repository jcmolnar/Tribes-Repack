$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 9;
$cdPlayMode = 1;

//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function GroupTrigger::onEnter(%this, %object)
{
// this gets the player's team
	%playerTeam = GameBase::getTeam(%object);
	%triggerTeam = GameBase::getTeam(%this);
// this gets the client's id number
	%client = Player::getClient(%object);
// this gets the client's armor	
	%playerArmor = Player::getArmor(%object);
// this gets the client's name
	%playerName = Client::getName(%client);

//Say hello!
	if(%this.num == "HAMSTER")
	{
		Client::SendMessage(%client,0,"There is an arcane language written on the stone.~wusepack.wav");
		Client::SendMessage(%client,0,"Your HUD translates the message: Hamster_of_Doom! was here.");
		Client::SendMessage(%client,0,"E-Mail: rvr279@home.com");
	}
}
