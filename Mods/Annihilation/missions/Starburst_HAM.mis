$teamScoreLimit = 8;
exec(objectives);
$Game::MissionType = "CTF";
$cdTrack = 4;
$cdPlayMode = 1;

//-----------------------------------------
//GroupTrigger::onEnter()
//-----------------------------------------
function GroupTrigger::onEnter(%this, %object)
{

//Start Variable Toolbox
// not all of these may be used in this program. Its just my little toolkit I paste in.
// this gets the player's team
	%playerTeam = GameBase::getTeam(%object);
	%triggerTeam = GameBase::getTeam(%this);
// this gets the client's id number
	%client = Player::getClient(%object);
// this gets the client's armor	
	%playerArmor = Player::getArmor(%object);
// this gets the client's name
	%playerName = Client::getName(%client);
// this value adjusts the boost of the z axis for the Decelerator
	%zVecSTOP = -10;
// this gets the player's health level;
	%healthLevel = GameBase::getDamageLevel(%object);
// this gets the player's energy level;
	%energyLevel = GameBase::getEnergy(%object);
//End Variable Toolbox
	%rechargeRate = GameBase::getRechargeRate(%object);

//Start Notes
//Text Colors
//0 = white
//1 = red
//2 = gold
//3 = green
// <vServer::teamName0>
//End Notes

	// Start Say Hello!
	if(%this.num == "HAMSTER")
	{
		Client::SendMessage(%client,2,"There is an arcane language written on the stone.~wusepack.wav");
		Client::SendMessage(%client,2,"Your HUD translates the message: Hamster_of_Doom! was here.");
		Client::SendMessage(%client,2,"E-Mail: rvr279@home.com");
	}
	//End Say Hello!

	//Start Team-Sensitive InstaHealer
	else if(%this.num == "estream")
	{
		if(%triggerTeam == %playerTeam || %triggerTeam == "-1")
		{
			%healthboost = %healthLevel - 1;
			%boost = %energyLevel + 100;

			GameBase::setRechargeRate(%object,8);
			GameBase::setEnergy(%object, %boost);
			GameBase::setDamageLevel(%object, %healthboost);	
			Client::SendMessage(%client,3,"You are miraculously restored!~wlaser.wav");
			
			//Client::SendMessage(%client,1,"" @ %healthLevel @ " is pre-plug health!~waccess_denied.wav");
			//Client::SendMessage(%client,1,"" @ %energyLevel @ " is pre-plug energy!~waccess_denied.wav");
		}
		//FOOL! You don't own the objective!
		else if(%triggerTeam != %playerTeam)
		{	
			Client::SendMessage(%client,1,"--ACCESS DENIED-- Wrong Team~waccess_denied.wav");
			GameBase::setRechargeRate(%object,-2);
			Client::SendMessage(%client,1,"Your armor has been short-circuited!");
			
			//Client::SendMessage(%client,1,"" @ %energyLevel @ " is energy level!~waccess_denied.wav");
			//Client::SendMessage(%client,1,"" @ %rechargeRate @ " is your recharge!~waccess_denied.wav");
		
			// sets the speed and direction
			%velocityGO = -500;
		
			// this value adjusts the boost of the z axis for the accelerator
			%zVecGO = 50;

			// creates vector from rotation  (rotation, length, zvalue(0))        
			%jumpDir = Vector::getFromRot(GameBase::getRotation(%object),%velocityGO,%zVecGO);

			//expected input: (player, vector  -  direction and force)
			Player::applyImpulse(%object,%jumpDir);
		}
	}
	//End Team-Sensitive InstaHealer
}