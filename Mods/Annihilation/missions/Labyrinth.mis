//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "CTF";
$cdTrack = 9;
$cdPlayMode = 1;
$maze = "MissionGroup/Maze";	// Path of walls to randomize.

// I like pi.
function pi(%factor)
{
	return %factor * 3.1415926535897932384626433832795;	// pi(2) = 360 degrees. pi(1) = 180 degrees. pi(0.5) = 90 degrees. pi(-10/180) = -10 degrees.
}

// Moves and spins a wall around the pivot point stored as it's object name.
function Randomaze(%this, %turn)
{
	if(%turn == 0)
		%turn = (floor(getRandom() * 4) * 90) - 90;	// -90, 0, 90, or 180 degrees
	
	%rot = Vector::add(GameBase::getRotation(%this), "0 0 "@ pi(%turn / 180));	// Convert degrees to radians and add to rotation.
	%vec = Vector::getFromRot(Vector::sub(%rot, "0 0 "@ pi(0.5)), 16, 0);		// Insertion point is 90 degrees and 16 meters off center.
	%pos = Vector::add(Object::getName(%this), %vec);							// Add vector to center point.
	%zed = getWord(%rot, 2);													// Allegiance based on rotation.
	
	GameBase::setPosition(%this, %pos);											// Move
	GameBase::setRotation(%this, %rot);											// Spin
	GameBase::setTeam(%this, 0 < %zed);											// Ally
}

// Checks for obstructions, animates moving wall, then schedules next random recurance.
function Animazion(%this)
{
	if(-1 < %this)
	{
		%pos = Object::getName(%this);									// Object name = coordinates of pivot point.
		%set = newObject("Bread Crumbs", SimSet);						// Used for deploy check.
		%deg = getWord("-10 10", floor(getRandom() * 2));				// 10 degrees Clockwise or counter clockwise.
		%nah = $SimPlayerObjectType | $MineObjectType | $MoveableObjectType | $VehicleObjectType | $StaticObjectType | $ItemObjectType;
		%yup = containerBoxFillSet(%set, %nah, %pos, 96, 96, 22, 11);	// Unobstructed and mission editor is not loaded.
				
		deleteObject(%set);												// Cleanup after deploy check.
		while(%i < 9 && %yup < 1 && !$ME::Loaded)						// 9 iterations * 10 degrees = 90 degrees.
			schedule("Randomaze("@ %this @", "@ %deg @");", %i++ / 10);	// Seed the animation with a random angle.
	}
	schedule("Animazion(Group::getObject($maze, floor(getRandom() * Group::objectCount($maze))));", 1);	// Wash, rinse, repeat!
}

schedule("Group::iterateRecursive($maze, \"Randomaze\", 0);", getRandom());							// Randomize the whole maze, and then...
schedule("Animazion(Group::getObject($maze, floor(getRandom() * Group::objectCount($maze))));", 1);	// ...animate 1 wall each second.

// Bounce back into the maze.
function KillTrap::onTrigEnter(%this, %object, %trig)
{
	if(%this == %trig)
	{
		%vel = Item::getVelocity(%object);
		GameBase::activateShield(%object, "0 0 1");
		Item::setVelocity(%object, getWord(%vel, 0) @" "@ getWord(%vel, 1) @" "@ 0 - getWord(%vel, 2));	// #GetOut
		if(!Player::isAIControlled(%object) && !Player::isDead(%object))
		  	Client::sendMessage(Player::getClient(%object), 1, "Don't go there, honey!~wLeftMissionArea.wav");
  	}
}

// Damage those who manage to thwart the bouncy boudary.
function KillTrap::onTrigger(%this, %object, %trig)
{
	if(%this == %trig)
		GameBase::applyDamage(%object, $CrushDamageType, 0.1, getBoxCenter(%object), "0 0 0", "0 0 0", %this);	// #GETOUT
}

// Repair departing survivors. If you stay for more than 1/3 of a second, you get more damage than this repairs.
function KillTrap::onTrigLeave(%this, %object, %trig)
{
	if(%this == %trig && !Player::isDead(%object))
		GameBase::repairDamage(%object, 0.1);	// #ThankYouComeAgain
}

// Airbase removed to prevent teleporting above the maze! (Replaced with mobile inventory pack) -perrinoia
function AirBasePack::deployshape(%player, %item)
{
  	Client::sendMessage(Player::getClient(%player), 1, "Don't go there, honey!~wLeftMissionArea.wav");
	return MobileInventoryPack::deployshape(%player, %item);
}