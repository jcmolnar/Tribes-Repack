%ext = getWord(".zip .vol", $ServerVersion < 1.40);	// Compatibility FTW! -perrinoia
//--- export object begin ---//
instant SimGroup "MissionGroup" {
	ownsObjects = "True";
	instant SimGroup "Volumes" {
		ownsObjects = "True";
		instant SimVolume "InterfaceVol" {
			fileName = "Interface"@ %ext;	// Compatibility FTW! -perrinoia
		};
		instant SimVolume "entities" {
			fileName = "Entities"@ %ext;	// Compatibility FTW! -perrinoia
		};
		instant SimVolume "World" {
			fileName = "marsWorld"@ %ext;	// Compatibility FTW! -perrinoia
