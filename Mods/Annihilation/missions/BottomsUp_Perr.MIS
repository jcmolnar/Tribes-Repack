$teamScoreLimit = 5;
exec(getWord("server/game/ctf objectives", $ServerVersion < 1.40));	// Compatibility FTW! -perrinoia
$Game::missionType = "CTF";
$cdTrack = 7;
$cdPlayMode = 1;

// Crushes players above the upside down terrain! -perrinoia
function MapMarker::onTrigger(%this, %that, %trig)
{
	if(Object::getName(%this) != "Boundary" || Object::getName(%trig) != "Boundary")
		return;
		
	%type = getObjectType(%that);
	if(%type == "Player" || %type == "Flier" || %type == "Vehicle")
	{
		deleteVariables("LOS::*");
		%pos = GameBase::getPosition(%that);
		if(!getLOSInfo(%pos, Vector::add(%pos, "0 0 512"), 1))	// If there is nothing within 512 meters above the player, smush 'em like a bug! -perrinoia
			GameBase::applyDamage(%that, $CrushDamageType, 0.1, getBoxCenter(%that), "0 0 0", "0 0 0", %this);
	}
}
