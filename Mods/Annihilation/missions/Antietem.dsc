$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Ruse De Guerre" @
         "\n<f1>Weather: <f0> Raining" @
         "\n<f1>Time of Day: <f0> 25 o'clock" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> are met on the battle grounds of Ruse De Guerre. Equipped with a small base and a dropship, they go head-to-head for each-other's flag. Holding the middle is worth a point, and the first team to gain 7 points wins." @
	 "\n\n<f1>Map By:<f4> XGN L. Spiro and XGN LadyShar";