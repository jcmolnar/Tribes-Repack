$MDESC::Type = "CTF_S_hift";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Nova Vet'ia Prime" @
         "\n<f1>Weather: <f0> Dry" @
         "\n<f1>Time of Day: <f0> Noon" @ 
         "\n<f1># of Teams: <f0> 2" @
	 "\n\n<f1>Description:<f0>  The <vServer::teamName0> and <vServer::teamName1> tribes look forward to annihilating eachother. This will be an interesting battle. Hidden treats await you... " @

"\n\n<f1>Briefing:<f0> Each team must grab the other's flag and bring it back to your base to capture it for <f1>1 point<f4>." @
"\nTake special note that visibility will be very poor, protection and maintenance of your sensor network will drastically improve your chances of survival." @
"\nThe first team to reach <f1>8 points<f4> shall be deemed the victor!" @

"\n\n<f4>Map By:<f4> S_hift" @

"\n\n\n<f1>Version.<f4> 1.0"; @



