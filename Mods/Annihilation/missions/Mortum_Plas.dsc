$MDESC::Type = "Plasmatic_Maps";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Kiss my Ass" @
         "\n<f1>Planet: <f0> Jumpers Place" @
         "\n<f1>Weather: <f0> Cold as the Popes wiener." @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> 2 Teams battle for control of the famous Mortum tower. It seems the lost tribe of Mortum created a Mortar gun light enough for all armors to carry. The winner in this battle will control this sought after technology.\n\n        <f2>Origional coding by [kmA]^Plasmatic^\n             <f1>Map By ^^Plasmatic^^\n             Ziptiezmail@netscape.net";