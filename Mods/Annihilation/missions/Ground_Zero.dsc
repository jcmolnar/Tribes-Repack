$MDESC::Type = "Capture the Flag Ground";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Planet: <f0> Argentis II" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n<f1>Made by: <f0> RavensBro" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> Are trying to destory each other's base here and capture the other's flag. They have made there base's in the side of the hill's it seem's kinda hard to get in them but it can be done. The first team to capture the other's team flag six time's first shall have the win!";