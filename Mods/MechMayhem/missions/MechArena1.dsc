$MDESC::Type = "Mech Mayhem";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Mech Mayhem" @
	"\n<f1>Planet: <f0> Hepta Ourubis II" @
	"\n<f1>Weather: <f0> Clear -- red desert" @
	"\n<f1>Time of Day: <f0> Midday" @
	"\n<f1># of Teams: <f0> None - free for all" @
	"\n\n<f1>Briefing: <f0> The Second Fire has reached the red sands. Every pilot is strapped into ten meters of walking artillery -- HERCs only, no infantry, no mercy. Kill or be killed.";
