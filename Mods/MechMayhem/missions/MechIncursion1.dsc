$MDESC::Type = "Mech Mayhem";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Mech Mayhem" @
	"\n<f1>Planet: <f0> Hepta Ourubis II" @
	"\n<f1>Weather: <f0> Clear -- red desert" @
	"\n<f1>Time of Day: <f0> Midday" @
	"\n<f1># of Teams: <f0> Co-op -- defenders vs the Cybrid horde" @
	"\n\n<f1>Briefing: <f0> The Cybrids have found the outpost. Hold the red sands against escalating waves -- swarms first, then the lines, then Prometheus itself. Survive ten waves or die in the attempt.";
