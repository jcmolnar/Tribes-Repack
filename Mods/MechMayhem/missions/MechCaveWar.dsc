$MDESC::Type = "Mech Mayhem";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Mech Mayhem" @
	"\n<f1>Planet: <f0> The Depths" @
	"\n<f1>Weather: <f0> Strangely cool" @
	"\n<f1>Time of Day: <f0> Undetectable" @
	"\n<f1># of Teams: <f0> None - free for all" @
	"\n\n<f1>Briefing: <f0> Seismic activity detected in the area has led your specialized team to an enemy cave concealing an entire enemy base system. But first you need to take out the forward defense. Pilots get to your HERCS!";
