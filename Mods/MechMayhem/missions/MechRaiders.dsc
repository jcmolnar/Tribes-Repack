$MDESC::Type = "Mech Mayhem";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Mech Mayhem" @
	"\n<f1>Planet: <f0> Starsiege Raiders" @
	"\n<f1>Weather: <f0> Hot -- indoor concrete and steel" @
