$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Capture the Flag" @
         "\n<f1>Planet: <f0> Tyr's Cradle" @
         "\n<f1>Weather: <f0> Dark" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> are deciding who owns the skies of Tyr's Cradle.  Each team must grab the other's flag and successfully bring it back to their flag to capture it for 5 Team Points. The first team to reach 30 points shall be the victor!" @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> [TPG]SaNTa[DTM]";

