$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Capture and Hold" @
         "\n<f1>Planet: <f0> Ymir" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle for control of three towers on the jagged moutains of Ymir.  Control of these towers not only means points gained for the Team but also control of the vital radar towers. The first Team to 300 points wins the match!" @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
