$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Capture the Flag" @
         "\n<f1>Planet: <f0> Dramicus" @
         "\n<f1>Weather: <f0> Dry" @
         "\n<f1>Time of Day: <f0> Miday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1>battle each other over Dramicus.  Each team must grab the other's flag and successfully bring it back to there flag to capture it for a 5 points. A fast departure may be gained by using the SkiJump, but who is waiting to catch you?. The first team to reach 30 points shall be the victor!" @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> [TPG]SaNTa[DTM]";



