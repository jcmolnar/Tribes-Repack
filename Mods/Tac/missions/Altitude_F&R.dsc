$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Find and Retrieve" @
         "\n<f1>Planet: <f0> Garden of Vishnu" @
         "\n<f1>Weather: <f0> Slight Haze" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle for control of four flags.  The four flags located on the Central Platform must be brought back to the four Flag Platforms owned by each team. Each flag is worth 50 points. The first team to 180 points shall be the victor.  10 points can also be gained by controlling the Central Platform." @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> [DH]RogueQD[TPG]";