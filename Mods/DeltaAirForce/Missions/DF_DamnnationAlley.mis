$teamScoreLimit = 4;
exec(objectives);
$Game::missionType = "Delta Force";
$cdTrack = 6;
$cdPlayMode = 1;
exec(misrestart);
$DefaultTeamEnergy = "190000";
$incTeamEnergy = 100;
$secTeamEnergy = 60;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_DamanationAlley_v0.3   <f0>  Mission Type:<f1> Capture the Flag.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>The <vServer::teamName0><f0> and <f1><vServer::teamName1><f0> have both been conducting covert night ops & raids in hope of catching each other with their guard down.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>The dense black night severely limits visibility within and around the ravine that spans the two opposing bases.\", 5);", 10);
        schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>Take special note that visibility will be very poor; setting up, protecting and maintaining the base sensor network will drastically improve your chances of survival.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Victory Conditions:<f0> Grab the Enemy Flag and bring it back to your base to capture it for <f1>1 point<f4>. The first team to reach <f1>4 points<f4> will rule Damnnation Alley !!!\", 15);", 20);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 20);", 25);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 25);
}



