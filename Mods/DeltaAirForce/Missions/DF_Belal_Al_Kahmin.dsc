$MDESC::Type = "DELTA AIR FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0>  TDM" @
         "\n<f1>Location: <f0> Deep desert" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> While campaigning through the desert, <f1><vServer::teamName0><f0> and <f1><vServer::teamName1><f0> have detected each other's presence."@
         "\n\n<f1>Each squad has been given orders to eliminate the other."@
         "\n\n<f1>To win, kill as many of the enemy as possible in one hour."@
         "\n\n<f1>Each team must assign a commands via the Tab menu, so that he or she can deploy a base for the team. The commander needs at least one half of the team to set him or her to commander!"@
