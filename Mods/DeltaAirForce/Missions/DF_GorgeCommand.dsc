$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0>  CTF" @
         "\n<f1>Location: <f0> Drought Striken Balkens" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Morning" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> Fighting for control of the currently dry water way, control of the bridge is key, as well as the dam. Choppers are available to the north, and tanks are available at the base. Capture the enemy flag 6 times to win."@
