$teamScoreLimit = 500;
exec(objectives);
$Game::missionType = "C&H";
$cdTrack = 10;
$cdPlayMode = 1;
exec(misrestart);
$DefaultTeamEnergy = "190000";
$incTeamEnergy = 100;
$secTeamEnergy = 15;
$spawnBuyList[4] = Grenade;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_Citadels_v0.3 <f0>  Mission Type:<f1> Capture and Hold.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Briefing:<f0> The <f1><vServer::teamName0><f0> and <f1><vServer::teamName1><f0> platoons attempt to hold vital citadels in the desert of Sudan.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>Each Citadel controlled is worth <f1>12 Points<f0> per minute.\", 5);", 10);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>Air Support is crucial for mass Troop movement in this mission.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 15);", 20);
        schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
}


