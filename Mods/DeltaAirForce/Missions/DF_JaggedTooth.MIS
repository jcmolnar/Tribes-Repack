exec(misrestart);
$Server::timeLimit = 5;
$Server::TeamDamageScale = 100;
exec(dm);
$hostageGame = 0;
$DMScoreLimit = 0;
$Game::missionType = "DMTEAM";
$cdTrack = 10;
$cdPlayMode = 1;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

function Game::playerSpawned(%pl, %clientId, %armor)
{	  
   //spawn base Infantry and health kit
   Player::setItemCount(%clientId,$ArmorName[%armor],1);
   Player::setItemCount(%clientId,SOCOM,1);
   Player::setItemCount(%clientId,SOCOMAmmo,50);
   Player::setItemCount(%clientId,OICW,1);
   Player::setItemCount(%clientId,OICWAmmo,150);
   Player::setItemCount(%clientId,RepairKit,1);
   Player::setItemCount(%clientId,Grenade,3);
   Player::setItemCount(%clientId,MineAmmo,2);

	Player::useItem(%pl,OICW);
   
   if($teamplay)
   {
      DMTEAM::checkMissionObjectives();
      DMTEAM::echoScores();
   }
}
function leaveMissionAreaDamage(%client)
{
	%player = Client::getOwnedObject(%client);
	if(%player.outArea == 1) {
		if(!Player::isDead(%player)) {
		  	Player::setDamageFlash(%client,0.1);
			GameBase::setDamageLevel(%player,GameBase::getDamageLevel(%player) + 0.25);
	   	schedule("leaveMissionAreaDamage(" @ %client @ ");",1);
		}
		else { 
			playNextAnim(%client);	
			Client::onKilled(%client, %client);
		}
	}
}

//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_JaggedTooth_v0.2 <f0>  Mission Type:<f1> Fire Fight.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1><vServer::teamName0><f0> and the <f1><vServer::teamName1>,<f0> out on patrol on the edge of the enemy's sector, have met head on in a small rocky pass.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>It is Kill or be Killed in this <f1>5<f0> minute <f1>Infantry<f0>-based <f1>Fire Fight.<f0>\", 5);", 10);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Victory Conditions: Team Death Match<f0> scoring is used to post the performance of the Squad on the battle field during <f1>Fire Fight<f0> scenarios.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 15);", 20);
        schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
}


