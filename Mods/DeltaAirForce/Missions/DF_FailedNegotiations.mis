//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
      schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_FailedNegotiations_v0.5  <f0>  Mission Type:<f1>  Hostage Capture and Hold.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc> Seizing a chemical research facility, a terrorist organization has forced a group of scientists to develop a bio-chemical agent capable of killing tens of thousands of people.\", 0);", 7);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 7);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>The terrorists have issued a ransom message demanding the release of imprisoned compatriots and a large sum of money, or they will use the agent on a heavily populated city.\", 7);", 14);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 14);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>However, negotiations have failed and the terrorists are proceeding to gather the hostages for execution.\", 14);", 19);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 19);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>It is now time for the <f1><vServer::teamName0><f0> to capture the facility, rescue the scientists, and eliminate the terrorists.\", 19);", 24);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 24);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Conditions of Victory:<f0> First Team to reach <f1>500<f0> points wins. \", 24);", 29);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 29);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>Terrorists:<f0> Gather the hostages, control the facility.\", 29);", 34);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 34);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc><vServer::teamName0>:<f0> Eliminate Terrorists, capture the facility, return the scientists to the troop transport.\", 34);", 39);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 39);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 39);", 44);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 44);
}



