exec(misrestart);
$DefaultTeamEnergy = "190000";
$incTeamEnergy = 100;
$secTeamEnergy = 15;
$spawnBuyList[4] = Grenade;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 65;

//---------------------------------------
//function prevents automatic flag return
//---------------------------------------

function Flag::onDrop(%player, %type)
{
   %playerTeam = GameBase::getTeam(%player);
   %flag = %player.carryFlag;
   %flagTeam = GameBase::getTeam(%flag);
   %playerClient = Player::getClient(%player);
   %dropClientName = Client::getName(%playerClient);

   if(%flagTeam == -1)
   {
      sendMessageExcept(%playerClient, 1, %dropClientName @ " dropped " @
%flag.objectiveName @ "!");
      Client::sendMessage(%playerClient, 1, "You dropped "  @
%flag.objectiveName @ "!");
   }
   else
   {
      sendMessageExcept(%playerClient, 0, %dropClientName @ " dropped the " @
getTeamName(%flagTeam) @ " flag!");
      Client::sendMessage(%playerClient, 0, "You dropped the " @
getTeamName(%flagTeam) @ " flag!");
      TeamMessages(1, %flagTeam, "Your flag was dropped in the field.", -2,
"", "The " @ getTeamName(%flagTeam) @ " flag was dropped in the field.");
   }
   GameBase::throw(%flag, %player, 10, false);
   Item::hide(%flag, false);
   Player::setItemCount(%player, "Flag", 0);
   %flag.carrier = -1;
   %player.carryFlag = "";
   Flag::clearWaypoint(%playerClient, false);
 %flag.dropFade = 1;
   ObjectiveMission::ObjectiveChanged(%flag);
}


//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_ReignDeath_v1.6<f0>  Mission Type:<f1> Capture the Flag.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Classified information: <f0> Overview compiled from aerial photographs, espionage and reconnaissance missions.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#1:<f0> Main base and tower house a majority of the artillery functions and power supplies. Reports of an intricate power grid enabling weapons, elevators, supply stations, and blast doors to be powered separately.\", 5);", 10);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#2:<f0> Unconfirmed reports of Minefields located in unprotected rear quarters of base perimeter.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#3:<f0> Bridge bunker power source appears to be independent from the main power grid.\", 15);", 20);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#4:<f0> Perimeter bunkers may be boobietrapped.  Possibly containing miscellaneous weapons or supplies.\", 20);", 25);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 25);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#5:<f0> Hard mounted weapons consist of 20mm Cannons, SAM emplacement, AAFlak Gun and a Howitzer, operated manually or with remote command stations.\", 25);", 30);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 30);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#6:<f0> Vehicle Depot, located near main base, has the capability of producing a variety of ground based vehicles and aerial attack/transport units.\", 30);", 35);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 35);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#7:<f0> Bridge objective appears to be protected by a 20mm cannon located in the vicinity on bridge bunker overlooking a boulder populated valley.\", 35);", 40);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 40);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Item#8:<f0> Unconfirmed sniper activity originating from boulder hill.\", 40);", 45);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 45);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Conditions of Victory: <f0>Each flag is worth <f1>1<f0> point. Controling the Bridge is also worth <f1>1 point.   Five Points<f0> are needed to Win.\", 45);", 50);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 50);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 50);", 55);
        schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 55);
}


