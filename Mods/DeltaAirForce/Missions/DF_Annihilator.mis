//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_Annihilator_v0.8 <f0>  Mission Type:<f1> Capture and Hold\", 0);", 0); 
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>In the aftermath of a sandstorm, enemy platoons <f1><vServer::teamName0><f0> and the <f1><vServer::teamName1>,<f0> are once again battling over <f1>Water Wells<f0> in this dry and desolate region.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>Commanders:<f0> Assign <f1>Squad Leaders<f0> to carry out the Offensive Assault. Defensive preparations should be made against incoming enemy attacks. \", 5);", 10);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>Victory Conditions:<f0> High Score claims the precious Desert Water.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>Vehicle Armament<f0> may need <f1>LOADING<f0> before units are deployed. Use the <f1>Reloader Pack.<f0>\", 15);", 20);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc> TEAM COOPERATION IS ESSENTIAL!!! \", 20);", 25);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 25);
}



