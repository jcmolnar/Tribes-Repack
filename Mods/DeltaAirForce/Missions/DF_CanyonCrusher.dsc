$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag" @
         "\n<f1>Location: <f0> Desert Warfare Training Camp" @
         "\n<f1>Weather: <f0> Dry" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
	 "\n\n<f1>Description:<f0>  Delta Force desert warfare training grounds carved into deep canyons and wide gorges. All resources are available for this CTF exercise. Air support is critical for defending the base from advanced attacks. " @

"\n\n<f1>Briefing:<f0> Each team must grab the other's flag and bring it back to their base to capture it for <f1>2 points<f4>. To add extra incentive, there is a flag worth <f1>3 bonus points<f4> located in the center of the primary canyon." @
"\nThe first team to reach <f1>15 points<f4> shall be the victor. " @

"\n\n<f0>--- For use with the <f1>DELTA FORCE TRIBES<f0> modification. ---" @
"\n<f1>Map Notes:<f0> DF_CanyonCrusher_v0.6  12/5/00.  Redesigned by:<f1> Thrax-THC- ODFC" @
"\n<f1>http://planetstarsiege.com/deltaforce/            <f0>email: <f1>thrax@whoever.com" @
"\n\n<f0>Original CanyonCrusade terrain and building layout by:<f1> |MX3| DOX";
