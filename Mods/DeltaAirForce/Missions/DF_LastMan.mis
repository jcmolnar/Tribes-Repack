exec(objectives);
exec(misrestart);
$teamScoreLimit = 10;
$DefaultTeamEnergy = "10000";
$incTeamEnergy = 100;
$secTeamEnergy = 60;
$Game::missionType = "LastTeamStanding";
$cdTrack = 3;
$cdPlayMode = 1;

function leaveMissionAreaDamage(%client)
{
	%player = Client::getOwnedObject(%client);
	if(%player.outArea == 1) {
		if(!Player::isDead(%player)) {
		  	Player::setDamageFlash(%client,0.1);
			GameBase::setDamageLevel(%player,GameBase::getDamageLevel(%player) + 0.25);
	   	schedule("leaveMissionAreaDamage(" @ %client @ ");",1);
		}
		else { 
			playNextAnim(%client);	
			Client::onKilled(%client, %client);
		}
	}
}
