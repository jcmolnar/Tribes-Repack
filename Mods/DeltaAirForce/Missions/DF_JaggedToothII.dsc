$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0>  Fire Fight" @
         "\n<f1>Planet: <f0> 37th Parallel" @
         "\n<f1>Weather: <f0> clear" @
         "\n<f1>Time of Day: <f0> Night" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing: <f1><vServer::teamName0><f0> and the <f1><vServer::teamName1>,<f0> out on patrol on the edge of the enemy's sector, have met head on in a small rocky pass. It is Kill or be Killed in this <f1>15<f0> minute <f1>Infantry<f0>-based <f1>Fire Fight.<f0>" @
"\n<f1>Victory Conditions: Death Match<f0> scoring is used to post the individual <f1>Infantry Soldier<f0> performance on the battle field during <f1>Fire Fight<f0> scenarios." @
"\nThis mission is the same as DF_JaggedTooth with the starting positions reversed. " @

