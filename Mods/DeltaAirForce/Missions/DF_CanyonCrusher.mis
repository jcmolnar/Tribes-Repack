$teamScoreLimit = 15;
exec(objectives);
$Game::missionType = "Capture the Flag";
$cdTrack = 6;
$cdPlayMode = 1;
exec(misrestart);
$DefaultTeamEnergy = "190000";
$incTeamEnergy = 100;
$secTeamEnergy = 15;
$spawnBuyList[4] = Grenade;
$hostageGame = 0;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_CanyonCrusher_v0.6 <f0>  Mission Type:<f1> Capture the Flag\", 0);", 0); 
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc><f1>Description:<f0>  Delta Force desert warfare training grounds. All resources are available for this CTF exercise.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc><f1>Briefing:<f0> Grab the other team's flag and bring it back to your base to capture it for <f1>2 points<f4>. The first team to reach <f1>15 points<f4> claims victory.\", 5);", 10);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>To add extra incentive, the Canyon Bonus Flag is worth <f1>3 points.<f4>\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 15);", 20);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
}


