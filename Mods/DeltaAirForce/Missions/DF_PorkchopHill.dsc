$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture and Hold" @
         "\n<f1>Location: <f0> Not on any map you've seen." @																						
         "\n<f1>Conditions: <f0> Insurmountable." @
         "\n<f1>Time: <f0> ...to say your prayers." @ 
         "\n<f1># of Teams: <f0> 2" @
"\n\n<f2>Prelude:" @
"\n\n<f1>Listen UP, soldiers!" @
"\n<f0>    Nervous?    ...sure ya are." @
"\n<f1>I'm only going to tell you this one time." @
"\n<f0>    You have no idea where the transport has brought you." @
"\n<f1>The last batch of GRUNTS are being shipped home in body bags." @
"\n<f0>    From the stories you have heard, it's no doubt you're nervous." @
"\n<f1>If you don't want to be on the next flight with a tag on your toe, you had better pay attention!!" @
"\n<f0>    All sense of the reason why has been lost, but the order continues to be handed down." @
"\n<f1>The enemy has been ruthlessly pounding our positions. There is no intention on their part to relinquish control of the area." @
"\n<f0>    You just hope..." @
"\n<f1>The rugged terrain surrounding this valley prevents ground vehicles from assisting, and our supplies are limited." @
"\n<f0>    That by the end of this tour, you'll be the one telling the stories." @
"\n<f1>With any luck, the AIR CALVARY, along with reinforcements, will bring much needed resources." @
"\n<f0>    Not just another slab of meat" @
"\n<f1>Any questions?" @
"\n<f0>    ...on<f2> PORKCHOP HILL." @
"\n\n<f0>--- For use with the <f1>DELTA FORCE TRIBES<f0> modification. ---" @
"\n<f1>Map Notes:<f0> DF_PorkchopHill_v0.5  12/10/00.  Designed by:<f1> Thrax-THC- ODFC" @
"\n<f1>http://planetstarsiege.com/deltaforce/            <f0>email: <f1>thrax@whoever.com";
