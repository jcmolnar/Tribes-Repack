function falseJail(%deg, %pl)
{
	if(%deg ==1)
		%pl.inJail = false;
	if(%deg == 2)
		%pl.inJail2 = false;
}


function TowerSwitch::onCollision(%this, %object)
{
   if(getObjectType(%object) != "Player")
      return;

   if(Player::isDead(%object))
      return;
   
   %playerClient = Player::getClient(%object);
   %touchClientName = Client::getName(%playerClient);
   %group = GetGroup(%this);
   %doorGroup = Group::getObject(%group,1); // Asuming our door is the second in the group
   %door = Group::getObject(%doorGroup,1); // Asuming our door is the second in the group



   if( Moveable::getPosition(%door) == 1) { //then its closed. Lets open it.
      MessageAllExcept(%playerClient, 0,Object::getName(%group) @ " has been opened");
      Client::sendMessage(%playerClient, 0, "You opened " @ Object::getName(%group) @ "!");
      MoveDoor(%door);
   } else if(Moveable::getPosition(%door) == 0 ){ // then it might be open. Lets close it.
      MessageAllExcept(%playerClient, 0,Object::getName(%group) @ " has been closed");
      Client::sendMessage(%playerClient, 0, "You closed " @ Object::getName(%group) @ "!");
      MoveDoor(%door);
   }
}

function MoveDoor(%door) 
{
//echo(Moveable::getPosition(%door) );
	if(Moveable::getPosition(%door) == 0 )
	{
		Moveable::moveToWaypoint(%door,1);
		%door.status = "close";
	
	} else if(Moveable::getPosition(%door) == 1 )
	{
		Moveable::moveToWaypoint(%door,0);
		%door.status = "open";
	
	}
}