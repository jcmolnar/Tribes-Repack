$teamScoreLimit = 100;
exec(objectives);
$Game::missionType = "Jail";
$cdTrack = 2;
$cdPlayMode = 1;
$InvList[Beacon] = 0;
$RemoteInvList[Beacon] = 0;
$InvList[AmmoPackSmall] = 0;
$RemoteInvList[AmmoPackSmall] = 0;

function GroupTrigger::onContact(%this, %object)
{
	%pl = Player::getClient(%object);
	if(Player::isAiControlled(%object)) {
		$teamScore[1] += 20;
		MessageAllExcept(Player::getClient($HostageOwner[%pl]), 0, Client::getName($HostageOwner[%pl]) @ " captured " @ Client::getName(%lp) @ "!~wflagcapture.wav");
                Client::sendMessage(Player::getClient($HostageOwner[%pl]), 0, "You captured " @ Client::getName(%lp) @ "!~wflagcapture.wav");
                Player::getClient($HostageOwner[%object]).score += 5;
		gamebase::setposition(%object, "0 0 -2000");
		$TakenHostages[Player::getClient($HostageOwner[%object])]--;

	} else if(GameBase::getTeam(%object) == 0 && !%pl.injail && !%pl.injail2) {
		pl.inJail = true;
		pl.inJail2 = true;
		//schedule ("falseJail(1, \"" @ %pl @ "\");",1);
		//schedule ("falseJail(2, \"" @ %pl @ "\");",3);

		//MessageAllExcept(Player::getClient(%object), 0, Client::getName(%object) @ " got stuck in jail!");
                //Client::sendMessage(Player::getClient(%object), 0, "You got stuck in jail!");
                Player::setItemCount(%pl,Blaster,0);
		Player::setItemCount(%pl,Chaingun,0);
		Player::setItemCount(%pl,Disclauncher,0);
		Player::setItemCount(%pl,GrenadeLauncher,0);
		Player::setItemCount(%pl,Mortar,0);
		Player::setItemCount(%pl,PlasmaGun,0);
