//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
      centerprint(%clientId, "<jc><f0>Mission Briefing for: <f1>DF_BridgeTooFar_v0.5\n<f0>Mission Type: <f1>" @ $Game::missionType @ "\n<f0>Press <f1>'O'<f0> for specific objectives.", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1><vServer::teamName0> Briefing:<f0> The <f1><vServer::teamName0><f0> will escort the <f1>V.I.P.<f0> to the ICBM Silo. The <f1>V.I.P.<f0> disarms the missile by touching the <f2>Control Switch.<f0>\", 5);", 10);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc><vServer::teamName1> Briefing:<f0> Your abilities as a crack-shot are on the line, as a squad of uninvited guests have been spotted descending from the sky, infiltrating your country's soil.\", 10);", 15);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<f0><jc>Stop the squad from reaching their destination, and you will be hailed as the People's Hero!!!\", 15);", 20);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 20);", 25);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 25);
}

