$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0>  Hostage" @
         "\n<f1>Location: <f0> Unknown: North Africa" @
         "\n<f1>Weather: <f0> Cloudy" @
         "\n<f1>Time of Day: <f0> Evening" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> In an attempt to recapture <vServer::teamName2> POWs significant to on going war trials, the <vServer::teamName1> have droped a squad of commandos near the war prison of <vServer::teamName0>. The <vServer::teamName0> must prevent the capture of their prisoners, and eliminate as many of the enemy as possible, while the <vServer::teamName1> must try to capture as many of the <vServer::teamName2> POWs as they can, without taking significant losses."@
