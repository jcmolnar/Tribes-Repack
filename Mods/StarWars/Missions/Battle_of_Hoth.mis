if($uteleport::effect == "")
$uteleport::effect = true;

if($uteleport::flashdamage == "")
$uteleport::flashdamage = true;

if($uteleport::sound == "")
$uteleport::sound = true;

if($uteleport::fade == "")
$uteleport::fade = true;

if($uteleport::telekill == "")
$uteleport::telekill = false;

if($uteleport::checkpower == "")
$uteleport::checkpower = false;

if($uteleport::rechangetime == "")
$uteleport::rechangetime = 0;

if($uteleport::falshradius == "")
$uteleport::flashradius = 5;

if($uteleport::flashcolor == "")
$uteleport::flashcolor = "255 255 0";

SoundData teleportsound
{
	wavFileName = "teleport2.wav";
	profile     = Profile3dNear;
};

ExplosionData turretTele
{
	shapeName = "fusionex.dts";
	faceCamera = true;
	randomSpin = true;
	hasLight   = true;
	lightRange = 0;
	time = 20;
	timeZero = 0.1;
	timeOne  = 2.750;
	radFactors = { 7.0, 7.0, 7.0 };
};

RocketData TeleportProj
{
bulletShapeName  = "breath.dts";
explosionTag = turretTele;
collisionRadius  = 0.0;
mass = 0.0;
damageClass = 0;
damageValue = 0.15;
damageType = $PlasmaDamageType;
explosionRadius = 1.0;
kickBackStrength = 0;
muzzleVelocity   = 5.0;
terminalVelocity = 5.0;
acceleration = 0.0;
totalTime = 0.0;
liveTime = 15;
inheritedVelocityScale = 0.0;
 };
function Teleport::Teffect(%this, %elev)
{
%pos = Gamebase::getposition(%this);
%trans = "0 0 0 0 0 0 0 0 0 " @ %pos;
%fired = Projectile::spawnProjectile(TeleportProj, %trans ,%this,"0 0 0");
}


function GroupTrigger::onEnter(%this, %object)
{
%telecount = 0;
%count = 0;
%playerClient = Player::getClient(%object);
%clientName = Client::getName(%playerClient);
%playerTeam = GameBase::getTeam(%playerClient);
%objteam = gamebase::getteam(%this);
%group = GetGroup(%this);
%count = group::objectcount(%group);
if($uteleport::checkpower)
{
	if(!gamebase::ispowered(%this))
	{
		client::sendmessage(%playerclient, 1, "Teleporter not powered ~waccess_denied.wav");
		return;
	}
	


}




for(%j = 0; %j < %count; %j++)
{
	%countitem = group::getobject(%group, %j);
	%countname = gamebase::getdataname(%countitem);
	if(%countname == "DropPointMarker" || %countname == "PathMarker")
		%realcount++;
}
%rand = floor(getrandom() * %realcount);
for(%i = 0; %i < %count; %i++)
{
	%item = group::getobject(%group, %i);
	%objname = gamebase::getdataname(%item);
	if(%objname == "DropPointMarker" || %objname == "PathMarker")
	{
		%teleports[%telecount] = %item;
		%telecount++;
	}

}

	if(%telecount != 0)
	{
		%place = %teleports[%rand];
		%objname = gamebase::getdataname(%place);
		if(%playerteam ==  %objteam || %objteam == -1)
		{
			if(%objname == "DropPointMarker")
			{
                                tele(%object, gamebase::getposition(%place), gamebase::getrotation(%place), %this);
				echo("Teleport: " @ %clientname @ " to " @ gamebase::getposition(%place) @ " and rotation " @ gamebase::getrotation(%place));
			}
			else
			{
                                tele(%object, gamebase::getposition(%place), "NoRot", %this);
				echo("Teleport: " @ %clientname @ " to " @ gamebase::getposition(%place) @ "(without rotation)");
			}

		}
			else
			client::sendmessage(%playerclient, 1, "Teleport Access Denied - Wrong Team" @ "~waccess_denied.wav");
		}
		else
		{
			echo("TELEPORT ERROR: NO POSITION POINTS FOUND IN SPECIFIED TRIGGER GROUP");
			echo("Thier must be a marker or drop point in the same group as the trigger");
		}




}

function tele(%objid, %finalpos, %finalrot, %thisid)
{
%clientid = player::getclient(%objid);

if($uteleport::telekill)
{
	
	%telekill = floor(getrandom() * 100)+1;
	if(%telekill <= $uteleport::telekill)
	{
		player::blowup(%objid);
		GameBase::setDamageLevel(%objid, 999);
		messageall(0, client::getname(%clientid) @ " dies.");
		client::sendmessage(%clientid, 1, "Your molecules were scrambled while attemping to teleport.");
		return;
	}
}



if($uteleport::rechargetime)
{

        if(%thisid.recharging == true)
        {
                client::sendmessage(%clientid, 1, "Teleport is recharging");
                return;
        }

}

if($uteleport::rechargetime)
        {
                %thisid.recharging = true;
                schedule("recharge(" @ %thisid @ ");", $uteleport::rechargetime);
                                     
        }

if($uteleport::sound)
gamebase::playsound(%clientid, teleportsound, 0);

if($uteleport::effect)
teleport::Teffect(%objid);

if($uteleport::fade)
gamebase::startfadeout(%clientid);

if($uteleport::sound)
client::sendMessage(%clientid, 0, "~wteleport2.wav");

if($uteleport::flashradius)
{
pointlight(client::getname(%clientid), 1,  gamebase::getposition(%clientid), $uteleport::flashcolor, $uteleport::flashradius);
}


GameBase::setPosition(%clientid, %finalpos);



if($uteleport::flashradius)
{
pointlight(client::getname(%clientid), 1,  gamebase::getposition(%clientid), $uteleport::flashcolor, $uteleport::flashradius);
}


if($uteleport::flashdamage)
Player::setDamageFlash(%clientid, 0.3);

if(%finalrot != "NoRot")
Gamebase::setrotation(%clientid, %finalrot);

if($uteleport::sound)
gamebase::playsound(%clientid, teleportsound, 0);

if($uteleport::effect)
teleport::Teffect(%objid);

if($uteleport::fade)
gamebase::startfadein(%clientid);
}
                                 
function recharge(%this)
{
        %this.recharging = false;
}

function pointlight(%name, %remaintime, %position,%color, %range)
{

%delname = "MissionCleanup\\\\" @ %name;
%posx = getword(%position, 0);
%posy = getword(%position, 1);
%posz = getword(%position, 2);
%R = getword(%color, 0) / 255;
%G = getword(%color, 1) / 255;
%B = getword(%color, 2) / 255;
%plight = Newobject(%name, "Simlight", Point, %range, %R, %G, %B, %posx, %posy, %posz);
addToSet("MissionCleanup", %plight);
schedule("deleteobject(\"" @ %delname @ "\");", %remaintime);