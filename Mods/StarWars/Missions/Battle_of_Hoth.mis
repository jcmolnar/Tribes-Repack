$teamScoreLimit = 5;
exec(objectives);
$Game::MissionType = "CTF";
$cdTrack = 2;
$cdPlayMode = 1;

$uteleport::effect = false;
$uteleport::flashdamage = true;
$uteleport::sound = true;
$uteleport::fade = true;
$uteleport::telekill = 0;
$uteleport::checkpower = false;
$uteleport::rechargetime = 0;
$uteleport::flashradius = 10;
$uteleport::flashcolor = "255 255 0";

//Uranium-235's EZ teleporter script V1.6
//Just put a trigger in it's own group and put eather a marker(not map marker) or drop point in the same group
//Drop point: will teleport the player to the position of the drop point WITH ROTATION
//marker(not map marker): will teleport the player to the position of the marker WITHOUT ROTATION
//You can put one trigger & drop point/marker and it will teleport the player to one of those with the two rules above
//you can put more than one trigger & drop point/marker and it will randomly select one to teleport the player to
//this is TEAM SPECIFIC. If the group & trigger it is in belongs to team 1..only team 1 player are allowed through.
//If you want to turn team specific off don't put the group & trigger in an teamgroup. put it anywhere out of them...
//to where the team says -1
//ya understand? NO? Q's to tribesaddict@go.com

//here are configs to configure the teleport. these can be put at the bottom of the .mis file
//or in this script. If they aren't set the script will assume they're all on
//$uteleport::effect = true/false;              //energy ball effect  (true/false)
//$uteleport::flashdamage = true/false;         //flash damage(red flash) effect (true/false)
//$uteleport::sound = true/false;               //sound (true/false)
//$uteleport::fade = true;                      //fades in/out the player (true/false);
//$uteleport::telekill = 0;                    //percent chance any player will be killed if going through the teleport(teleport accident). Put 0 to disable it
//$uteleport::checkpower = true/false;          //checks the group the trigger is in is powered
//$uteleport::rechargetime = 5;                 //time the teleport recharges after player enters it. Put 0 to disable it
//$uteleport::flashradius = number;             //flash radius when the player teleports. set to 0 to disable it. NOTICE: flashes will show through walls. and radiuses of 15 or over could cause lag
//$uteleport::flashcolor = "255 255 255";       //sets the color of the flash. Thier is a program that comes that will help you select the color. 



//so just put the varable (without the comments) and = true/false  
//EX: $uteleport::flashdamage = false;
//or: $uteleport::flashdamage = true;


//creation: 10.15.2K
//updated with config: 10.26.2K
//updated and fixed rotation bug with no rotation teleports: 10.28.2K
//updated and added the random teleport killing: 10.28.2K
//updated and added the power checking: 10.28.2K
//updated and added the recharge time: 10.28.2K-10.29.2K
//changed the light emmission type from breath.dts to simlight: 10.29.2K


