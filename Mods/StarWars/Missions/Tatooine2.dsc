$MDESC::Desc = "Capture the Flag";
$MDESC::Planet = "Tatooine";
$MDESC::TeamCount = "2";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Capture the Flag\n<f1>Planet: <f0> Tatooine\n<f1>Weather: <f0> Clear and Cold\n<f1>Time of Day: <f0> Day\n<f1># of Teams: <f0> 2\n\n<f1>Briefing:<f0> The Rebel Alliance have made a Jawa Sandcrawler their new mobile base on the planet Tatooine, but the Galactic Empire have now taken over Jabba's Palace!! You determine who will gain control of the Planet. The first team to capture the flag 8 times shall have victory!! This map is designed for use with the SWTC mod created by Machine. Prefabs by Krun.";
$MDESC::TimeOfDay = "Midday";
$MDESC::Type = "Star Wars";
$MDESC::Weather = "Clear";
