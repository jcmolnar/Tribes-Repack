$MDESC::Desc = "Vehicle Training";
$MDESC::Planet = "unknown";
$MDESC::TeamCount = "1";
$MDESC::Text = "<s3><f1>Sie Lange Nacht\n\nThe most popular of all the circuits. It is one of the longest Pro Circuits there is, and also one of the few with a liscense to operate after dark, as the TSC Administration has outlawed common night races due to the ammount of accidental deaths that occur. It's German name, translated into English, means 'The Long Night'. As if the race isn't long enough, fall off this baby and you're going to have a long year. Guten tag, mein freund, und  bitte nehmen sie den kurzesten weg. Bis spater, meinen vergunugen.";
$MDESC::TimeOfDay = "Midday";
$MDESC::Type = "Snowboarding";
$MDESC::Weather = "Snowing";
