$MDESC::Desc = "Vehicle Training";
$MDESC::Planet = "unknown";
$MDESC::TeamCount = "1";
$MDESC::Text = "<s3><f1>Valhala Speedway\n\nConsidered to be one of the Championship Circuits, Valhala was designed for speed and simplicity. It's four curves, however, make it a complicated adversary to master. Those who can stay on the track long enough to put the Victory Flag in their crosshairs are sure to be marked as true professionals. The key to this track is maintaining an insane speed, but slow at the turns. Watch for other Boarders, this aint no buddy-course.";
$MDESC::TimeOfDay = "Midday";
$MDESC::Type = "Snowboarding";
$MDESC::Weather = "Snowing";
