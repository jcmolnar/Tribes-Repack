$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Capture and Hold" @
         "\n<f1>Planet: <f0> Theta Draconis IV" @
         "\n<f1>Weather: <f0> Low Haze" @
         "\n<f1>Time of Day: <f0> Day" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle for control of six switches on the rolling hills of Theta Draconis IV.  Control of these towers not only means points gained for the Team but also control of the Pulse Sensors. The first Team to 600 points wins the match! " @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> [TPG]SaNTa[DTM]";
