$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Team Death Match" @
	"\n<f1>Planet: <f0> Omicron Argentis VI" @
	"\n<f1>Weather: <f0> Clear" @
	"\n<f1>Time of Day: <f0> Night" @
	"\n<f1># of Teams: <f0> 2" @
	"\n\n<f1>Briefing: <f0> Two bases, two teams, one sky. Blow as many enemy APC's out of the sky as possible and lose as few as possible in the time given. The winner will be the first team to reach 20 points or the team with the highest score at the end of the time period." @
   "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> [TPG]SaNTa[DTM]";
