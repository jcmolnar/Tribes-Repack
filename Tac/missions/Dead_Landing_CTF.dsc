$MDESC::Type = "TAC";
$MDESC::Text = "<s3><f1>Mission Type: <f0> TAC Capture the Flag" @
         "\n<f1>Planet: <f0> Avicord's Planet" @
         "\n<f1>Weather: <f0> Warm Summer Air" @
         "\n<f1>Time of Day: <f0> After Sunset" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle each other from the air bases.  Each team must grab the other's flag and successfully bring it back to their flag to capture it for a 5 points. The APC's are worth 2 points each so try not to destroy your own, but kill as many enemy ones as you can. The first team to reach 30 points shall be the victor!" @
         "\n\n<f1>For the TAC Mod:<f0> www.tribes-universe.com/tac/" @
	 "\n\n<f1>Map designed by:<f0> {EL}Orange{TPG]";