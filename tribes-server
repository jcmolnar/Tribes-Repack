# Wine
# ---------------------------------------------------------------------------------------
def file_sha1(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha1(f.read()).hexdigest()
    except OSError:
        return None


REEXEC_ENV = "TRIBES_SERVER_REEXEC"


def reexec_if_updated(before, note):
    """Re-run this script in place (same argv, same PID) when an update just replaced it.

    Relaunching the game from the old code still in memory is how the v36 switch to a 64-bit
    exe would have met a supervisor that only knew 32-bit Wine. Same PID, so systemd and
    supervisor.pid are unaffected, and serve() rebinds the control socket. The new file must
    compile first: a broken publish keeps the running version instead of killing the server."""
    me = os.path.abspath(__file__)
    after = file_sha1(me)
    if not (before and after and before != after):
        return
    try:
        with open(me, "r", encoding="utf-8") as f:
            compile(f.read(), me, "exec")
    except (OSError, SyntaxError, ValueError) as e:
        note("the updated tribes-server does not load (%s); staying on the running version" % e)
        return
    note("tribes-server itself was updated -- restarting it on the new version")
    sys.stdout.flush()
    sys.stderr.flush()
    os.environ[REEXEC_ENV] = "1"
    try:
        os.execv(sys.executable, [sys.executable, me] + sys.argv[1:])
    except OSError as e:
        os.environ.pop(REEXEC_ENV, None)
        note("could not restart on the new version (%s); continuing on the old one" % e)


def pe_machine(path):
    """'x64', 'x86' or None for a Windows exe (PE header Machine field)."""
    try:
        with open(path, "rb") as f:
            head = f.read(4096)
        off = struct.unpack_from("<I", head, 0x3C)[0]
        if head[:2] != b"MZ" or head[off:off + 4] != b"PE\0\0":
            return None
        m = struct.unpack_from("<H", head, off + 4)[0]
        return {0x8664: "x64", 0x14C: "x86"}.get(m)
    except (OSError, struct.error, IndexError):
        return None


def prefix_arch(prefix):
    """'win32' / 'win64' from an existing prefix's system.reg header, else None."""
    try:
        with open(os.path.join(prefix, "system.reg"), "r", errors="replace") as f:
            for _ in range(10):
                m = re.match(r"#arch=(win32|win64)", f.readline().strip())
                if m:
                    return m.group(1)
    except OSError:
        pass
    return None


def wine_arch(inst, cfg):
    """The Wine architecture this install needs. The game went 64-bit in v36 and a win32
    prefix cannot run a PE32+ exe, so an x64 exe always gets win64 -- even over an explicit
    `arch = win32` that older server.ini templates wrote."""
    exe = inst.exe()
    machine = pe_machine(os.path.join(inst.root, exe)) if exe else None
    arch = (cfg.get("wine", "arch") or "").strip().lower()
    if machine == "x64":
        return "win64"
    if arch in ("win32", "win64"):
        return arch
    return "win32" if machine == "x86" else "win64"


def wine_env(inst, cfg):
    env = dict(os.environ)
    arch = wine_arch(inst, cfg)
    # Separate default folders per arch: switching to the 64-bit game creates a fresh win64
    # prefix beside the old win32 one instead of reusing (or deleting) it.
    prefix = cfg.get("wine", "prefix") or os.path.join(inst.state, "wine64" if arch == "win64" else "wine")
    env["WINEPREFIX"] = os.path.abspath(prefix)
    env["WINEARCH"] = arch
    env["WINEDEBUG"] = cfg.get("wine", "debug") or "-all"
    # no Mono/Gecko install prompts, no desktop menu entries
    env["WINEDLLOVERRIDES"] = "mscoree=;mshtml=;winemenubuilder.exe=d"
    env["TRIBES_STDIO_CONSOLE"] = "1"   # simWinConsolePlugin.cpp: console on stdin/stdout
    env.pop("DISPLAY", None)            # headless: Wine's null graphics driver, never X
    env.pop("WAYLAND_DISPLAY", None)
    return env


def wine_bin(cfg):
    w = cfg.get("wine", "wine") or "wine"
    found = shutil.which(w)
    if not found:
        die("'%s' not found. Install Wine (Debian/Ubuntu: sudo apt update && "
            "sudo apt install --no-install-recommends wine wine64; a 32-bit -X86 game build "
            "also needs sudo dpkg --add-architecture i386 and wine32:i386)" % w)
    return found


def ensure_prefix(inst, cfg):
    env = wine_env(inst, cfg)
    prefix = env["WINEPREFIX"]
    have = prefix_arch(prefix)
    if have and have != env["WINEARCH"]:
        # Only reachable with a custom `prefix =` (the default folders are per-arch): never
        # delete someone else's prefix, say exactly what to change.
        die("Wine prefix %s is %s but the game needs %s (a 64-bit ModernTribes.exe cannot run in a "
            "32-bit prefix). Point [wine] prefix at a new folder, or blank it to use the built-in one."
            % (prefix, have, env["WINEARCH"]))
    marker = os.path.join(prefix, ".tribes-server-ready")
    if os.path.exists(marker):
        return env
    wine = wine_bin(cfg)
    inst.ensure_state()
    say("creating Wine prefix %s (first run only, ~1 minute) ..." % prefix)
    subprocess.run([wine, "wineboot", "-i"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=600)
    regs = [
        # null graphics driver: no X server / Wayland needed, ever
        ["HKCU\\Software\\Wine\\Drivers", "/v", "Graphics", "/d", "null"],
        # a crash must restart the server, not wait on an invisible winedbg dialog
        ["HKCU\\Software\\Wine\\WineDbg", "/v", "ShowCrashDialog", "/t", "REG_DWORD", "/d", "0"],
    ]
    for r in regs:
        subprocess.run([wine, "reg", "add"] + r + ["/f"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
    ws = shutil.which("wineserver")
    if ws:
        subprocess.run([ws, "-w"], env=env, timeout=120)
    # Only a prefix of the right architecture is "ready": without 64-bit Wine, wineboot fails
    # quietly (or builds a 32-bit one), and marking that ready would turn a clear install
    # error into a crash loop on every start. die() -> safe_launch stops with exit 3.
    made = prefix_arch(prefix)
    if made != env["WINEARCH"]:
        if env["WINEARCH"] == "win64":
            die("could not create a 64-bit Wine prefix in %s (got %s). The game is 64-bit: install "
                "64-bit Wine (Debian/Ubuntu: sudo apt install wine64), then delete that folder and "
                "start again. `./tribes-server doctor` checks it." % (prefix, made or "nothing"))
        die("could not create a %s Wine prefix in %s (got %s); install 32-bit Wine "
            "(Debian/Ubuntu: sudo dpkg --add-architecture i386 && sudo apt update && "
            "sudo apt install wine32:i386), delete that folder and start again"
            % (env["WINEARCH"], prefix, made or "nothing"))
    with open(marker, "w") as f:
        f.write("1\n")
    return env


# ---------------------------------------------------------------------------------------
# control socket (supervisor <-> CLI)
# ---------------------------------------------------------------------------------------
def sock_path(inst):
    p = os.path.join(inst.state, "control.sock")
    if len(p.encode()) < 100:
        return p
    d = os.path.join("/tmp", "tribes-server-%d-%s" % (os.getuid(), hashlib.sha1(inst.root.encode()).hexdigest()[:12]))
    os.makedirs(d, mode=0o700, exist_ok=True)
    return os.path.join(d, "control.sock")


def ctl_connect(inst):
    if not hasattr(socket, "AF_UNIX"):
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(sock_path(inst))
        return s
    except OSError:
        s.close()
        return None


def ctl_request(inst, op, **kw):
    s = ctl_connect(inst)
    if not s:
        return None
    kw["op"] = op
    s.sendall((json.dumps(kw) + "\n").encode())
    f = s.makefile("r", encoding="utf-8", errors="replace")
    return s, f


# ---------------------------------------------------------------------------------------
# supervisor (`run`)
# ---------------------------------------------------------------------------------------
class Supervisor:
    def __init__(self, inst, cfg, auto_update=None):
        self.inst, self.cfg = inst, cfg
        self.child = None
        self.lock = threading.RLock()
        self.ring = deque(maxlen=300)
        self.watchers = set()
        self.stop_requested = False
        self.restart_requested = False
        self.update_requested = None     # None | "empty" | "now"
        self.state = "starting"
        self.started_at = 0
        self.restarts = 0
        self.generation = 0              # launches so far (status: proves a restart happened)
        self.rapid = 0
        self.status = None
        self.last_answer = 0
        self.ever_answered = False
        self.remote_version = None
        self.auto_update_override = auto_update   # --no-update pins it off for this run
        self.settings = None
        self.load_policy()

    # -- supervisor policy: [update] + [supervisor] -----------------------------------------
    # These steer THIS process, not the game, so they apply live: the loop re-reads them
    # whenever server.ini changes (the tui's settings screen, `config set`, an editor).
    # They used to be read once at supervisor start, so turning auto_update on from the
    # tui did nothing -- not even after F8, which restarts only the game -- until a full
    # stop + start.
    def load_policy(self):
        cfg = self.cfg
        ov = self.auto_update_override
        self.auto_update = cfg.bool("update", "auto_update", False) if ov is None else ov
        self.check_every = max(5, cfg.int("update", "check_minutes", 30)) * 60
        self.restart_delay = cfg.int("supervisor", "restart_delay", 5)
        self.loop_limit = cfg.int("supervisor", "crash_loop_restarts", 5)
        self.hang_timeout = cfg.int("supervisor", "hang_timeout", 180)
        self.policy_mtime = self.ini_mtime()

    def ini_mtime(self):
        try:
            return os.stat(self.inst.config_path).st_mtime_ns
        except OSError:
            return None

    def reload_policy_if_changed(self):
        """True when auto_update was just switched ON (the caller checks for updates now)."""
        if self.ini_mtime() == self.policy_mtime:
            return False
        was = self.auto_update
        try:
            self.cfg = Config(self.inst)
        except (OSError, configparser.Error) as e:
            self.policy_mtime = self.ini_mtime()   # don't re-report a half-saved file every tick
            self.note("server.ini changed but could not be read (%s); keeping the current settings" % e)
            return False
        self.load_policy()
        if self.auto_update != was:
            self.note("auto-update is now %s" % ("on" if self.auto_update else "off"))
        return self.auto_update and not was

    # -- output fan-out --------------------------------------------------------------------
    def emit(self, line):
        line = line.rstrip("\r\n")
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
        with self.lock:
            self.ring.append(line)
            dead = []
            data = (line + "\n").encode("utf-8", "replace")
            for w in self.watchers:
                try:
                    # non-blocking: a stalled viewer is dropped, it never stalls the pump
                    if w.send(data, getattr(socket, "MSG_DONTWAIT", 0)) != len(data):
                        dead.append(w)
                except OSError:
                    dead.append(w)
            for w in dead:
                self.watchers.discard(w)
                try:
                    w.shutdown(socket.SHUT_RDWR)   # ends that client's thread too
                except OSError:
                    pass

    def note(self, msg):
        self.emit("[tribes-server] " + msg)

    def pump(self, child):
        for raw in iter(child.stdout.readline, b""):
            self.emit(raw.decode("latin-1"))

    def send(self, cmd):
        with self.lock:
            c = self.child
        if not c or c.poll() is not None:
            return False
        try:
            c.stdin.write((cmd.replace("\n", " ") + "\n").encode("latin-1", "replace"))
            c.stdin.flush()
            return True
        except OSError:
            return False

    # -- control socket ------------------------------------------------------------------
    def serve(self):
        path = sock_path(self.inst)
        try:
            os.unlink(path)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o077)
        try:
            srv.bind(path)
        finally:
            os.umask(old)
        srv.listen(8)
        self.sock_file = path
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                return
            threading.Thread(target=self.client, args=(conn,), daemon=True).start()

    def status_obj(self):
        st = load_state(self.inst)
        return {"state": self.state, "pid": self.child.pid if self.child else None,
                "uptime": int(time.time() - self.started_at) if self.started_at and self.state == "running" else 0,
                "restarts": self.restarts, "query": self.status, "installed": read_int(
                    os.path.join(self.inst.root, VERSION_FILE)),
                "latest": self.remote_version, "mode": st.get("mode"), "autoUpdate": self.auto_update,
                "updatePending": self.update_requested,
                "port": self.settings.port if self.settings else None,
                # what was LAUNCHED (not what server.ini now says): the tui flags a saved-but-not-
                # applied profile/mod change against these; generation bumps on every launch
                "profile": self.settings.profile.key if self.settings else None,
                "launchMods": list(self.settings.launch_mods) if self.settings else None,
                "generation": self.generation}

    def client(self, conn):
        f = conn.makefile("r", encoding="utf-8", errors="replace")
        try:
            req = json.loads(f.readline() or "{}")
            op = req.get("op")
            if op == "status":
                conn.sendall((json.dumps(self.status_obj()) + "\n").encode())
            elif op == "cmd":
                ok = self.send(req.get("text", ""))
                conn.sendall((json.dumps({"ok": ok}) + "\n").encode())
                time.sleep(float(req.get("wait", 0)))
            elif op == "attach":
                with self.lock:
                    n = int(req.get("backlog", 40))
                    backlog = list(self.ring)[-n:] if n > 0 else []   # [-0:] would be ALL of it
                    for line in backlog:
                        conn.sendall((line + "\n").encode("utf-8", "replace"))
                    self.watchers.add(conn)
                for line in f:
                    if line.strip():
                        self.send(line.strip())
            elif op in ("stop", "restart"):
                if op == "stop":
                    self.stop_requested = True
                else:
                    self.restart_requested = True
                conn.sendall((json.dumps({"ok": True}) + "\n").encode())
            elif op == "update":
                self.update_requested = "now" if req.get("now") else "empty"
                conn.sendall((json.dumps({"ok": True, "when": self.update_requested}) + "\n").encode())
            else:
                conn.sendall(b'{"ok":false,"error":"unknown op"}\n')
        except (OSError, ValueError):
            pass
        finally:
            with self.lock:
                self.watchers.discard(conn)
            try:
                conn.close()
            except OSError:
                pass

    # -- child lifecycle -----------------------------------------------------------------
    def launch(self):
        self.cfg = Config(self.inst)   # re-read: `restart` picks up server.ini edits
        self.load_policy()
        self.settings = resolve(self.inst, self.cfg)
        apply_settings(self.inst, self.settings)
        env = ensure_prefix(self.inst, self.cfg)
        rotate_log(os.path.join(self.inst.root, SERVER_LOG))   # the game is not running here
        args = [wine_bin(self.cfg)] + launch_args(self.inst, self.settings)
        if probe(self.settings.port, 0.5):
            self.note("WARNING: something already answers on UDP %d -- another server?" % self.settings.port)
        self.note("launching: %s (profile %s, port %d)" % (" ".join(args[1:]), self.settings.profile.key,
                                                           self.settings.port))
        child = subprocess.Popen(args, cwd=self.inst.root, env=env, stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        with self.lock:
            self.child = child
        self.generation += 1
        threading.Thread(target=self.pump, args=(child,), daemon=True).start()
        self.started_at = time.time()
        self.state = "running"
        self.ever_answered = False
        self.last_answer = time.time()
        self.status = None

    def safe_launch(self):
        """launch(), but a server.ini / install problem (die() -> SystemExit) stops the supervisor
        with exit code 3 -- the systemd unit's RestartPreventExitStatus -- instead of exiting 1
        and being restarted into the same error every 10 seconds."""
        try:
            self.launch()
            return True
        except SystemExit:
            self.state = "config-error"
            self.note("cannot start the server (see the message above) -- fix it, then start again")
            return False

    def terminate(self, why, grace=20):
        with self.lock:
            c = self.child
        if not c or c.poll() is not None:
            return
        self.note("stopping server (%s) ..." % why)
        self.send("quit();")
        try:
            c.wait(grace)
        except subprocess.TimeoutExpired:
            self.note("server did not quit in %ds; terminating" % grace)
            try:
                os.killpg(c.pid, signal.SIGTERM)
                c.wait(10)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    os.killpg(c.pid, signal.SIGKILL)
                except OSError:
                    pass
        ws = shutil.which("wineserver")
        if ws:   # private prefix: only our own processes live in it
            subprocess.run([ws, "-k"], env=wine_env(self.inst, self.cfg), timeout=30,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def players(self):
        return self.status["players"] if self.status else None

    def run_update(self):
        self.state = "updating"
        before = file_sha1(os.path.abspath(__file__))
        try:
            changed, ver = do_update(self.inst, self.cfg, quiet_current=True)
            self.remote_version = ver
            if changed:
                self.note("updated to v%d" % ver)
        except Exception as e:   # noqa: BLE001 -- an update failure must not take the server down
            self.note("update failed: %s (server restarts on the current version)" % e)
        self.update_requested = None
        if not self.stop_requested:
            reexec_if_updated(before, self.note)

    def main(self):
        self.inst.ensure_state()
        with open(os.path.join(self.inst.state, "supervisor.pid"), "w") as f:
            f.write("%d\n" % os.getpid())
        threading.Thread(target=self.serve, daemon=True).start()

        def on_signal(signum, _frame):
            self.stop_requested = True
        signal.signal(signal.SIGTERM, on_signal)
        signal.signal(signal.SIGINT, on_signal)

        next_check = time.time() + 60
        next_probe = 0
        next_policy = 0
        exit_code = 0 if self.safe_launch() else 3
        while exit_code == 0:
            time.sleep(0.5)
            now = time.time()
            if now >= next_policy:
                next_policy = now + 2
                if self.reload_policy_if_changed():
                    next_check = now    # just switched on: look for an update right away
            restart_delay, loop_limit = self.restart_delay, self.loop_limit
            hang_timeout, check_every = self.hang_timeout, self.check_every
            c = self.child
            if self.stop_requested:
                self.terminate("stop requested")
                break
            if c.poll() is not None:
                up = now - self.started_at
                self.note("server exited (code %s) after %ds" % (c.returncode, up))
                self.rapid = self.rapid + 1 if up < 60 else 0
                self.restarts += 1
                if self.rapid >= loop_limit:
                    self.note("CRASH LOOP: %d exits in a row within a minute of starting -- not restarting. "
                              "Read %s, fix, then start again." % (self.rapid, SERVER_LOG))
                    self.state = "crash-loop"
                    exit_code = 3
                    break
                if self.update_requested or (self.auto_update and self.remote_version and
                                             self.remote_version > read_int(os.path.join(self.inst.root,
                                                                                         VERSION_FILE))):
                    self.run_update()
                self.state = "restart-wait"
                end = time.time() + restart_delay
                while time.time() < end and not self.stop_requested:
                    time.sleep(0.25)
                if self.stop_requested:
                    break
                if not self.safe_launch():
                    exit_code = 3
                    break
                continue
            if self.restart_requested:
                self.restart_requested = False
                self.terminate("restart requested")
                self.rapid = -1    # a requested restart is not a crash
                continue
            if now >= next_probe and self.settings:
                next_probe = now + 10
                st = probe(self.settings.port)
                if st:
                    self.status = st
                    self.last_answer = now
                    self.ever_answered = True
                elif hang_timeout > 0 and self.ever_answered and now - self.last_answer > hang_timeout:
                    self.note("server has not answered status queries for %ds -- treating as hung"
                              % hang_timeout)
                    self.terminate("hang", grace=5)
                    continue
            if self.auto_update and now >= next_check:
                next_check = now + check_every
                try:
                    self.remote_version = fetch_manifest(manifest_url(self.inst, self.cfg))["version"]
                    game_new = self.remote_version > read_int(os.path.join(self.inst.root, VERSION_FILE))
                    behind = packs_behind(self.inst, self.cfg)
                    if (game_new or behind) and not self.update_requested:
                        what = (["game v%d" % self.remote_version] if game_new else []) + behind
                        self.note("update available (%s); applying when the server is empty" % ", ".join(what))
                        self.update_requested = "empty"
                except Exception as e:   # noqa: BLE001
                    self.note("update check failed: %s" % e)
            if self.update_requested == "now" or (self.update_requested == "empty" and self.players() == 0):
                self.terminate("update")
                self.run_update()
                self.rapid = -1
                # loop sees the exit and relaunches after restart_delay
        try:
            os.unlink(getattr(self, "sock_file", ""))
        except OSError:
            pass
        try:
            os.remove(os.path.join(self.inst.state, "supervisor.pid"))
        except OSError:
            pass
        self.note("supervisor exiting")
        return exit_code


