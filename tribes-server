def say(msg):
    print(msg, flush=True)


def die(msg, code=1):
    print("tribes-server: " + msg, file=sys.stderr, flush=True)
    sys.exit(code)


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%.1f %s" % (n, unit)) if unit != "B" else ("%d B" % n)
        n /= 1024.0


def ci_join(root, *parts):
    """Join path parts, matching each segment case-insensitively on disk (Linux file
    systems are case-sensitive; the game and its manifest are not)."""
    cur = root
    for part in parts:
        cand = os.path.join(cur, part)
        if os.path.exists(cand):
            cur = cand
            continue
        low = part.lower()
        try:
            hit = next((e for e in os.listdir(cur) if e.lower() == low), None)
        except OSError:
            hit = None
        cur = os.path.join(cur, hit if hit else part)
    return cur


def write_atomic(path, data, mode="w", newline=None):
    tmp = path + ".tmp"
    if "b" in mode:
        with open(tmp, mode) as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
    else:
        with open(tmp, mode, newline=newline, encoding="latin-1") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
    os.replace(tmp, path)


def read_int(path):
    try:
        with open(path, "r", encoding="latin-1") as f:
            return int((f.read().split() or ["0"])[0])
    except (OSError, ValueError):
        return 0


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def safe_rel(p):
    # updpath.h upd_safeRelPath: relative, forward slashes, no drive, no ".." segment
    if not p or p.startswith("/") or "\\" in p or ":" in p or "\0" in p:
        return False
    return all(seg not in ("", ".", "..") for seg in p.split("/"))


# ---------------------------------------------------------------------------------------
# install layout
# ---------------------------------------------------------------------------------------
class Install:
    def __init__(self, root):
        self.root = os.path.abspath(root)
        self.state = os.path.join(self.root, STATE_DIR)

    def path(self, rel):
        return os.path.join(self.root, *rel.split("/"))

    def ensure_state(self):
        os.makedirs(self.state, exist_ok=True)
        try:
            os.chmod(self.state, 0o700)
        except OSError:
            pass

    def exe(self):
        for n in EXE_NAMES:
            p = os.path.join(self.root, n)
            if os.path.isfile(p):
                return n
        return None

    @property
    def config_path(self):
        return os.path.join(self.root, CONFIG_NAME)

    def channel(self):
        # updater.cpp readChannel: one [A-Za-z0-9_-] token; main/release = default
        try:
            with open(os.path.join(self.root, "channel.txt"), "r", encoding="latin-1") as f:
                tok = re.sub(r"[^A-Za-z0-9_-].*", "", f.read().strip(), flags=re.S)[:39]
        except OSError:
            return ""
        return "" if tok.lower() in ("main", "release") else tok

    def is_dev_tree(self):
        return os.path.exists(os.path.join(self.root, "devtree.txt"))


def find_root(arg_dir):
    if arg_dir:
        return Install(arg_dir)
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (here, os.getcwd()):
        if any(os.path.isfile(os.path.join(cand, n)) for n in EXE_NAMES):
            return Install(cand)
    return Install(os.getcwd())


