def ini_help():
    """{(section, key): the comment lines above that key in DEFAULT_INI}."""
    out, buf, sec = {}, [], None
    for line in DEFAULT_INI.splitlines():
        s = line.strip()
        m = re.match(r"\[(.+)\]$", s)
        if m:
            sec, buf = m.group(1), []
        elif s.startswith("#"):
            buf.append(s.lstrip("#").strip())
        elif "=" in s and sec:
            out[(sec, s.split("=", 1)[0].strip())] = " ".join(buf)
            buf = []
        else:
            buf = []
    for k, v in TUI_HELP_EXTRA.items():
        out[k] = v
    return out


def _quiet(fn, *a, **kw):
    """Call a CLI helper that may say() / die() without it printing onto the curses screen.
    Returns (result or None if it died, the text it printed)."""
    import contextlib
    import io
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            r = fn(*a, **kw)
        return r, buf.getvalue().strip()
    except SystemExit:
        return None, buf.getvalue().strip()


def _script_text(text):
    """Operator text made safe inside a TorqueScript string literal."""
    return text.replace("\\", "/").replace('"', "'").replace("\r", " ").replace("\n", " ")


def _edit_line(buf, cur, k):
    """Shared single-line editing. Returns (buf, cur, handled)."""
    if k in (curses.KEY_LEFT,):
        return buf, max(0, cur - 1), True
    if k in (curses.KEY_RIGHT,):
        return buf, min(len(buf), cur + 1), True
    if k in (curses.KEY_HOME, "\x01"):
        return buf, 0, True
    if k in (curses.KEY_END, "\x05"):
        return buf, len(buf), True
    if k in (curses.KEY_BACKSPACE, "\x7f", "\x08"):
        return (buf[:cur - 1] + buf[cur:], cur - 1, True) if cur > 0 else (buf, cur, True)
    if k == curses.KEY_DC:
        return buf[:cur] + buf[cur + 1:], cur, True
    if k == "\x15":   # Ctrl-U: clear
        return "", 0, True
    if k == "\x0b":   # Ctrl-K: kill to end
        return buf[:cur], cur, True
    if k == "\x17":   # Ctrl-W: delete word
        i = cur
        while i > 0 and buf[i - 1] == " ":
            i -= 1
        while i > 0 and buf[i - 1] != " ":
            i -= 1
        return buf[:i] + buf[cur:], i, True
    if isinstance(k, str) and len(k) == 1 and k.isprintable():
        return buf[:cur] + k + buf[cur:], cur + 1, True
    return buf, cur, False


class Tui:
    def __init__(self, inst):
        self.inst = inst
        self.lock = threading.Lock()
        self.lines = deque(maxlen=5000)
        self.st = None                   # supervisor status dict; None = not running
        self.conn = None                 # attach socket
        self.screen = 0
        self.scroll = 0                  # console: lines back from the live tail
        self.inp, self.cur = "", 0
        self.hist, self.hpos = self.load_history(), None
        self.msg, self.msg_at = "", 0.0
        self.confirm = None              # (question, fn)
        self.modal = None                # {title, items:[(label, value)], fn, sel, top, filter}
        self.edit = None                 # {label, buf, cur, fn, secret}
        self.job, self.job_name = None, ""
        self.players, self.pl_new, self.players_at = [], None, 0.0
        self.pl_asked = 0.0              # a reply is only ours while a request is pending (the
                                         # attach backlog can replay someone else's old one)
        self.sel = {n: 0 for n in TUI_SCREENS}
        self.top = {n: 0 for n in TUI_SCREENS}
        self.map_filter = ""
        self.maps = None
        self.store, self.store_err, self.store_busy = None, "", False
        self.help = ini_help()
        self.summary = {}
        self.ascii = True
        self.quit = False
        self.refresh_config()

    # -- data ----------------------------------------------------------------------------
    def history_path(self):
        return os.path.join(self.inst.state, "tui_history")

    def load_history(self):
        try:
            with open(self.history_path(), "r", encoding="utf-8") as f:
                return [l.rstrip("\n") for l in f if l.strip()][-500:]
        except OSError:
            return []

    def save_history(self):
        try:
            self.inst.ensure_state()
            fd = os.open(self.history_path(), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # may hold passwords
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write("\n".join(self.hist[-500:]) + "\n")
        except OSError:
            pass

    def refresh_config(self):
        """Re-read server.ini: what the header shows while stopped, and the map list."""
        self.cfg = Config(self.inst)
        s, out = _quiet(resolve, self.inst, self.cfg)
        self.settings_err = "" if s else (out or "server.ini does not resolve")
        self.summary = {"name": s.name, "profile": s.profile.key, "port": s.port, "mission": s.mission,
                        "launchMods": list(s.launch_mods)} if s else {}
        self.maps = None
        if s:
            rows, _ = _quiet(mission_rows, self.inst, s)
            self.maps = rows or []

    def add(self, line):
        with self.lock:
            self.lines.append(line)
            if self.scroll:
                self.scroll += 1   # keep a scrolled-back view still

    def note(self, msg):
        self.msg, self.msg_at = msg, time.time()

    def on_line(self, line):
        if line.startswith(TUI_TAG):
            body = line[len(TUI_TAG):]
            if body == "BEGIN":
                if time.time() - self.pl_asked < 15:
                    self.pl_new = []
            elif body == "END" and self.pl_new is not None:
                self.players, self.pl_new, self.players_at = self.pl_new, None, time.time()
                self.pl_asked = 0.0
            elif body.startswith("P|") and self.pl_new is not None:
                parts = body.split("|", 4)
                if len(parts) == 5:
                    self.pl_new.append({"id": parts[1], "team": parts[2], "addr": parts[3], "name": parts[4]})
            return
        if TUI_TAG in line:   # the console's echo of our own player-list command
            return
        self.add(line)

    def show_log_tail(self):
        p = ci_join(self.inst.root, SERVER_LOG)
        try:
            with open(p, "rb") as f:
                f.seek(0, 2)
                f.seek(max(0, f.tell() - 32 * 1024))
                tail = f.read().decode("latin-1").splitlines()[-200:]
        except OSError:
            tail = []
        if tail:
            self.add("[tui] -- the server is not running; last lines of %s --" % SERVER_LOG)
            for line in tail:
                self.on_line(line)
        self.add("[tui] F7 starts the server.")

    # -- background threads ------------------------------------------------------------------
    def poll_status(self):
        while not self.quit:
            st = running(self.inst)
            with self.lock:
                self.st = st
            time.sleep(1.5)

    def pump_console(self):
        first = True
        while not self.quit:
            r = ctl_request(self.inst, "attach", backlog=300)
            if not r:
                if first:
                    self.show_log_tail()
                first = False
                time.sleep(2)
                continue
            first = False
            s, f = r
            with self.lock:
                self.conn = s
            self.add("[tui] -- attached to the server console --")
            try:
                for line in f:
                    self.on_line(line.rstrip("\r\n"))
            except (OSError, ValueError):
                pass
            with self.lock:
                self.conn = None
            try:
                s.close()
            except OSError:
                pass
            if not self.quit:
                self.add("[tui] -- supervisor stopped; the server is not running (F7 starts it) --")
            time.sleep(1)

    def send(self, text, quiet=False):
        with self.lock:
            s = self.conn
        if not s:
            if not quiet:
                self.note("The server is not running (F7 starts it).")
            return False
        try:
            s.sendall((text.replace("\n", " ") + "\n").encode("utf-8", "replace"))
            return True
        except OSError:
            self.note("Lost the console connection; reconnecting.")
            return False

    def ctl(self, op, **kw):
        r = ctl_request(self.inst, op, **kw)
        if not r:
            self.note("The server is not running.")
            return False
        try:
            r[1].readline()
        except OSError:
            pass
        r[0].close()
        return True

    def run_job(self, name, args, then=None):
        if self.job and self.job.poll() is None:
            self.note("Busy: '%s' is still running." % self.job_name)
            return
        cmd = [sys.executable, os.path.abspath(__file__), "--dir", self.inst.root] + args
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 env=dict(os.environ, PYTHONUNBUFFERED="1"), cwd=self.inst.root)
        except OSError as e:
            self.note("Could not run %s: %s" % (name, e))
            return
        self.job, self.job_name = p, name
        self.add("[tui] %s: tribes-server %s" % (name, " ".join(args)))
        self.screen = 0
        self.scroll = 0

        def pump():
            for raw in iter(p.stdout.readline, b""):
                self.add("[%s] %s" % (name, raw.decode("utf-8", "replace").rstrip()))
            rc = p.wait()
            self.add("[tui] %s %s" % (name, "finished" if rc == 0 else "FAILED (exit code %d)" % rc))
            self.note("%s %s" % (name, "finished." if rc == 0 else "failed -- see the log above."))
            if then:
                then(rc)
        threading.Thread(target=pump, daemon=True).start()

    def load_store(self):
        if self.store_busy:
            return
        self.store_busy, self.store_err = True, ""

        def work():
            try:
                cfg = Config(self.inst)
                url = store_url(cfg)
                if not url:
                    raise ValueError("the store is disabled ([update] store_url = 0)")
                store = fetch_store(url)
                receipts, _ = _quiet(load_receipts, self.inst)
                full = cfg.get("update", "mode").lower() == "full"
                rules = tuple(exclude_rules(cfg)) if full else tuple(CLIENT_ONLY) + tuple(exclude_rules(cfg))
                rows = []
                for pid, p in sorted(store["packs"].items(), key=lambda kv: (kv[1]["category"], kv[0])):
                    size = sum(f["size"] for f in p["files"] if not matches_rules(f["path"], rules))
                    r = (receipts or {}).get(pid)
                    rows.append({"id": pid, "pack": p, "size": size,
                                 "have": int(r.get("version") or 0) if r else 0})
                self.store = rows
            except Exception as e:   # noqa: BLE001
                self.store_err = "Could not load the Asset Store: %s" % e
            self.store_busy = False
        threading.Thread(target=work, daemon=True).start()

    # -- actions -------------------------------------------------------------------------
    def players_online(self):
        q = (self.st or {}).get("query")
        return q["players"] if q else 0

    def ask(self, question, fn):
        self.confirm = (question, fn)

    def act_startstop(self):
        if not self.st:
            self.run_job("start", ["start"])
            return
        n = self.players_online()
        self.ask("Stop the server%s?" % (" (%d player%s online)" % (n, "s" if n != 1 else "") if n else ""),
                 lambda: self.ctl("stop") and self.note("Stopping the server..."))

    def act_restart(self):
        if not self.st:
            self.note("The server is not running (F7 starts it).")
            return
        n = self.players_online()
        self.ask("Restart the server now%s? It re-reads server.ini." %
                 (" (%d player%s online)" % (n, "s" if n != 1 else "") if n else ""),
                 lambda: self.ctl("restart") and self.note("Restarting..."))

    def act_update(self):
        if not self.st:
            self.run_job("update", ["update"])
            return

        def pick(v):
            if v == "empty":
                self.ctl("update") and self.note("Update queued: applies as soon as the server is empty.")
            elif v == "now":
                self.ctl("update", now=True) and self.note("Updating now...")
        self.open_modal("Update the running server", [
            ("When the server is empty (players are never dropped)", "empty"),
            ("Now -- drops %d player(s)" % self.players_online(), "now"),
            ("Cancel", None)], pick)

    def refresh_players(self):
        self.pl_asked = time.time()
        self.send(TUI_PLAYERS_CMD, quiet=True)

    def set_value(self, sec, key, value):
        ini_set(self.inst, sec, key, value)
        self.refresh_config()
        if sec == "tui":
            self.init_colors()
            self.scr.clear()     # repaint every cell in the new colours
            self.note("Theme: %s." % self.theme_name())
        elif self.settings_err:
            self.note("Saved, but: %s" % self.settings_err.splitlines()[-1])
        elif sec in ("update", "supervisor"):
            # Supervisor.reload_policy_if_changed picks these up within ~2 s; no restart.
            self.note("Saved. %s" % ("Applied to the running server." if self.st else "Used at the next start."))
        else:
            self.note("Saved. %s" % ("F8 restarts the server to use it." if self.st else "Used at the next start."))

    def set_profile(self, word):
        """Picking a DIFFERENT mod means that mod's own launch chain: the starting map, the map
        rotation and the `mods` override all belong to the old mod and are cleared with it (a
        leftover mods=Duel kept launching Duel after "switching" to base -- resolve() gives the
        override priority). Re-picking the CURRENT mod keeps all three."""
        reset = PROFILE_OWNED_KEYS if word.lower() != self.cfg.get("server", "profile").lower() else ()
        cleared = [k for k in reset if self.cfg.get("server", k).strip()]
        for k in reset:
            ini_set(self.inst, "server", k, "")
        self.set_value("server", "profile", word)
        if cleared and not self.settings_err:
            self.note("Saved; cleared the old mod's %s. %s" % (", ".join(PROFILE_KEY_LABELS[k] for k in cleared),
                                                             "F8 restarts the server to use it." if self.st
                                                             else "Used at the next start."))

    def open_modal(self, title, items, fn, filterable=False):
        self.modal = {"title": title, "items": items, "fn": fn, "sel": 0, "top": 0,
                      "filter": "" if filterable else None}

    def open_edit(self, label, value, fn, secret=False):
        self.edit = {"label": label, "buf": value, "cur": len(value), "fn": fn, "secret": secret}

    def edit_field(self, f):
        sec, key, label, kind = f
        cur = self.cfg.get(sec, key)
        if kind == "bool":
            self.set_value(sec, key, "false" if cur.lower() in BOOL_TRUE else "true")
        elif kind.startswith("choice:"):
            opts = kind[7:].split(",")
            self.open_modal(label, [(o or "(blank: default)", o) for o in opts],
                            lambda v: v is not None and self.set_value(sec, key, v))
        elif kind == "theme":
            names = list(TUI_THEMES)
            items = [("%-7s %s" % (n, TUI_THEMES[n][0]), n) for n in names]
            self.open_modal(label, items, lambda v: v is not None and self.set_value(sec, key, v))
            if cur in names:
                self.modal["sel"] = names.index(cur)
        elif kind == "profile":
            profs, _ = _quiet(load_profiles, self.inst)
            self.open_modal("Mod (profile)", [("%-14s %s" % (p.key, p.label), p.key) for p in profs or []],
                            lambda v: v is not None and self.set_profile(v), filterable=True)
        elif kind == "mission":
            items = [("(profile default)", "")] + [("%-30s %s" % (n, t), n) for t, n, d in (self.maps or [])]
            self.open_modal("Starting map", items, lambda v: v is not None and self.set_value(sec, key, v),
                            filterable=True)
        else:
            def done(v):
                v = v.strip()
                if '"' in v:
                    self.note("Double quotes are not allowed.")
                elif kind in ("int", "int?") and not (v.isdigit() or (kind == "int?" and v == "")):
                    self.note("%s must be a number%s." % (label, " or blank" if kind == "int?" else ""))
                else:
                    self.set_value(sec, key, v)
            self.open_edit(label, cur, done, secret=(kind == "pw"))

    def map_actions(self, name):
        acts = []
        if self.st:
            acts.append(("Switch to %s now" % name, "now"))
        acts += [("Make it the starting map", "start"), ("Add it to the rotation", "rot"), ("Cancel", None)]

        def pick(v):
            if v == "now":
                def go():
                    self.send('Server::loadMission("%s");' % _script_text(name))
                    self.note("Switching to %s..." % name)
                n = self.players_online()
                if n:
                    self.ask("Switch to %s now? %d player(s) online." % (name, n), go)
                else:
                    go()
            elif v == "start":
                self.set_value("server", "mission", name)
            elif v == "rot":
                rot = [m.strip() for m in self.cfg.get("server", "rotation").split(",") if m.strip()]
                rot.append(name)
                self.set_value("server", "rotation", ", ".join(rot))
        self.open_modal(name, acts, pick)

    def player_actions(self, p):
        def pick(v):
            if v == "kick":
                self.ask("Kick %s?" % p["name"], lambda: self.send(
                    'messageAll(0, "%s was kicked by the server admin."); Net::kick(%s, "You were kicked by the '
                    'server admin.");' % (_script_text(p["name"]), p["id"])) and self.later_refresh())
            elif v == "ban":
                self.ask("Ban %s for 30 minutes?" % p["name"], lambda: self.send(
                    'BanList::add(Client::getTransportAddress(%s), 1800); messageAll(0, "%s was banned by the '
                    'server admin."); Net::kick(%s, "You were banned by the server admin.");'
                    % (p["id"], _script_text(p["name"]), p["id"])) and self.later_refresh())
        if not p["id"].lstrip("-").isdigit():
            return
        self.open_modal(p["name"], [("Kick", "kick"), ("Ban for 30 minutes", "ban"), ("Cancel", None)], pick)

    def later_refresh(self):
        threading.Timer(1.5, self.refresh_players).start()
        return True

    def message_all(self):
        self.open_edit("Message to everyone", "", lambda v: v.strip() and self.send(
            'messageAll(0, "%s");' % _script_text(v.strip())))

    def store_action(self, row, remove=False):
        p, pid = row["pack"], row["id"]
        if remove:
            if not row["have"]:
                self.note("%s is not installed." % pid)
            elif self.st:
                self.note("Stop the server (F7) before removing a pack.")
            else:
                self.ask("Remove %s (%s)?" % (p["title"], pid), lambda: self.run_job(
                    "store", ["store", "remove", pid], then=lambda rc: self.after_store()))
            return
        if p["state"].lower() != "live":
            self.note("%s is not available yet (%s)." % (pid, p["state"]))
        elif row["have"] >= p["version"]:
            self.note("%s is installed and up to date." % pid)
        elif row["have"] and self.st:
            self.note("F9 updates %s along with the game (waits for an empty server)." % pid)
        else:
            def done(rc):
                self.after_store()
                if rc == 0 and p["category"] == "mods" and p["launchMods"]:
                    word = p["launchMods"][-1].lower()
                    self.ask("Host %s now? (sets the profile to %s)" % (p["title"], word),
                             lambda: self.set_profile(word))
            self.ask("%s %s (%s download)?" % ("Update" if row["have"] else "Install", p["title"], human(row["size"])),
                     lambda: self.run_job("store", ["store", "install", pid], then=done))

    def after_store(self):
        self.store = None
        self.load_store()
        self.refresh_config()

    # -- input -----------------------------------------------------------------------------
    def key(self, k):
        if self.confirm:
            q, fn = self.confirm
            self.confirm = None
            if k in ("y", "Y"):
                fn()
            else:
                self.note("Cancelled.")
            return
        if self.edit:
            e = self.edit
            if k in ("\n", "\r", curses.KEY_ENTER):
                self.edit = None
                e["fn"](e["buf"])
            elif k == "\x1b":
                self.edit = None
            else:
                e["buf"], e["cur"], _ = _edit_line(e["buf"], e["cur"], k)
            return
        if self.modal:
            m = self.modal
            items = self.modal_items()
            if k in ("\n", "\r", curses.KEY_ENTER):
                self.modal = None
                if items:
                    m["fn"](items[min(m["sel"], len(items) - 1)][1])
            elif k == "\x1b":
                self.modal = None
            elif k == curses.KEY_UP:
                m["sel"] = max(0, m["sel"] - 1)
            elif k == curses.KEY_DOWN:
                m["sel"] = min(len(items) - 1, m["sel"] + 1)
            elif k == curses.KEY_PPAGE:
                m["sel"] = max(0, m["sel"] - 10)
            elif k == curses.KEY_NPAGE:
                m["sel"] = min(len(items) - 1, m["sel"] + 10)
            elif m["filter"] is not None:
                m["filter"], _, _ = _edit_line(m["filter"], len(m["filter"]), k)
                m["sel"] = m["top"] = 0
            return
        fkeys = {curses.KEY_F1: 5, curses.KEY_F2: 0, curses.KEY_F3: 1, curses.KEY_F4: 2, curses.KEY_F5: 3,
                 curses.KEY_F6: 4}
        if k in fkeys:
            self.go(fkeys[k])
        elif k == "\t":
            self.go((self.screen + 1) % len(TUI_SCREENS))
        elif k == curses.KEY_BTAB:
            self.go((self.screen - 1) % len(TUI_SCREENS))
        elif k == "\x0c":   # Ctrl-L: repaint everything (after another program scribbled on the terminal)
            self.scr.clear()
        elif k == curses.KEY_F7:
            self.act_startstop()
        elif k == curses.KEY_F8:
            self.act_restart()
        elif k == curses.KEY_F9:
            self.act_update()
        elif k in (curses.KEY_F10, "\x11", "\x03"):   # F10, Ctrl-Q, Ctrl-C
            if self.job and self.job.poll() is None:
                self.ask("'%s' is still running and quitting stops it. Quit anyway?" % self.job_name, self.stop)
            else:
                self.stop()
        else:
            getattr(self, "key_" + TUI_SCREENS[self.screen].lower())(k)

    def stop(self):
        self.quit = True

    def go(self, n):
        self.screen = n
        name = TUI_SCREENS[n]
        if name == "Players" and time.time() - self.players_at > 5:
            self.refresh_players()
        elif name == "Store" and self.store is None:
            self.load_store()

    def body_h(self):
        return max(1, self.H - 6)

    def key_console(self, k):
        if k in ("\n", "\r", curses.KEY_ENTER):
            text = self.inp.strip()
            if text:
                if self.send(text):
                    if not self.hist or self.hist[-1] != text:
                        self.hist.append(text)
                    self.inp, self.cur, self.hpos, self.scroll = "", 0, None, 0
            return
        if k == curses.KEY_UP and self.hist:
            self.hpos = len(self.hist) - 1 if self.hpos is None else max(0, self.hpos - 1)
            self.inp = self.hist[self.hpos]
            self.cur = len(self.inp)
        elif k == curses.KEY_DOWN and self.hpos is not None:
            self.hpos += 1
            if self.hpos >= len(self.hist):
                self.hpos, self.inp = None, ""
            else:
                self.inp = self.hist[self.hpos]
            self.cur = len(self.inp)
        elif k == curses.KEY_PPAGE:
            with self.lock:
                self.scroll = min(max(0, len(self.lines) - 1), self.scroll + self.body_h() - 1)
        elif k == curses.KEY_NPAGE:
            self.scroll = max(0, self.scroll - (self.body_h() - 1))
        elif k == curses.KEY_END and not self.inp:
            self.scroll = 0
        elif k == "\x1b":
            self.scroll = 0
        else:
            self.inp, self.cur, _ = _edit_line(self.inp, self.cur, k)

    def list_move(self, name, k, n):
        s = self.sel[name]
        if k == curses.KEY_UP:
            s -= 1
        elif k == curses.KEY_DOWN:
            s += 1
        elif k == curses.KEY_PPAGE:
            s -= self.body_h() - 2
        elif k == curses.KEY_NPAGE:
            s += self.body_h() - 2
        elif k == curses.KEY_HOME:
            s = 0
        elif k == curses.KEY_END:
            s = n - 1
        else:
            return False
        self.sel[name] = max(0, min(n - 1, s))
        return True

    def key_players(self, k):
        if self.list_move("Players", k, len(self.players)):
            return
        if k in ("\n", "\r") and self.players:
            self.player_actions(self.players[min(self.sel["Players"], len(self.players) - 1)])
        elif k in ("r", "R"):
            self.refresh_players()
        elif k in ("m", "M"):
            self.message_all()

    def filtered_maps(self):
        f = self.map_filter.lower()

        def initials(t):   # "ctf" finds "Capture the Flag", "dnd" / "dad" "Defend and Destroy"
            words = re.findall(r"[a-z0-9]+", t.lower())
            return "".join(w[0] for w in words), "".join(w[0] for w in words if w not in ("and", "the", "&"))
        return [r for r in (self.maps or []) if not f or f in r[1].lower() or f in r[0].lower()
                or f in initials(r[0])]

    def full_mission(self, q):
        """The status query carries at most 16 characters of the map name (CanyonCrusadeDel);
        give back the whole name when exactly one map of this profile starts with it."""
        name = (q or {}).get("mission") or ""
        if not name:
            return ""
        hits = [r[1] for r in (self.maps or []) if r[1].lower().startswith(name.lower())]
        exact = [h for h in hits if h.lower() == name.lower()]
        if exact:
            return exact[0]
        cfg = self.cfg.get("server", "mission") or self.summary.get("mission", "")
        if cfg and cfg in hits:
            return cfg
        return hits[0] if len(hits) == 1 else name

    def key_maps(self, k):
        rows = self.filtered_maps()
        if self.list_move("Maps", k, len(rows)):
            return
        if k in ("\n", "\r"):
            if rows:
                self.map_actions(rows[min(self.sel["Maps"], len(rows) - 1)][1])
        elif k == "\x1b":
            self.map_filter = ""
        else:
            self.map_filter, _, _ = _edit_line(self.map_filter, len(self.map_filter), k)
            self.sel["Maps"] = self.top["Maps"] = 0

    def key_settings(self, k):
        if self.list_move("Settings", k, len(TUI_FIELDS)):
            return
        if k in ("\n", "\r", " "):
            self.edit_field(TUI_FIELDS[self.sel["Settings"]])

    def key_store(self, k):
        rows = self.store or []
        if self.list_move("Store", k, len(rows)):
            return
        if k in ("r", "R"):
            self.store = None
            self.load_store()
        elif rows and k in ("\n", "\r", "i", "I"):
            self.store_action(rows[min(self.sel["Store"], len(rows) - 1)])
        elif rows and k in ("x", "X"):
            self.store_action(rows[min(self.sel["Store"], len(rows) - 1)], remove=True)

    def key_help(self, k):
        self.list_move("Help", k, len(self.help_lines()))

    # -- drawing ---------------------------------------------------------------------------
    def put(self, y, x, text, attr=0):
        if y < 0 or y >= self.H or x >= self.W:
            return
        text = "".join(c if c.isprintable() else " " for c in text)
        if self.ascii:
            text = text.encode("ascii", "replace").decode("ascii")
        n = self.W - x - (1 if y == self.H - 1 else 0)
        if n <= 0:
            return
        try:
            self.scr.addnstr(y, x, text, n, attr)
        except Exception:   # noqa: BLE001 -- curses.error at the edges, encoding on odd locales
            pass

    def fill(self, y, attr):
        self.put(y, 0, " " * self.W, attr)

    def color(self, name):
        return self.colors.get(name, 0) if self.colors else {"head": curses.A_REVERSE, "sel": curses.A_REVERSE,
                                                             "bad": curses.A_BOLD, "warn": curses.A_BOLD,
                                                             "key": curses.A_REVERSE, "box": curses.A_REVERSE,
                                                             "title": curses.A_BOLD}.get(name, 0)

    def line_attr(self, line):
        low = line.lower()
        if line.startswith("[tui]") or line.startswith("[tribes-server]"):
            return self.color("info")
        if "error" in low or "unknown command" in low or "crash" in low or "failed" in low:
            return self.color("bad")
        if "warning" in low:
            return self.color("warn")
        if line.startswith("[start]") or line.startswith("[update]") or line.startswith("[store]"):
            return self.color("ok")
        return 0

    def draw_header(self):
        st = self.st
        self.fill(0, self.color("head"))
        self.fill(1, self.color("head"))
        if st:
            q = st.get("query") or {}
            state = st["state"]
            left = " %s " % (q.get("name") or self.summary.get("name", ""))
            up = st.get("uptime") or 0
            self.put(0, 0, left, self.color("head"))
            tag = " %s " % state.upper()
            good = state == "running" and q
            self.put(0, len(left) + 1, tag, self.color("okhead" if good else "badhead"
                                                       if state in ("crash-loop", "config-error") else "warnhead"))
            self.put(0, len(left) + len(tag) + 2, "up %dh%02dm  restarts %d" % (up // 3600, up // 60 % 60,
                                                                                  st.get("restarts", 0)),
                     self.color("head"))
            inst, latest = st.get("installed") or 0, st.get("latest") or 0
            parts = []
            if q:
                parts.append("%s (%s)" % (self.full_mission(q), q.get("missionType")))
                parts.append("%d/%d players" % (q.get("players", 0), q.get("max", 0)))
            else:
                parts.append("starting (not answering yet)")
            parts.append("port %s" % st.get("port"))
            if st.get("profile"):     # older supervisors do not report what they launched
                parts.append("mod %s" % st["profile"])
                sm = self.summary
                if sm and (sm.get("profile") != st["profile"] or
                           [w.lower() for w in sm.get("launchMods") or []] !=
                           [w.lower() for w in st.get("launchMods") or []]):
                    parts.append("SAVED %s (%s) -- F8 to apply" % (sm.get("profile"),
                                                                  " ".join(sm.get("launchMods") or []) or "base"))
            parts.append("v%d%s" % (inst, (" (v%d available)" % latest) if latest > inst else ""))
            parts.append("auto-update %s" % ("on" if st.get("autoUpdate") else "off"))
            if st.get("updatePending"):
                parts.append("UPDATE PENDING (%s)" % st["updatePending"])
            self.put(1, 0, " " + "  |  ".join(parts), self.color("head"))
        else:
            sm = self.summary
            left = " %s " % (sm.get("name") or "tribes-server")
            self.put(0, 0, left, self.color("head"))
            self.put(0, len(left) + 1, " STOPPED ", self.color("badhead"))
            v = read_int(os.path.join(self.inst.root, VERSION_FILE))
            info = ("profile %s  |  %s  |  port %s  |  v%d installed  |  F7 starts it" % (
                sm.get("profile"), sm.get("mission") or "(no map)", sm.get("port"), v)) if sm else \
                "server.ini has a problem -- see Settings"
            self.put(1, 0, " " + info, self.color("head"))
        if self.job and self.job.poll() is None:
            t = " %s running... " % self.job_name
            self.put(0, max(0, self.W - len(t) - 1), t, self.color("warnhead"))
        x = 0
        for i, n in enumerate(TUI_SCREENS):
            label = " F%d %s " % ((i + 2) if i < 5 else 1, n)
            self.put(2, x, label, self.color("sel") if i == self.screen else 0)
            x += len(label) + 1

    def wrap(self, text, width):
        if not text:
            return [""]
        return [text[i:i + width] for i in range(0, len(text), width)]

    def draw_console(self, y0, h):
        with self.lock:
            lines = list(self.lines)
            scroll = min(self.scroll, max(0, len(lines) - 1))
        end = len(lines) - scroll
        rows = []
        i = end - 1
        while i >= 0 and len(rows) < h:
            rows = [(c, self.line_attr(lines[i])) for c in self.wrap(lines[i], self.W)] + rows
            i -= 1
        rows = rows[-h:]
        for n, (text, attr) in enumerate(rows):
            self.put(y0 + n, 0, text, attr)
        if scroll:
            t = " scrolled back %d lines -- PgDn / End / Esc returns to live " % scroll
            self.put(y0, max(0, self.W - len(t)), t, self.color("sel"))

    def draw_list(self, name, y0, h, header, rows, attrs=None):
        """rows: list of strings; keeps the selection visible."""
        self.put(y0, 0, header, self.color("dim") | curses.A_UNDERLINE)
        h -= 1
        sel = min(self.sel[name], max(0, len(rows) - 1))
        top = self.top[name]
        if sel < top:
            top = sel
        elif sel >= top + h:
            top = sel - h + 1
        self.top[name] = top
        for n, r in enumerate(rows[top:top + h]):
            idx = top + n
            a = self.color("sel") if idx == sel else (attrs[idx] if attrs else 0)
            self.put(y0 + 1 + n, 0, r.ljust(self.W), a)
        if len(rows) > h:
            self.put(y0, max(0, self.W - 12), " %d/%d " % (sel + 1, len(rows)), self.color("dim"))

    def draw_players(self, y0, h):
        if not self.st:
            self.put(y0 + 1, 2, "The server is not running.")
            return
        rows = []
        for p in self.players:
            team = {"-1": "observer"}.get(p["team"], "team " + p["team"])
            rows.append("%-8s %-10s %-24s %s" % (p["id"], team, p["addr"] or "-", p["name"]))
        if not rows:
            self.put(y0 + 1, 2, "Nobody is on (bots are not listed)." if self.players_at else "Asking the server...")
            self.put(y0, 0, "%-8s %-10s %-24s %s" % ("ID", "TEAM", "ADDRESS", "NAME"))
            return
        self.draw_list("Players", y0, h, "%-8s %-10s %-24s %s" % ("ID", "TEAM", "ADDRESS", "NAME"), rows)

    def draw_maps(self, y0, h):
        rows = self.filtered_maps()
        cur = self.full_mission((self.st or {}).get("query")).lower()
        start = self.cfg.get("server", "mission").lower() or self.summary.get("mission", "").lower()
        self.put(y0, 0, "Filter: %s_" % self.map_filter if self.map_filter else
                 "Type to filter by name or game type.  %d maps for profile %s." % (
                     len(self.maps or []), self.summary.get("profile", "?")), self.color("info"))
        text = []
        for t, n, d in rows:
            mark = "*" if n.lower() == cur else ("s" if n.lower() == start else " ")
            text.append("%s %-32s %-26s %s" % (mark, n, t, d))
        if not text:
            self.put(y0 + 2, 2, "No maps match." if self.maps else (self.settings_err or "No maps found."))
            return
        self.draw_list("Maps", y0 + 1, h - 1, "  %-32s %-26s %s" % ("MAP", "TYPE", "FOLDER"), text)

    def draw_settings(self, y0, h):
        rows = []
        for sec, key, label, kind in TUI_FIELDS:
            v = self.cfg.get(sec, key)
            if kind == "pw":
                v = "(set)" if v else "(none)"
            elif v == "":
                v = "(default)"
            rows.append("%-26s %s" % (label, v))
        self.draw_list("Settings", y0, h - 4, "%-26s %s" % ("SETTING", "VALUE   (Enter changes it)"), rows)
        f = TUI_FIELDS[self.sel["Settings"]]
        txt = "%s.%s -- %s" % (f[0], f[1], self.help.get((f[0], f[1]), ""))
        for n, part in enumerate(textwrap.wrap(txt, self.W - 2)[:3]):
            self.put(y0 + h - 3 + n, 1, part, self.color("info"))
        if self.settings_err:
            self.put(y0 + h - 4, 1, "server.ini: " + self.settings_err.splitlines()[-1], self.color("bad"))

    def draw_store(self, y0, h):
        if self.store_busy and self.store is None:
            self.put(y0 + 1, 2, "Loading the Asset Store catalog...")
            return
        if self.store_err:
            self.put(y0 + 1, 2, self.store_err, self.color("bad"))
            return
        rows, attrs = [], []
        for r in self.store or []:
            p = r["pack"]
            have = ("v%d" % r["have"]) if r["have"] else "-"
            if r["have"] and r["have"] < p["version"]:
                have += " (v%d out)" % p["version"]
            state = "" if p["state"].lower() == "live" else " [%s]" % p["state"]
            rows.append("%-16s %-8s %-14s %9s  %s%s" % (r["id"], p["category"], have, human(r["size"]),
                                                        p["title"], state))
            attrs.append(self.color("ok") if r["have"] else (self.color("dim") if p["category"] != "mods" else 0))
        self.draw_list("Store", y0, h - 2, "%-16s %-8s %-14s %9s  %s" % ("ID", "TYPE", "INSTALLED", "DOWNLOAD",
                                                                         "TITLE"), rows, attrs)
        self.put(y0 + h - 1, 1, "Only 'mods' packs matter on a server; the rest are client-side looks.",
                 self.color("dim"))

    def help_lines(self):
        return ("Keys",
                "  F2-F6 / Tab    switch screens        F1   this help",
                "  F7  start / stop the server          F8   restart (re-reads server.ini)",
                "  F9  update (waits for an empty server, or now)",
                "  F10 / Ctrl-Q   quit this screen -- the server keeps running        Ctrl-L  repaint",
                "",
                "Console:   type a command + Enter; Up/Down = history; PgUp/PgDn scroll; End/Esc = live",
                "           Ctrl-U clear, Ctrl-W delete word, Ctrl-A / Ctrl-E start / end of line",
                "Players:   Enter = kick / ban;  m = message everyone;  r = refresh",
                "Maps:      type to filter; Enter = switch now / set starting map / add to rotation",
                "Settings:  Enter changes a value (saved to server.ini; F8 applies it to a running server)",
                "Store:     Enter = install / update;  x = remove (server stopped);  r = reload",
                "") + tuple(ADMIN_HELP.splitlines())

    def draw_help(self, y0, h):
        lines = self.help_lines()
        top = min(self.sel["Help"], max(0, len(lines) - h))
        for n, l in enumerate(lines[top:top + h]):
            self.put(y0 + n, 1, l, self.color("info") if l and not l.startswith(" ") else 0)

    def modal_items(self):
        m = self.modal
        if m["filter"]:
            f = m["filter"].lower()
            return [it for it in m["items"] if f in it[0].lower()]
        return m["items"]

    def draw_modal(self):
        m = self.modal
        items = self.modal_items()
        w = min(self.W - 4, max(40, max([len(i[0]) for i in items] + [len(m["title"])]) + 6))
        h = min(self.H - 4, len(items) + (4 if m["filter"] is not None else 3))
        x0, y0 = (self.W - w) // 2, max(1, (self.H - h) // 2)
        for y in range(h):
            self.put(y0 + y, x0, " " * w, self.color("box"))
        self.put(y0, x0 + 2, " %s " % m["title"], self.color("title"))
        ly = y0 + 1
        if m["filter"] is not None:
            self.put(ly, x0 + 2, "filter: %s_" % m["filter"], self.color("box"))
            ly += 1
        vis = h - (ly - y0) - 1
        m["sel"] = min(m["sel"], max(0, len(items) - 1))
        if m["sel"] < m["top"]:
            m["top"] = m["sel"]
        elif m["sel"] >= m["top"] + vis:
            m["top"] = m["sel"] - vis + 1
        for n, (label, _) in enumerate(items[m["top"]:m["top"] + vis]):
            a = self.color("sel") if m["top"] + n == m["sel"] else self.color("box")
            self.put(ly + n, x0 + 1, (" " + label).ljust(w - 2)[:w - 2], a)
        self.put(y0 + h - 1, x0 + 2, " Enter picks, Esc cancels ", self.color("box"))

    def draw(self):
        self.H, self.W = self.scr.getmaxyx()
        self.scr.erase()
        if self.H < 12 or self.W < 60:
            self.put(0, 0, "Terminal too small (need at least 60x12). F10 quits.")
            self.scr.refresh()
            return
        self.draw_header()
        y0, h = 3, self.H - 6
        getattr(self, "draw_" + TUI_SCREENS[self.screen].lower())(y0, h)
        # message line
        cursor = None
        if self.confirm:
            self.fill(self.H - 3, self.color("warnhead"))
            self.put(self.H - 3, 1, self.confirm[0] + "  [y/N]", self.color("warnhead"))
        elif self.edit:
            e = self.edit
            shown = "*" * len(e["buf"]) if e["secret"] else e["buf"]
            pre = "%s: " % e["label"]
            room = self.W - len(pre) - 3
            off = max(0, e["cur"] - room)
            self.fill(self.H - 3, self.color("sel"))
            self.put(self.H - 3, 1, pre + shown[off:off + room], self.color("sel"))
            cursor = (self.H - 3, 1 + len(pre) + e["cur"] - off)
        elif self.msg and time.time() - self.msg_at < 10:
            self.put(self.H - 3, 1, self.msg, self.color("warn"))
        # input / hint line
        if self.screen == 0:
            pre = "> " if self.st else "(stopped) > "
            room = self.W - len(pre) - 2
            off = max(0, self.cur - room)
            self.put(self.H - 2, 0, pre + self.inp[off:off + room], self.color("ok") if self.st else self.color("dim"))
            if not (self.edit or self.modal or self.confirm):
                cursor = (self.H - 2, len(pre) + self.cur - off)
        else:
            hint = {"Players": "Enter: kick / ban   m: message everyone   r: refresh",
                    "Maps": "Type to filter (ctf = Capture the Flag)  Enter: switch/start/rotation  Esc: clear  "
                            "*=playing s=start",
                    "Settings": "Up/Down choose   Enter change   (changes are saved to server.ini)",
                    "Store": "Enter: install / update   x: remove   r: reload",
                    "Help": "Up/Down scroll"}.get(TUI_SCREENS[self.screen], "")
            self.put(self.H - 2, 1, hint, self.color("dim"))
        # footer
        self.fill(self.H - 1, self.color("key"))
        self.put(self.H - 1, 0, " F7 %s  F8 Restart  F9 Update  F10 Quit  Tab Next screen  F1 Help" %
                 ("Stop" if self.st else "Start"), self.color("key"))
        if self.modal:
            self.draw_modal()
            cursor = None
        try:
            if cursor:
                curses.curs_set(1)
                self.scr.move(cursor[0], min(cursor[1], self.W - 1))
            else:
                curses.curs_set(0)
        except curses.error:
            pass
        self.scr.refresh()

    def init_colors(self):
        self.colors = {}
        if not curses.has_colors():
            return
        if not getattr(self, "colors_started", False):
            try:
                curses.start_color()
                self.colors_started = True
            except curses.error:
                return
            try:
                curses.use_default_colors()   # lets a theme say bg "default" (the original look)
                self.default_bg = -1
            except curses.error:
                self.default_bg = curses.COLOR_BLACK
        names = {"black": curses.COLOR_BLACK, "red": curses.COLOR_RED, "green": curses.COLOR_GREEN,
                 "yellow": curses.COLOR_YELLOW, "blue": curses.COLOR_BLUE, "magenta": curses.COLOR_MAGENTA,
                 "cyan": curses.COLOR_CYAN, "white": curses.COLOR_WHITE, "default": self.default_bg}
        flags = {"b": curses.A_BOLD, "d": curses.A_DIM, "r": curses.A_REVERSE}
        spec = TUI_THEMES[self.theme_name()][1]
        for n, (role, entry) in enumerate(spec.items(), 1):
            if entry is None:
                self.colors[role] = 0
                continue
            fg, bg, attrs = entry
            a = 0
            for ch in attrs:
                a |= flags[ch]
            if fg is not None:
                try:
                    curses.init_pair(n, names[fg], names[bg])
                    a |= curses.color_pair(n)
                except curses.error:
                    pass
            self.colors[role] = a
        try:
            # plain text (attr 0) draws in the body colour; 0 = the terminal's own colours
            self.scr.bkgd(" ", self.colors.get("body", 0))
        except curses.error:
            pass

    def theme_name(self):
        t = (self.cfg.get("tui", "theme") if getattr(self, "cfg", None) else "").lower()
        return t if t in TUI_THEMES else TUI_THEME_DEFAULT

    def read_escape(self):
        """curses decodes only the sequences in the terminfo entry for $TERM. PuTTY's default
        keyboard sends F1-F4 as ESC[11~..ESC[14~ and the Linux console as ESC[[A..ESC[[E; map
        those, and swallow any other unknown sequence instead of typing it into the console.
        Returns the key, "\\x1b" for a lone Esc, or None."""
        esc_keys = {"[11~": curses.KEY_F1, "[12~": curses.KEY_F2, "[13~": curses.KEY_F3, "[14~": curses.KEY_F4,
                    "[[A": curses.KEY_F1, "[[B": curses.KEY_F2, "[[C": curses.KEY_F3, "[[D": curses.KEY_F4,
                    "[[E": curses.KEY_F5}
        seq = ""
        self.scr.timeout(40)
        try:
            while len(seq) < 8:
                try:
                    c = self.scr.get_wch()
                except curses.error:
                    break
                if not isinstance(c, str):
                    curses.ungetch(c)   # a decoded key (Esc then F5, typed fast): keep it
                    break
                seq += c
                if len(seq) >= 2 and (c.isalpha() or c == "~"):
                    break
        finally:
            self.scr.timeout(150)
        if not seq:
            return "\x1b"
        return esc_keys.get(seq)

    def main(self, scr):
        import locale
        self.scr = scr
        enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "")
        self.ascii = enc != "utf8"
        self.init_colors()
        curses.raw()          # Ctrl-C / Ctrl-Q arrive as keys
        scr.keypad(True)
        scr.timeout(150)
        threading.Thread(target=self.poll_status, daemon=True).start()
        threading.Thread(target=self.pump_console, daemon=True).start()
        while not self.quit:
            self.draw()
            try:
                k = scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                break
            if k == "\x1b":
                k = self.read_escape()
                if k is None:
                    continue
            if k == curses.KEY_RESIZE:
                try:
                    curses.update_lines_cols()
                except AttributeError:
                    pass
                continue
            try:
                self.key(k)
            except Exception as e:   # noqa: BLE001 -- a bug in one action must not kill the screen
                self.note("Error: %s" % e)
        self.quit = True
        with self.lock:
            s = self.conn
        if s:
            try:
                s.close()
            except OSError:
                pass
        self.save_history()


def cmd_tui(a):
    if os.name != "posix":
        die("`tui` is for Linux (curses); on Windows use TribesHost.exe")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("`tui` needs an interactive terminal (use `console`, `status` and `logs` in scripts)")
    if curses is None:
        die("this Python has no curses module (Debian/Ubuntu ship it with python3)")
    inst = find_root(a.dir)
    ensure_config(inst)
    os.environ.setdefault("ESCDELAY", "25")   # Esc reacts at once instead of after a second
    try:
        curses.wrapper(Tui(inst).main)
    except curses.error as e:
        die("could not start the terminal UI (%s) -- is TERM set? e.g. TERM=xterm-256color" % e)


def main():
    ap = argparse.ArgumentParser(prog="tribes-server", description="Headless Modern Tribes server host + updater.")
    ap.add_argument("--dir", help="game folder (default: the folder this script is in)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("install", help="download a server install into a folder")
    p.add_argument("target", nargs="?", help="folder to install into (default: current folder)")
    p.add_argument("--full", action="store_true", help="everything the client gets (~7.5 GB)")
    p.add_argument("--manifest", help="manifest URL override")
    p.add_argument("--channel", help="update channel (dist branch), e.g. nightly")
    p.add_argument("--jobs", type=int, default=6)
    p.set_defaults(fn=cmd_install)

    p = sub.add_parser("update", help="update the install from the manifest")
    p.add_argument("--check", action="store_true", help="only report (exit 10 = update available)")
    p.add_argument("--full", action="store_true", help="include client-only content")
    p.add_argument("--verify", action="store_true", help="re-hash every file")
    p.add_argument("--now", action="store_true", help="running server: update immediately, even with players on")
    p.add_argument("--jobs", type=int, default=6)
    p.set_defaults(fn=cmd_update)

    p = sub.add_parser("run", help="run + supervise the server in the foreground")
    p.add_argument("--update", action="store_true", help="update before starting")
    p.add_argument("--no-update", action="store_true", help="disable auto-update for this run")
    p.set_defaults(fn=cmd_run)

    sub.add_parser("start", help="run in the background").set_defaults(fn=cmd_start)
    sub.add_parser("stop", help="stop the server").set_defaults(fn=cmd_stop)
    sub.add_parser("restart", help="restart the game (re-reads server.ini)").set_defaults(
        fn=lambda a: cmd_stop(a, "restart"))

    p = sub.add_parser("status", help="show server status")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("console", help="send a console command, or attach interactively")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.add_argument("--wait", type=float, default=1.5, help="seconds to show output after a one-shot command")
    p.set_defaults(fn=cmd_console)

    p = sub.add_parser("logs", help="show console_server.log")
    p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("-n", "--lines", type=int, default=50)
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("config", help="show / set / apply server.ini")
    p.add_argument("action", nargs="?", default="show",
                   choices=("show", "set", "apply", "save", "load", "presets", "restore-backup"))
    p.add_argument("args", nargs="*")
    p.set_defaults(fn=cmd_config)

    p = sub.add_parser("store", help="Asset Store mods: list / install <id...> / remove <id...>")
    p.add_argument("action", nargs="?", choices=("list", "install", "remove"), default="list")
    p.add_argument("ids", nargs="*")
    p.add_argument("--jobs", type=int, default=6)
    p.set_defaults(fn=cmd_store)

    sub.add_parser("mods", help="list hostable profiles").set_defaults(fn=cmd_mods)
    p = sub.add_parser("missions", help="list missions (with game type) for the configured profile")
    p.add_argument("--type", help="only types containing this, e.g. CTF")
    p.set_defaults(fn=cmd_missions)
    sub.add_parser("admin", help="console and in-game admin commands").set_defaults(fn=cmd_admin)
    sub.add_parser("netcheck", help="public / LAN join address, firewall and port-forward help") \
        .set_defaults(fn=cmd_netcheck)
    p = sub.add_parser("systemd", help="print a systemd unit for this install")
    p.add_argument("--name", help="unit suffix for several servers on one box")
    p.set_defaults(fn=cmd_systemd)
    sub.add_parser("doctor", help="check the environment").set_defaults(fn=cmd_doctor)
    sub.add_parser("tui", help="full-screen terminal UI: live console, players, maps, settings, store") \
        .set_defaults(fn=cmd_tui)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
