def cmd_doctor(a):
    inst = find_root(a.dir)
    ok = True

    def chk(cond, good, bad):
        nonlocal ok
        say(("  ok   " if cond else "  FAIL ") + (good if cond else bad))
        ok = ok and cond
    say("install   %s" % inst.root)
    chk(sys.version_info >= (3, 8), "python %s" % sys.version.split()[0], "python 3.8+ required")
    w = shutil.which(Config(inst).get("wine", "wine") or "wine")
    ver = ""
    if w:
        try:
            ver = subprocess.run([w, "--version"], capture_output=True, text=True, timeout=30).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass
    chk(bool(w), "wine: %s %s" % (w, ver), "wine not found (sudo apt update "
                                           "&& sudo apt install --no-install-recommends wine wine64)")
    chk(bool(inst.exe()), "game exe: %s" % inst.exe(), "no ModernTribes.exe (run `tribes-server install`)")
    if inst.exe():
        machine = pe_machine(os.path.join(inst.root, inst.exe()))
        dcfg = Config(inst)
        need = wine_arch(inst, dcfg)
        pfx = wine_env(inst, dcfg)["WINEPREFIX"]
        have = prefix_arch(pfx)
        chk(machine is not None, "game exe is %s -> Wine %s" % (machine, need), "game exe is not a Windows PE file")
        chk(have in (None, need), "Wine prefix %s (%s)" % (pfx, have or "created on first start"),
            "Wine prefix %s is %s but the game needs %s -- blank [wine] prefix or point it at a new folder"
            % (pfx, have, need))
        if need == "win64" and w and not (shutil.which("wine64") or os.path.exists("/usr/lib/wine/wine64")
                                          or os.path.exists("/opt/wine-stable/bin/wine64")):
            say("  note 64-bit Wine not found next to `wine` -- if the server will not start, "
                "`sudo apt install wine64` (Debian/Ubuntu) or install winehq-stable")
    chk(read_int(os.path.join(inst.root, VERSION_FILE)) > 0,
        "installed v%d" % read_int(os.path.join(inst.root, VERSION_FILE)), "no updver.txt (never updated)")
    free = shutil.disk_usage(inst.root).free
    chk(free > 1 << 30, "%s free" % human(free), "only %s free" % human(free))
    try:
        cfg = Config(inst)
        s = resolve(inst, cfg)
        chk(True, "config: profile %s, port %d" % (s.profile.key, s.port), "")
        if not running(inst):
            for port in (s.port, s.port + 2):
                t = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                try:
                    t.bind(("0.0.0.0", port))
                    chk(True, "UDP %d free" % port, "")
                except OSError:
                    chk(False, "", "UDP %d is in use" % port)
                finally:
                    t.close()
    except SystemExit:
        chk(False, "", "server.ini does not resolve (see the message above)")
    sys.exit(0 if ok else 1)


