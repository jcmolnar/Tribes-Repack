def mission_rows(inst, s):
    """(type, name, folder) for every map of the profile, sorted by type then name."""
    rows = []
    for n, d in list_missions(inst, s):   # hostgui.cpp parseDscType: $MDESC::Type from the .dsc beside the .mis
        t = ""
        try:
            with open(ci_join(mod_dir(inst, d), "missions", n + ".dsc"), "r", encoding="latin-1") as f:
                for line in f:
                    pa = _parse_assignment(line.rstrip("\r\n"))
                    if pa and pa[0].lower() == "mdesc::type":
                        t = pa[1]
                        break
        except OSError:
            pass
        rows.append((t or ("Other" if d.lower() == "base" else d + " maps"), n, d))
    return sorted(rows, key=lambda r: (r[0].lower(), r[1].lower()))


