# --- hostgui.cpp surgicalEdit, for config/rpgserv.cs and rmrpgserv.cs --------------------
def _comment_pos(line):
    in_q, i = False, 0
    while i < len(line):
        c = line[i]
        if in_q:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_q = False
        elif c == '"':
            in_q = True
        elif c == "/" and line[i + 1:i + 2] == "/":
            return i
        i += 1
    return -1


def _parse_assignment(line_in):
    cp = _comment_pos(line_in)
    line = line_in if cp < 0 else line_in[:cp]
    i = len(line) - len(line.lstrip(" \t"))
    if i >= len(line) or line[i] != "$":
        return None
    i += 1
    start = i
    while i < len(line):
        c = line[i]
        if c == "[":
            close = line.find("]", i)
            if close < 0:
                return None
            i = close + 1
            continue
        if c in " \t=":
            break
        i += 1
    if i == start:
        return None
    name = line[start:i]
    eq = line.find("=", i)
    if eq < 0:
        return None
    rest = line[eq + 1:]
    v = eq + 1 + (len(rest) - len(rest.lstrip(" \t")))
    if v >= len(line):
        return None
    if line[v] == '"':
        val, j = "", v + 1
        while j < len(line):
            c = line[j]
            if c == "\\" and j + 1 < len(line):
                val += line[j:j + 2]
                j += 2
                continue
            if c == '"':
                break
            val += c
            j += 1
        return name, val
    sc = line.find(";", v)
    return name, (line[v:] if sc < 0 else line[v:sc]).strip()


def surgical_edit(path, sets):
    with open(path, "rb") as f:
        text = f.read().decode("latin-1")
    eol = "\r\n" if "\r\n" in text else "\n"
    lines = [l[:-1] if l.endswith("\r") else l for l in text.split("\n")]
    if text.endswith("\n") and lines and lines[-1] == "":
        lines.pop()
    changed = False
    for canonical, new in sets:
        want, found, cur = canonical.lower(), -1, None
        for li, l in enumerate(lines):
            pa = _parse_assignment(l)
            if pa and pa[0].lower() == want:
                found, cur = li, pa[1]
        if found < 0:
            entry = '$%s = "%s";' % (canonical, new)
            if lines and not lines[-1].strip():
                lines.insert(len(lines) - 1, entry)
            else:
                lines.append(entry)
            changed = True
            continue
        if cur == new:
            continue
        line = lines[found]
        cp = _comment_pos(line)
        code = line if cp < 0 else line[:cp]
        eq = code.find("=")
        v = eq + 1
        while v < len(code) and code[v] in " \t":
            v += 1
        if code[v] == '"':
            j = v + 1
            while j < len(code):
                if code[j] == "\\" and j + 1 < len(code):
                    j += 2
                    continue
                if code[j] == '"':
                    break
                j += 1
            end = j + 1 if j < len(code) else len(code)
            rep = '"%s"' % new
        else:
            sc = code.find(";", v)
            end = len(code) if sc < 0 else sc
            while end > v and code[end - 1] in " \t":
                end -= 1
            rep = new if (new and re.fullmatch(r"[0-9.\-]+", new)) else '"%s"' % new
        lines[found] = line[:v] + rep + line[end:]
        changed = True
    if not changed:
        return
    bak = path + ".hostgui.bak"       # same durable first-original backup as TribesHost
    if not os.path.exists(bak):
        shutil.copyfile(path, bak)
    out = eol.join(lines) + (eol if text.endswith("\n") else "")
    write_atomic(path, out.encode("latin-1"), mode="wb")


