def manifest_url(inst, cfg):
    u = cfg.get("update", "manifest_url")
    if u:
        return u
    return OFFICIAL_REPO + (inst.channel() or "main") + "/manifest.json"


def http_open(url, timeout=30):
    p = urllib.parse.urlsplit(url)
    local = p.hostname in ("localhost", "127.0.0.1")
    if p.scheme != "https" and not (p.scheme == "http" and local):
        raise ValueError("refusing non-https URL: " + url)
    if p.username or p.password:
        raise ValueError("refusing URL with embedded credentials")
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Cache-Control": "no-cache"})
    return urllib.request.urlopen(req, timeout=timeout)


def fetch_manifest(url):
    with http_open(url) as r:
        data = r.read(MANIFEST_CAP + 1)
    if len(data) > MANIFEST_CAP:
        raise ValueError("manifest larger than %s" % human(MANIFEST_CAP))
    m = json.loads(data.decode("utf-8"))
    ver, base, files = m.get("version"), m.get("baseUrl", ""), m.get("files")
    if not isinstance(ver, int) or ver <= 0 or not base or not isinstance(files, list) or not files:
        raise ValueError("manifest is missing version/baseUrl/files")
    out, seen = [], set()
    for e in files:
        p, sha, size = e.get("path"), str(e.get("sha256", "")).lower(), e.get("size")
        if not safe_rel(p) or not re.fullmatch(r"[0-9a-f]{64}", sha) \
           or not isinstance(size, int) or not 0 <= size <= FILE_SIZE_CAP:
            raise ValueError("bad manifest entry: %r" % (e,))
        if p.lower() in seen:
            raise ValueError("duplicate manifest path: " + p)
        seen.add(p.lower())
        out.append({"path": p, "sha256": sha, "size": size, "url": e.get("url")})
    return {"version": ver, "baseUrl": base, "files": out, "notes": m.get("notes", "")}


class HashCache:
    def __init__(self, inst):
        self.path = os.path.join(inst.state, "hashcache.json")
        try:
            with open(self.path, "r", encoding="utf-8") as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            self.d = {}
        self.lock = threading.Lock()

    def lookup(self, rel, st):
        e = self.d.get(rel)
        return e[2] if e and e[0] == st.st_size and e[1] == st.st_mtime_ns else None

    def put(self, rel, st, sha):
        with self.lock:
            self.d[rel] = [st.st_size, st.st_mtime_ns, sha]

    def save(self):
        write_atomic(self.path, json.dumps(self.d, separators=(",", ":")), newline="\n")


def load_state(inst):
    try:
        with open(os.path.join(inst.state, "state.json"), "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(inst, st):
    inst.ensure_state()
    write_atomic(os.path.join(inst.state, "state.json"), json.dumps(st, indent=1), newline="\n")


class Progress:
    def __init__(self, label, total):
        self.label, self.total, self.done, self.last = label, total, 0, 0.0
        self.lock = threading.Lock()

    def add(self, n, force=False):
        with self.lock:
            self.done += n
            now = time.time()
            if force or now - self.last >= 5:
                self.last = now
                pct = 100.0 * self.done / self.total if self.total else 100.0
                say("  %s %s / %s (%.0f%%)" % (self.label, human(self.done), human(self.total), pct))


def exclude_rules(cfg):
    """[update] exclude: operator-chosen prefixes to skip, e.g. "config/nav/, Mods/War40k/"."""
    return tuple(r.strip().replace("\\", "/").rstrip("/") + "/"
                 for r in re.split(r"[,\n]", cfg.get("update", "exclude")) if r.strip())


def plan_update(inst, man, full, verify, exclude=()):
    """Return (needed entries, seed-skipped count, skipped count)."""
    cache = HashCache(inst)
    files = man["files"]
    skipped_client = 0
    todo = []
    rules = tuple(exclude) if full else tuple(CLIENT_ONLY) + tuple(exclude)
    for e in files:
        if matches_rules(e["path"], rules):
            skipped_client += 1
            continue
        todo.append(e)
    need, seed = [], 0
    hash_bytes = [0]
    prog = Progress("checked", sum(e["size"] for e in todo))

    def check(e):
        p = inst.path(e["path"])
        try:
            st = os.stat(p)
        except OSError:
            return e
        if seed_only(e["path"]):
            return "seed"
        if st.st_size != e["size"]:
            return e
        if not verify:
            hit = cache.lookup(e["path"], st)
            if hit is not None:
                prog.add(e["size"])
                return None if hit == e["sha256"] else e
        sha = sha256_file(p)
        cache.put(e["path"], st, sha)
        hash_bytes[0] += e["size"]
        prog.add(e["size"])
        return None if sha == e["sha256"] else e

    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as ex:
        for r in ex.map(check, todo):
            if r == "seed":
                seed += 1
            elif r is not None:
                need.append(r)
    if hash_bytes[0]:
        prog.add(0, force=True)
    inst.ensure_state()
    cache.save()
    return need, seed, skipped_client


_tls = threading.local()


class _KeepAlive:
    """One persistent HTTPS connection per worker thread and host. Thousands of small files
    each paying a fresh TLS handshake made a first install ~23 files/s; a redirect (GitHub
    release assets) or any connection error falls back to a plain one-shot urlopen."""

    def __init__(self, url, timeout):
        import http.client
        p = urllib.parse.urlsplit(url)
        if p.scheme != "https" or p.username or p.password:
            raise _NoKeepAlive()
        conns = getattr(_tls, "conns", None)
        if conns is None:
            conns = _tls.conns = {}
        key = (p.hostname, p.port or 443)
        self.conns, self.key = conns, key
        path = p.path + ("?" + p.query if p.query else "")
        for fresh in (False, True):
            conn = None if fresh else conns.get(key)
            if conn is None:
                conn = conns[key] = http.client.HTTPSConnection(p.hostname, p.port or 443, timeout=timeout)
            try:
                conn.request("GET", path, headers={"User-Agent": USER_AGENT})
                self.resp = conn.getresponse()
                break
            except Exception:   # noqa: BLE001 -- a stale kept-alive socket; retry once on a new one
                conn.close()
                conns.pop(key, None)
                if fresh:
                    raise
        if self.resp.status != 200:
            self.resp.read()
            if self.resp.status in (301, 302, 303, 307, 308):
                raise _NoKeepAlive()
            raise urllib.error.HTTPError(url, self.resp.status, self.resp.reason, self.resp.headers, None)

    def read(self, n):
        return self.resp.read(n)

    def __enter__(self):
        return self

    def __exit__(self, exc_type, *_):
        if exc_type is not None:   # partial body: the socket cannot be reused
            self.conns.pop(self.key, None)
            try:
                self.resp.close()
            except Exception:   # noqa: BLE001
                pass
        return False


class _NoKeepAlive(Exception):
    pass


def http_get(url, timeout=60):
    try:
        return _KeepAlive(url, timeout)
    except _NoKeepAlive:
        return http_open(url, timeout=timeout)


def download_one(inst, man, e, prog):
    staged = os.path.join(inst.root, STAGING, *e["path"].split("/"))
    if os.path.isfile(staged) and os.path.getsize(staged) == e["size"] and sha256_file(staged) == e["sha256"]:
        prog.add(e["size"])
        return staged   # survived an interrupted run -- reuse
    os.makedirs(os.path.dirname(staged), exist_ok=True)
    url = e["url"] or (man["baseUrl"] + urllib.parse.quote(e["path"], safe="/"))
    part = staged + ".part"
    last_err = None
    for attempt in range(4):
        got = 0
        try:
            h = hashlib.sha256()
            with http_get(url, timeout=60) as r, open(part, "wb") as f:
                while True:
                    chunk = r.read(1 << 18)
                    if not chunk:
                        break
                    got += len(chunk)
                    if got > e["size"]:
                        raise ValueError("larger than the manifest says")
                    h.update(chunk)
                    f.write(chunk)
                    prog.add(len(chunk))
            if got != e["size"] or h.hexdigest() != e["sha256"]:
                raise ValueError("size/hash mismatch (got %d bytes)" % got)
            os.replace(part, staged)
            return staged
        except Exception as ex:   # noqa: BLE001 -- retried, then reported
            prog.add(-got)
            last_err = ex
            time.sleep(2 * (attempt + 1))
    try:
        os.remove(part)
    except OSError:
        pass
    raise RuntimeError("%s: %s" % (e["path"], last_err))


def fetch_and_commit(inst, man, need, jobs, marker_version):
    """Download every entry in `need` into _update/, verify each, then swap them all in.
    Nothing on disk changes unless every download verified."""
    total = sum(e["size"] for e in need)
    free = shutil.disk_usage(inst.root).free
    if free < total * 1.1 + 64 * 1024 * 1024:
        raise RuntimeError("not enough disk space: need %s, %s free" % (human(total * 1.1), human(free)))
    prog = Progress("downloaded", total)
    staged = {}
    errors = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as ex:
        futs = {ex.submit(download_one, inst, man, e, prog): e for e in need}
        for fut in concurrent.futures.as_completed(futs):
            try:
                staged[futs[fut]["path"]] = fut.result()
            except Exception as exn:   # noqa: BLE001
                errors.append(str(exn))
    prog.add(0, force=True)
    if errors:
        for msg in errors[:10]:
            say("  FAILED " + msg)
        raise RuntimeError("%d download(s) failed; nothing was changed (staged files are kept for the retry)"
                           % len(errors))
    # Commit. The recover marker says "a swap was in progress" if we die half way;
    # the next run sees it and does a full re-check (updater.cpp UPD_RECOVER_FILE).
    write_atomic(os.path.join(inst.root, RECOVER_FILE), "%d\n" % marker_version, newline="\n")
    for rel, src in staged.items():
        dst = inst.path(rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        os.replace(src, dst)
        if rel == "tribes-server":
            try:
                os.chmod(dst, 0o755)
            except OSError:
                pass
    cache = HashCache(inst)
    for e in need:
        try:
            cache.put(e["path"], os.stat(inst.path(e["path"])), e["sha256"])
        except OSError:
            pass
    cache.save()


def do_update(inst, cfg, check_only=False, full=None, verify=False, jobs=6, quiet_current=False):
    """Game files, then every installed Asset Store pack. Returns (changed, remote_version).
    Never call while the server process is running."""
    changed, ver, man = _update_game(inst, cfg, check_only, full, verify, jobs, quiet_current)
    pchanged = update_packs(inst, cfg, man, check_only=check_only, full=full, verify=verify, jobs=jobs)
    return changed or pchanged, ver


def _update_game(inst, cfg, check_only, full, verify, jobs, quiet_current):
    if full is None:
        full = cfg.get("update", "mode").lower() == "full"
    url = manifest_url(inst, cfg)
    say("checking %s" % url)
    man = fetch_manifest(url)
    local = read_int(os.path.join(inst.root, VERSION_FILE))
    state = load_state(inst)
    exclude = exclude_rules(cfg)
    # the trusted fast path is only valid for the SAME file set it was verified against
    mode = ("full" if full else "server") + ("|" + ",".join(exclude) if exclude else "")
    say("%s, latest v%d%s" % ("installed v%d" % local if local else "fresh install", man["version"],
                              (" -- " + man["notes"]) if man["notes"] else ""))

    if inst.is_dev_tree():
        say("devtree.txt present: this tree runs development builds; game files are never updated here")
        return False, man["version"], man

    trusted = (local == man["version"] and state.get("verified") == man["version"]
               and state.get("mode") == mode and not os.path.exists(os.path.join(inst.root, RECOVER_FILE)))
    if trusted and not verify:
        if not quiet_current:
            say("up to date")
        return False, man["version"], man
    if check_only and local == man["version"] and not verify:
        say("up to date (run `update --verify` for a full hash check)")
        return False, man["version"], man

    need, seed, skipped = plan_update(inst, man, full, verify, exclude)
    total = sum(e["size"] for e in need)
    say("%d file(s) to download (%s); %d file(s) skipped (mode=%s%s); %d seed file(s) kept"
        % (len(need), human(total), skipped, "full" if full else "server",
           (", exclude " + " ".join(exclude)) if exclude else "", seed))
    if check_only:
        return bool(need) or local != man["version"], man["version"], man

    if need:
        fetch_and_commit(inst, man, need, jobs, man["version"])

    write_atomic(os.path.join(inst.root, VERSION_FILE), "%d\n" % man["version"], newline="\n")
    if full:
        write_atomic(os.path.join(inst.root, VERIFIED_FILE), "%d\n" % man["version"], newline="\n")
    state.update({"verified": man["version"], "mode": mode, "updated": int(time.time())})
    save_state(inst, state)
    for leftover in (os.path.join(inst.root, RECOVER_FILE),):
        try:
            os.remove(leftover)
        except OSError:
            pass
    shutil.rmtree(os.path.join(inst.root, STAGING), ignore_errors=True)
    for name in ("tribes-server",):
        p = inst.path(name)
        if os.path.isfile(p):
            try:
                os.chmod(p, 0o755)
            except OSError:
                pass
    say("now at v%d" % man["version"])
    return bool(need) or local != man["version"], man["version"], man


# ---------------------------------------------------------------------------------------
# Asset Store packs -- the mods that are NOT in the game release (Red Moon RPG, Annihilation,
# Shifter, Star Wars, ...). Mirrors updater.cpp: its own catalog (store.json) independent of
# the game manifest; ownership = updpacks/<id>.receipt in the SAME JSON shape the client
# writes; a pack whose paths the GAME manifest owns is unusable; remove/retire deletes only a
# file whose hash matches the receipt, that the game does not own and that no other installed
# pack claims (b244b1bf). Server-only filter + [update] exclude apply to pack files too.
# ---------------------------------------------------------------------------------------
STORE_URL_DEFAULT = "https://raw.githubusercontent.com/jcmolnar/Tribes-Asset-Store/main/store.json"
# tools/hostprobe, live since 2026-10-02; TribesHost's ProbeUrl uses the same default (hostgui.cpp)
PROBE_URL_DEFAULT = "https://kingdomofkronos.com/probe"
PACKS_DIR = "updpacks"


def store_url(cfg):
    u = cfg.get("update", "store_url")
    return "" if u == "0" else (u or STORE_URL_DEFAULT)


def fetch_store(url):
    with http_open(url) as r:
        data = r.read(MANIFEST_CAP + 1)
    if len(data) > MANIFEST_CAP:
        raise ValueError("store catalog larger than %s" % human(MANIFEST_CAP))
    s = json.loads(data.decode("utf-8"))
    packs = {}
    for p in s.get("packs") or []:
        pid, ver = str(p.get("id", "")), p.get("version")
        if not SAFE_WORD.match(pid) or not isinstance(ver, int):
            raise ValueError("bad store pack entry: %r" % pid)
        files = []
        for e in p.get("files") or []:
            path, sha, size, url = e.get("path"), str(e.get("sha256", "")).lower(), e.get("size"), e.get("url")
            if not safe_rel(path) or not re.fullmatch(r"[0-9a-f]{64}", sha) \
               or not isinstance(size, int) or not 0 <= size <= FILE_SIZE_CAP or not url:
                raise ValueError("bad file in store pack %s: %r" % (pid, e))
            files.append({"path": path, "sha256": sha, "size": size, "url": url})
        packs[pid.lower()] = {"id": pid, "version": ver, "title": p.get("title", pid),
                              "category": p.get("category", ""), "state": p.get("state", "live"),
                              "launchMods": p.get("launchMods") or [], "files": files}
    return {"generation": s.get("generation"), "packs": packs}


def receipt_file(inst, pid):
    return os.path.join(inst.root, PACKS_DIR, pid + ".receipt")


def load_receipts(inst):
    out = {}
    d = os.path.join(inst.root, PACKS_DIR)
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for n in names:
        if n.lower().endswith(".receipt"):
            try:
                with open(os.path.join(d, n), "r", encoding="utf-8") as f:
                    r = json.load(f)
                out[str(r.get("id", n[:-8])).lower()] = r
            except (OSError, ValueError):
                say("warning: unreadable receipt %s (treated as not installed)" % n)
    return out


def pack_unusable(pack, game_paths):
    """updater.cpp packUsable + the game-owns-this-path rule. "" = usable."""
    if pack["state"].lower() in ("coming-soon", "unavailable"):
        return "not available yet (%s)" % pack["state"]
    if not pack["files"]:
        return "has no files"
    clash = [f["path"] for f in pack["files"] if f["path"].lower() in game_paths]
    if clash:
        return "would overwrite game files (%s)" % clash[0]
    return ""


def _delete_if_owned(inst, rel, sha, game_paths, other_claims):
    """Delete one file only if its bytes are what the receipt recorded, the game does not own
    the path and no other installed pack claims it. Returns True if deleted."""
    low = rel.lower()
    if low in game_paths or low in other_claims:
        return False
    p = inst.path(rel)
    try:
        if not os.path.isfile(p) or sha256_file(p) != sha:
            return False
        os.remove(p)
    except OSError:
        return False
    d = os.path.dirname(p)   # prune now-empty folders, never above the install root
    while d.startswith(inst.root + os.sep):
        try:
            os.rmdir(d)
        except OSError:
            break
        d = os.path.dirname(d)
    return True


def install_pack(inst, cfg, pack, game_man, receipts, full=None, verify=False, jobs=6, check_only=False):
    """Install or bring one pack up to its catalog version. Returns True if anything changed."""
    if full is None:
        full = cfg.get("update", "mode").lower() == "full"
    game_paths = {e["path"].lower() for e in game_man["files"]}
    why = pack_unusable(pack, game_paths)
    if why:
        say("pack %s: %s -- skipped" % (pack["id"], why))
        return False
    exclude = exclude_rules(cfg)
    rules = tuple(exclude) if full else tuple(CLIENT_ONLY) + tuple(exclude)
    files = [f for f in pack["files"] if not matches_rules(f["path"], rules)]
    need, _, _ = plan_update(inst, {"files": files}, True, verify, ())
    old = receipts.get(pack["id"].lower())
    say("pack %s v%d%s: %d file(s) to download (%s), %d client-only file(s) skipped"
        % (pack["id"], pack["version"], (" (installed v%s)" % old.get("version")) if old else "",
           len(need), human(sum(e["size"] for e in need)), len(pack["files"]) - len(files)))
    if check_only:
        return bool(need) or not old or old.get("version") != pack["version"]
    if need:
        fetch_and_commit(inst, {"baseUrl": ""}, need, jobs, read_int(os.path.join(inst.root, VERSION_FILE)))
    retired = 0
    if old:   # files the old version owned that the new one no longer ships
        keep = {f["path"].lower() for f in files}
        claims = {f["path"].lower() for pid, r in receipts.items() if pid != pack["id"].lower()
                  for f in r.get("files", [])}
        for f in old.get("files", []):
            if f["path"].lower() not in keep and _delete_if_owned(inst, f["path"], f["sha256"], game_paths, claims):
                retired += 1
    os.makedirs(os.path.join(inst.root, PACKS_DIR), exist_ok=True)
    receipt = {"id": pack["id"], "version": pack["version"],
               "manifestVersion": read_int(os.path.join(inst.root, VERSION_FILE)),
               "files": [{"path": f["path"], "sha256": f["sha256"]} for f in files]}
    write_atomic(receipt_file(inst, pack["id"]), json.dumps(receipt, indent=1), newline="\n")
    try:
        os.remove(os.path.join(inst.root, RECOVER_FILE))
    except OSError:
        pass
    shutil.rmtree(os.path.join(inst.root, STAGING), ignore_errors=True)
    receipts[pack["id"].lower()] = receipt
    say("pack %s now v%d%s" % (pack["id"], pack["version"], (", %d old file(s) retired" % retired) if retired else ""))
    return True


def update_packs(inst, cfg, game_man, check_only=False, full=None, verify=False, jobs=6):
    receipts = load_receipts(inst)
    url = store_url(cfg)
    if not receipts or not url:
        return False
    try:
        store = fetch_store(url)
    except Exception as e:   # noqa: BLE001 -- a store outage never blocks a game update
        say("store catalog unavailable (%s); installed packs left as they are" % e)
        return False
    changed = False
    for pid, r in sorted(receipts.items()):
        pack = store["packs"].get(pid)
        if not pack:
            say("pack %s is no longer in the store; kept as installed (v%s)" % (r.get("id", pid), r.get("version")))
            continue
        if pack["version"] == r.get("version") and not verify:
            continue
        changed = install_pack(inst, cfg, pack, game_man, receipts, full, verify, jobs, check_only) or changed
    return changed


def packs_behind(inst, cfg):
    """Installed packs whose store version is newer -- what the auto-update timer needs to know
    when the store moved but the game did not. Empty on any store error (never blocks)."""
    receipts = load_receipts(inst)
    url = store_url(cfg)
    if not receipts or not url:
        return []
    try:
        packs = fetch_store(url)["packs"]
    except Exception:   # noqa: BLE001
        return []
    return ["%s v%s->v%d" % (r.get("id", pid), r.get("version"), packs[pid]["version"])
            for pid, r in sorted(receipts.items()) if pid in packs and packs[pid]["version"] != r.get("version")]


def remove_pack(inst, pid, game_man):
    receipts = load_receipts(inst)
    r = receipts.get(pid.lower())
    if not r:
        die("pack '%s' is not installed (`tribes-server store` lists them)" % pid)
    game_paths = {e["path"].lower() for e in game_man["files"]}
    claims = {f["path"].lower() for other, rr in receipts.items() if other != pid.lower()
              for f in rr.get("files", [])}
    deleted = kept = 0
    for f in r.get("files", []):
        if _delete_if_owned(inst, f["path"], f["sha256"], game_paths, claims):
            deleted += 1
        elif os.path.exists(inst.path(f["path"])):
            kept += 1
    os.remove(receipt_file(inst, r.get("id", pid)))   # LAST, like the client
    say("removed pack %s: %d file(s) deleted, %d kept (changed by you, or used by the game or another pack)"
        % (r.get("id", pid), deleted, kept))


# ---------------------------------------------------------------------------------------
# GameSpyQuery1 (0x62) status probe -- hostgui.cpp probeSend/probeRecv
# ---------------------------------------------------------------------------------------
def probe(port, timeout=2.0):
    k1, k2 = random.randrange(256), random.randrange(256)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        s.sendto(bytes((0x62, k1, k2)), ("127.0.0.1", port))
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                buf, frm = s.recvfrom(2048)
            except socket.timeout:
                return None
            if frm[1] != port or len(buf) < 8 or buf[0] != 0 or buf[1] != k1 or buf[2] != k2 or buf[3] != 0x62:
                continue
            idx = [4]

            def rd():
                if idx[0] >= len(buf):
                    raise ValueError
                n = buf[idx[0]]
                v = buf[idx[0] + 1: idx[0] + 1 + n]
                if len(v) != n:
                    raise ValueError
                idx[0] += 1 + n
                return v.decode("latin-1")
            try:
                game, ver, host = rd(), rd(), rd()
                i = idx[0] + 2
                players, maxp = buf[i], buf[i + 1]
                idx[0] = i + 4
                mods, mtype, mname = rd(), rd(), rd()
            except (ValueError, IndexError):
                continue
            return {"name": host, "version": ver, "players": players, "max": maxp,
                    "mods": mods, "missionType": mtype, "mission": mname}
        return None
    except OSError:
        return None
    finally:
        s.close()


