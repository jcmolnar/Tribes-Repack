                    time.sleep(0.5)
        except KeyboardInterrupt:
            pass


def ini_set(inst, sec, key, value):
    """Set one key in server.ini in place, keeping every comment and the key order."""
    with open(inst.config_path, "r", encoding="utf-8") as f:
        lines = f.read().split("\n")
    cur, done = None, False
    for i, l in enumerate(lines):
        m = re.match(r"\s*\[(.+)\]\s*$", l)
        if m:
            if cur == sec:
                lines.insert(i, "%s = %s" % (key, value))
                done = True
                break
            cur = m.group(1)
        elif cur == sec and re.match(r"\s*%s\s*=" % re.escape(key), l):
            lines[i] = "%s = %s" % (key, value)
            done = True
            break
    if not done:
        if cur != sec:
            lines += ["", "[%s]" % sec]
        lines.append("%s = %s" % (key, value))
    write_atomic(inst.config_path, "\n".join(lines), newline="\n")


# [server] keys that belong to the selected profile: a profile CHANGE in the tui clears them
# (Tui.set_profile). `config set server.profile` only warns -- an expert may set mods after it.
PROFILE_OWNED_KEYS = ("mods", "mission", "rotation")
PROFILE_KEY_LABELS = {"mods": "mod chain override", "mission": "starting map", "rotation": "map rotation"}


PRESET_NAME = re.compile(r"^[A-Za-z0-9 _.-]{1,40}$")
PASSWORD_KEYS = ("join_password", "admin_password")


def _preset_dir(inst):
    return os.path.join(inst.state, "presets")


def _set_ini_text_value(text, key, value):
    """Replace `key = ...` in [server] text (presets carry the same layout as server.ini)."""
    return re.sub(r"(?m)^(\s*%s\s*=).*$" % re.escape(key), lambda m: "%s %s" % (m.group(1), value), text)


def cmd_preset(inst, a):
    """TribesHost presets: whole settings snapshots by name, passwords NEVER stored; loading one
    keeps the passwords currently in server.ini."""
    d = _preset_dir(inst)
    if a.action == "presets":
        names = sorted(n[:-4] for n in os.listdir(d) if n.endswith(".ini")) if os.path.isdir(d) else []
        say("\n".join(names) if names else "no presets yet (`tribes-server config save <name>`)")
        return
    if len(a.args) != 1 or not PRESET_NAME.match(a.args[0]):
        die("usage: tribes-server config %s <name>   (letters, digits, space, _ . -)" % a.action)
    path = os.path.join(d, a.args[0] + ".ini")
    with open(inst.config_path, "r", encoding="utf-8") as f:
        cur = f.read()
    if a.action == "save":
        os.makedirs(d, exist_ok=True)
        text = cur
        for k in PASSWORD_KEYS:
            text = _set_ini_text_value(text, k, "")
        write_atomic(path, text, newline="\n")
        say("saved preset '%s' (passwords excluded)" % a.args[0])
        return
    if not os.path.isfile(path):
        die("no preset '%s' (`tribes-server config presets`)" % a.args[0])
    with open(path, "r", encoding="utf-8") as f:
        text = f.read()
    cp = configparser.ConfigParser(interpolation=None)
    cp.read_string(cur)
    for k in PASSWORD_KEYS:
        text = _set_ini_text_value(text, k, cp.get("server", k, fallback=""))
    write_atomic(inst.config_path, text, newline="\n")
    say("loaded preset '%s' (kept your current passwords); `tribes-server restart` to use it" % a.args[0])


def cmd_config(a):
    inst = find_root(a.dir)
    cfg = ensure_config(inst)
    if a.action in ("save", "load", "presets"):
        return cmd_preset(inst, a)
    if a.action == "restore-backup":
        # TribesHost "Restore backup": the first-original copy surgical_edit took of each serv file
        found = False
        for n in sorted(os.listdir(ci_join(inst.root, "config"))):
            if n.endswith(".hostgui.bak"):
                found = True
                src = os.path.join(ci_join(inst.root, "config"), n)
                shutil.copyfile(src, src[:-len(".hostgui.bak")])
                say("restored config/%s from its backup" % n[:-len(".hostgui.bak")])
        if not found:
            say("no backups (nothing has edited config/rpgserv.cs or rmrpgserv.cs yet)")
        return
    if a.action == "set":
        if len(a.args) != 2 or "." not in a.args[0]:
            die("usage: tribes-server config set section.key value   (e.g. server.name \"My Server\")")
        sec, key = a.args[0].split(".", 1)
        known = configparser.ConfigParser(interpolation=None)
        known.read_string(DEFAULT_INI)
        if not known.has_option(sec, key):
            # a typo would otherwise be written, ignored, and look like it worked
            die("unknown setting '%s.%s'. Settings:\n  %s" % (sec, key, "\n  ".join(
                "%s.%s" % (s_, k) for s_ in known.sections() for k in known.options(s_))))
        if (sec, key) == ("tui", "theme") and a.args[1].lower() not in TUI_THEMES:
            die("unknown theme '%s'. Themes: %s" % (a.args[1], ", ".join(TUI_THEMES)))
        old_profile = cfg.get("server", "profile").lower()
        ini_set(inst, sec, key, a.args[1])
        cfg = Config(inst)
        if (sec, key) == ("server", "profile") and a.args[1].lower() != old_profile:
            kept = [k for k in PROFILE_OWNED_KEYS if cfg.get("server", k).strip()]
            if kept:
                say("note: %s still set from the previous mod%s -- clear with `config set server.<key> \"\"`"
                    % (", ".join("server.%s = %s" % (k, cfg.get("server", k)) for k in kept),
                       " (mods OVERRIDES the profile's chain)" if "mods" in kept else ""))
    s = resolve(inst, cfg)
    if a.action == "apply":
        apply_settings(inst, s)
        say("wrote config/hostgui.cs%s" % (" and config/" + s.profile.serv_file if s.profile.serv_file else ""))
        return
    say("config    %s" % inst.config_path)
    say("profile   %s (%s) -- launch: %s" % (s.profile.key, s.profile.label, " ".join(launch_args(inst, s))
                                             if inst.exe() else "(not installed)"))
    say("server    %s, port %d, %d players, mission %s, %s, netcode %s" % (
        s.name, s.port, s.max_players, s.mission or "(mod default)", "public" if s.public else "LAN/unlisted",
        "modern150" if s.modern else "legacy"))
    if len(s.rotation) >= 2:
        say("rotation  %s" % " -> ".join(s.rotation))
    say("passwords join %s, admin %s" % ("set" if s.join_pw else "none", "set" if s.admin_pw else "NONE"))


