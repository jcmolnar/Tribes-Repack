def cmd_console(a):
    inst = find_root(a.dir)
    if a.command:
        text = " ".join(a.command)
        r = ctl_request(inst, "attach", backlog=0)
        if not r:
            die("not running")
        s, f = r
        s.sendall((text + "\n").encode())
        s.settimeout(a.wait)
        try:
            for line in f:
                print(line, end="", flush=True)
        except (socket.timeout, OSError):
            pass
        s.close()
        return
    r = ctl_request(inst, "attach", backlog=40)
    if not r:
        die("not running")
    s, f = r
    say("-- attached to the server console. Type TorqueScript commands; Ctrl-D or Ctrl-C detaches "
        "(the server keeps running). --")

    def reader():
        try:
            for line in f:
                print(line, end="", flush=True)
        except (OSError, ValueError):
            pass
        os._exit(0)
    threading.Thread(target=reader, daemon=True).start()
    try:
        for line in sys.stdin:
            s.sendall(line.encode())
    except KeyboardInterrupt:
        pass
    s.close()


