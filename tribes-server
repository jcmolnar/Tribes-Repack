def cmd_run(a):
    if os.name != "posix":
        die("`run` is for Linux; on Windows use TribesHost.exe")
    inst = find_root(a.dir)
    cfg = ensure_config(inst)
    if running(inst):
        die("a supervisor for %s is already running (`tribes-server status`)" % inst.root)
    # A re-exec after a self-update has just updated: skip the pre-start check (it would only
    # repeat the download check while no control socket is up yet).
    reexeced = os.environ.pop(REEXEC_ENV, None)
    if not reexeced and (a.update or (cfg.bool("update", "auto_update", False) and not a.no_update)):
        before = file_sha1(os.path.abspath(__file__))
        try:
            do_update(inst, cfg, quiet_current=True)
        except Exception as e:   # noqa: BLE001 -- start on what we have
            say("update check failed (%s); starting the installed version" % e)
        reexec_if_updated(before, say)
    sup = Supervisor(inst, cfg, auto_update=False if a.no_update else None)
    sys.exit(sup.main())


LOG_ROTATE_BYTES = 50 * 1024 * 1024


def rotate_log(path):
    """A server meant to stay up for months on a small VPS disk must not grow its logs forever:
    past LOG_ROTATE_BYTES the log becomes <name>.1 (one old copy kept, the older one dropped).
    Only called while nothing has the file open -- the game holds console_server.log open
    for its whole run, so it rotates at (re)launch, not mid-run."""
    try:
        if os.path.getsize(path) > LOG_ROTATE_BYTES:
            os.replace(path, path + ".1")
    except OSError:
        pass


