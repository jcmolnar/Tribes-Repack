def running(inst):
    r = ctl_request(inst, "status")
    if not r:
        return None
    s, f = r
    s.settimeout(10)   # a wedged supervisor must not hang `status` (or the tui's poll) forever
    try:
        return json.loads(f.readline() or "null")
    except (ValueError, OSError):
        return None
    finally:
        s.close()


