# updater.cpp updSeedOnly: shipped so a fresh install has one; once present it is USER
# STATE (operator passwords, quit-time exports) and is never "repaired".
def seed_only(rel):
    low = rel.lower()
    if low.startswith("config/hudlayout_") and "/" not in low[17:] and low.endswith(".cs"):
        return True
    return low in ("modlist.txt", "config/serverprefs.cs", "config/play.gui",
                   "config/rpgserv.cs", "config/rmrpgserv.cs")


def matches_rules(rel, rules):
    parts = rel.lower().split("/")
    for rule in rules:
        rp = rule.lower().rstrip("/").split("/")
        if len(parts) > len(rp) and all(r == "*" or r == p for r, p in zip(rp, parts)):
            return True
    return False


def client_only(rel):
    return matches_rules(rel, CLIENT_ONLY)


