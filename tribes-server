BOOL_TRUE = ("1", "true", "yes", "on")


class Config:
    def __init__(self, inst):
        self.inst = inst
        self.cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=None)
        self.cp.read_string(DEFAULT_INI)
        if os.path.isfile(inst.config_path):
            with open(inst.config_path, "r", encoding="utf-8") as f:
                self.cp.read_file(f)

    def get(self, sec, key):
        return self.cp.get(sec, key, fallback="").strip()

    def bool(self, sec, key, default=False):
        v = self.get(sec, key).lower()
        return default if v == "" else v in BOOL_TRUE

    def int(self, sec, key, default):
        try:
            return int(self.get(sec, key))
        except ValueError:
            return default


def ensure_config(inst):
    if not os.path.isfile(inst.config_path):
        write_atomic(inst.config_path, DEFAULT_INI, newline="\n")
        try:
            os.chmod(inst.config_path, 0o600)   # holds passwords
        except OSError:
            pass
        say("wrote default %s -- edit it, then start the server" % inst.config_path)
    return Config(inst)


