def cmd_netcheck(a):
    """TribesHost "Readiness" + "Test Internet": public address, local answer, firewall hint,
    and the optional UDP reachability service ([network] probe_url, same protocol)."""
    inst = find_root(a.dir)
    cfg = Config(inst)
    s = resolve(inst, cfg)
    say("game port UDP %d, voice UDP %d" % (s.port, s.port + 2))
    st = probe(s.port)
    say(("  ok   server answers on this machine: %s, %d/%d players" % (st["name"], st["players"], st["max"]))
        if st else "  --   no server answering on UDP %d here (start it first for a full check)" % s.port)
    lan = ""
    try:
        t = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        t.connect(("192.0.2.1", 9))   # TEST-NET: picks the outbound interface, sends nothing
        lan = t.getsockname()[0]
        t.close()
    except OSError:
        pass
    if lan:
        say("  LAN join address:      %s:%d" % (lan, s.port))
    public = ""
    try:
        with http_open("https://api.ipify.org", timeout=8) as r:
            public = r.read(64).decode("ascii", "replace").strip()
    except Exception:   # noqa: BLE001
        pass
    if re.fullmatch(r"\d{1,3}(\.\d{1,3}){3}", public):
        say("  Internet join address: %s:%d   (players: Join by address IP:%s:%d)" % (public, s.port, public, s.port))
    else:
        say("  could not look up the public address (no Internet, or api.ipify.org blocked)")
    if shutil.which("ufw"):
        say("  firewall (ufw):        sudo ufw allow %d:%d/udp" % (s.port, s.port + 2))
    elif shutil.which("firewall-cmd"):
        say("  firewall (firewalld):  sudo firewall-cmd --permanent --add-port=%d-%d/udp && sudo firewall-cmd --reload"
            % (s.port, s.port + 2))
    say("  home router: forward UDP %d and %d to %s (cloud VPS: open them in the provider's firewall)"
        % (s.port, s.port + 2, lan or "this machine"))
    if not s.public:
        say("  note: public = false -- the server is not announced on the master list")
    url = cfg.get("network", "probe_url") or PROBE_URL_DEFAULT
    if url.lower() in ("0", "off"):
        url = ""
    if url:
        try:
            with http_open(url + ("&" if "?" in url else "?") + "port=%d" % s.port, timeout=15) as r:
                text = r.read(65536).decode("utf-8", "replace")
            # tools/hostprobe replies "key=value" lines -- what TribesHost parses (hostgui.cpp
            # responseValue). This used to json.loads() it and failed on the real service.
            try:
                body = json.loads(text)
            except ValueError:
                body = dict(l.split("=", 1) for l in text.splitlines() if "=" in l)
            say("  Internet UDP test:     %s -- %s" % (body.get("status", "?"), body.get("detail", "")))
            if body.get("status") == "open":
                say("  ok   players on the Internet can reach this server")
            elif st:
                say("  !!   the server runs here but did not answer from outside: open UDP %d and %d in"
                    "\n       the VPS provider's firewall / security group (or forward them on your router)"
                    % (s.port, s.port + 2))
            else:
                say("  --   start the server, then run netcheck again for a real answer")
        except Exception as e:   # noqa: BLE001
            say("  Internet UDP test failed: %s" % e)
    else:
        say("  (Internet UDP test is off: [network] probe_url = 0)")


