class Profile:
    def __init__(self, label, mods, serv_file, def_mission, def_port, mission_dirs):
        self.label = label
        self.mods = [m.lower() for m in mods]
        self.serv_file = serv_file
        self.def_mission = def_mission
        self.def_port = def_port
        self.mission_dirs = mission_dirs

    @property
    def key(self):
        return self.mods[-1] if self.mods else "base"


SAFE_WORD = re.compile(r"^[A-Za-z0-9_.-]+$")


def mod_has_code(d):
    # hostgui.cpp modFolderHasCode (wider than the in-game picker on purpose)
    def any_glob(sub, exts):
        p = os.path.join(d, sub) if sub else d
        try:
            return any(e.lower().endswith(exts) and os.path.isfile(os.path.join(p, e)) for e in os.listdir(p))
        except OSError:
            return False
    if any_glob("", (".cs", ".vol", ".zip")) or any_glob("scripts", (".cs",)):
        return True
    if any_glob(ci_join(d, "missions"), (".mis",)):
        return True
    sd = ci_join(d, "scripts")
    try:
        return any(os.path.isdir(os.path.join(sd, s)) and any_glob(os.path.join(sd, s), (".cs",))
                   for s in os.listdir(sd))
    except OSError:
        return False


def load_profiles(inst):
    profs = [
        Profile("Base Tribes", [], None, "raindance", 28001, ["base"]),
        Profile("Tribes RPG", ["rpg"], "rpgserv.cs", "rpgmap6", 28001, ["RPG", "base"]),
        Profile("Red Moon RPG", ["rpg", "rmrpg"], "rmrpgserv.cs", "RMR", 28002, ["RMRPG", "RPG", "base"]),
        Profile("Mech Mayhem", ["mechmayhem"], None, "MechArena1", 28004, ["MechMayhem", "base"]),
    ]
    keys = {p.key for p in profs}
    extra = []
    try:
        with open(os.path.join(inst.root, "TribesHostMods.txt"), "r", encoding="latin-1") as f:
            for line in f:
                w = re.split(r"[#;]", line, 1)[0].strip()
                if SAFE_WORD.match(w) and w.lower() != "base":
                    extra.append(w)
    except OSError:
        pass
    mods_dir = ci_join(inst.root, "Mods")
    try:
        for name in sorted(os.listdir(mods_dir)):
            if SAFE_WORD.match(name) and name.lower() != "base" and os.path.isdir(os.path.join(mods_dir, name)) \
               and mod_has_code(os.path.join(mods_dir, name)):
                extra.append(name)
    except OSError:
        pass
    for name in extra:
        if name.lower() not in keys:
            keys.add(name.lower())
            profs.append(Profile(name, [name], None, "", 28001, [name, "base"]))
    return profs


def parse_mod_words(text):
    words = []
    for w in re.split(r"[\s,]+", text.strip().lower()):
        if not w or w == "-mod":
            continue
        bare = w[1:] if w.startswith("+") else w
        if not SAFE_WORD.match(bare) or bare.startswith("-"):
            die("server.ini [server] mods: '%s' is not a mod folder name" % w)
        if bare != "base":
            words.append(w)
    return words


def mod_dir(inst, name):
    # hostgui.cpp modDirPath: legacy root folder first, then Mods/<name>
    root = ci_join(inst.root, name)
    if os.path.isdir(root):
        return root
    m = ci_join(inst.root, "Mods", name)
    return m if os.path.isdir(m) else root


class Settings:
    pass


def resolve(inst, cfg):
    profs = load_profiles(inst)
    want = (cfg.get("server", "profile") or "base").lower()
    prof = next((p for p in profs if p.key == want), None)
    if not prof:
        die("unknown profile '%s' -- `tribes-server mods` lists the installed ones" % want)
    s = Settings()
    s.profile = prof
    override = parse_mod_words(cfg.get("server", "mods"))
    s.launch_mods = [w.lstrip("+") for w in override] if override else list(prof.mods)
    s.advertised = " ".join(w for w in override if not w.startswith("+")) \
        if any(w.startswith("+") for w in override) else ""
    if override:
        s.mission_dirs = [w for w in reversed(s.launch_mods)] + ["base"]
    else:
        s.mission_dirs = prof.mission_dirs
    s.rpg = prof.key in ("rpg", "rmrpg") or any("rpg" in w for w in s.launch_mods)

    def text(key):
        v = cfg.get("server", key)
        if '"' in v or "\n" in v or "\r" in v:
            die("server.ini [server] %s: double quotes and raw line breaks are not allowed" % key)
        return v

    s.name = text("name") or "TRIBES Server"
    s.mission = text("mission") or prof.def_mission
    s.port = cfg.int("server", "port", prof.def_port)
    if not 0 < s.port < 65536:
        s.port = prof.def_port
    s.max_players = min(max(cfg.int("server", "max_players", 8), 1), 128)
    s.join_pw = text("join_password")
    s.admin_pw = text("admin_password")
    s.public = cfg.bool("server", "public", False)
    s.info = text("info")
    s.motd = text("motd")
    s.rotation = [m.strip() for m in text("rotation").split(",") if m.strip()]
    b0, b1 = cfg.get("server", "bots_team0"), cfg.get("server", "bots_team1")
    s.bot0 = int(b0) if b0.lstrip("-").isdigit() else -1
    s.bot1 = int(b1) if b1.lstrip("-").isdigit() else -1
    b = cfg.get("server", "bots").lower()
    s.bots = None if b == "" else b in BOOL_TRUE
    s.mixed = cfg.bool("server", "mixed_types", False)
    s.voice = cfg.bool("server", "voice_chat", True)
    s.competitive = cfg.bool("server", "competitive", False)
    s.modern = cfg.get("server", "netcode").lower() == "modern150"
    s.lag_comp = cfg.bool("server", "lag_comp", False)
    s.fire_view = cfg.bool("server", "fire_from_view", False)
    s.req_current = cfg.bool("server", "require_current_client", False)
    s.ac_observe = cfg.bool("server", "cheat_observe", True)
    if s.competitive:   # hostgui.cpp applyCompetitive
        s.modern = s.lag_comp = s.req_current = s.ac_observe = True
    s.rpg_limits = cfg.bool("server", "rpg_limits", s.modern and s.rpg)
    if not s.mission:
        s.mission = default_mission(inst, s)
    for m in [s.mission] + s.rotation:
        if m and not find_mission(inst, s, m):
            say("warning: mission '%s' not found under %s" % (m, ", ".join(s.mission_dirs)))
    return s


def list_missions(inst, s):
    seen, out = set(), []
    for d in s.mission_dirs:
        md = ci_join(mod_dir(inst, d), "missions")
        try:
            names = sorted(os.listdir(md), key=str.lower)
        except OSError:
            continue
        for n in names:
            if n.lower().endswith(".mis") and n[:-4].lower() not in seen:
                seen.add(n[:-4].lower())
                out.append((n[:-4], d))
    return out


def default_mission(inst, s):
    """A profile with no built-in default map (every discovered / store mod). Writing an empty
    $pref::LastMission boots the server with "Error: no mission provided." TribesHost never
    does: loadEffectiveSettings falls back to ServerPrefs.cs's $pref::LastMission and its map
    list always has a selection. Same order here, then the mod's own first map."""
    last = ""
    try:
        with open(ci_join(inst.root, "config", "ServerPrefs.cs"), "r", encoding="latin-1") as f:
            for line in f:
                pa = _parse_assignment(line.rstrip("\r\n"))
                if pa and pa[0].lower() == "pref::lastmission":
                    last = pa[1]
    except OSError:
        pass
    maps = list_missions(inst, s)
    if last and any(n.lower() == last.lower() for n, _ in maps):
        pick = last
    else:
        own = [n for n, d in maps if d.lower() != "base"]
        pick = (own or [n for n, _ in maps] or [""])[0]
    if pick:
        say("no mission set for profile %s; using %s (set server.mission to choose)" % (s.profile.key, pick))
    return pick


def find_mission(inst, s, name):
    return any(n.lower() == name.lower() for n, _ in list_missions(inst, s))


# hostgui.cpp writeHostguiCs, line for line.
def hostgui_cs(s):
    t = []
    a = t.append
    a("// Written by tribes-server -- do not hand-edit; overwritten on every launch.")
    a("// Comments in this file are always on their own line (never after a statement).")
    if not s.profile.serv_file:
        a('$Server::HostName = "%s";' % s.name)
        a('$Server::Port = "%d";' % s.port)
        a('$Server::MaxPlayers = "%d";' % s.max_players)
        a('$Server::Password = "%s";' % s.join_pw)
        a('$Server::JoinPassword = "%s";' % s.join_pw)
        a('$Server::HostPublicGame = "%s";' % ("true" if s.public else "false"))
        a('$Server::Info = "%s";' % s.info)
        a('$Server::JoinMOTD = "%s";' % s.motd)
        a('$AdminPassword = "%s";' % s.admin_pw)
        a('$pref::LastMission = "%s";' % s.mission)
    else:
        a("// RPG / Red Moon settings live in config\\rpgserv.cs / rmrpgserv.cs (the")
        a("// mod execs those AFTER this file, so they are authoritative there).")
        # DEVIATION from TribesHost, on purpose: the same core values are written here too.
        # Red Moon store packs up to v9 carry an OLD Server.cs (no exec(rmrpgserv)) in the
        # mod-root scripts.zip, and the mod-archive rank (7a220f0) puts that archive ahead of
        # the mod's own scripts\ folder (a later search root) -- so rmrpgserv.cs is never read
        # and the server boots the shared $pref::LastMission/port. Store rmrpg v10 drops those
        # copies from the zip; this stays for installs still on v9. Identical values, so when
        # the serv file IS read nothing changes.
        a('$Server::HostName = "%s";' % s.name)
        a('$Server::Port = "%d";' % s.port)
        a('$Server::MaxPlayers = "%d";' % s.max_players)
        a('$Server::Password = "%s";' % s.join_pw)
        a('$Server::JoinPassword = "%s";' % s.join_pw)
        a('$Server::HostPublicGame = "%s";' % ("true" if s.public else "false"))
        a('$pref::LastMission = "%s";' % s.mission)
    if s.bots is not None:   # TribesHost has no switch for this; hand-editing ServerPrefs.cs was the way
        a('$Server::BotBrain = "%s";' % ("1" if s.bots else "0"))
    if s.bot0 >= 0:
        a('$pref::botMaxTeam0 = "%d";' % s.bot0)
    if s.bot1 >= 0:
        a('$pref::botMaxTeam1 = "%d";' % s.bot1)
    a('$HostGUI::MixedTypes = "%s";' % ("true" if s.mixed else "false"))
    a('$Host::voiceChat = "%s";' % ("true" if s.voice else "false"))
    a('$Server::NetcodeMode = "%s";' % ("modern150" if s.modern else "legacy"))
