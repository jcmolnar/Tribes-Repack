//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<f0><jc>Mission Briefing for: <f1>DF_ProkchopHill_v0.5  <f0>  Mission Type:<f1> Capture and Hold.\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Listen UP, soldiers!\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>Nervous?    ...sure ya are.\", 5);", 8);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 8);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>I'm only going to tell you this one time.\", 8);", 11);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 11);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>You have no idea where the transport has brought you.\", 11);", 14);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 14);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>The last batch of GRUNTS are being shipped home in body bags.\", 14);", 18);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 18);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>From the stories you have heard, it's no doubt you're nervous.\", 18);", 22);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 22);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>If you don't want to be on the next flight with a tag on your toe, you had better pay attention!!\", 22);", 27);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 27);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>All sense of the reason why has been lost, but the order continues to be handed down.\", 27);", 31);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 31);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>The enemy has been ruthlessly pounding our positions. There is no intention on their part to relinquish control of the area.\", 31);", 36);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 36);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>You just hope...\", 36);", 40);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 40);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>The rugged terrain surrounding this valley prevents ground vehicles from assisting, and our supplies are limited.\", 40);", 42);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 42);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>That by the end of this tour, you'll be the one telling the stories.\", 42);", 46);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 46);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>With any luck, the AIR CALVARY, along with reinforcements, will bring much needed resources.\", 46);", 50);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 50);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>Not just another slab of meat,\", 50);", 54);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 54);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Any questions?\", 54);", 56);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 56);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>...on<f2> PORKCHOP HILL.\", 56);", 58);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 58);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc>TEAM COOPERATION IS ESSENTIAL!!!\", 58);", 62);
        schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 62);
}


