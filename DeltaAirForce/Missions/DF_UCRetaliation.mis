//--- export object end ---//
exec(misrestart);
$Server::timeLimit = 60;
$Server::TeamDamageScale = 100;
exec(dm);
$hostageGame = 0;
$DMScoreLimit = 0;
$Game::missionType = "DMTEAM";
$cdTrack = 10;
$cdPlayMode = 1;
$Lightning = 0;
$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

function Game::playerSpawned(%pl, %clientId, %armor)
{	  
   //spawn base Infantry and health kit
   Player::setItemCount(%clientId,$ArmorName[%armor],1);
   Player::setItemCount(%clientId,Knife,1);
   Player::setItemCount(%clientId,SOCOM,1);
   Player::setItemCount(%clientId,SOCOMAmmo,50);
   Player::setItemCount(%clientId,OICW,1);
   Player::setItemCount(%clientId,OICWAmmo,150);
   Player::setItemCount(%clientId,RepairKit,1);
   Player::setItemCount(%clientId,Grenade,3);
   Player::setItemCount(%clientId,MineAmmo,2);

	Player::useItem(%pl,OICW);
   
   if($teamplay)
   {
      DMTEAM::checkMissionObjectives();
      DMTEAM::echoScores();
   }
}
function leaveMissionAreaDamage(%client)
{
	%player = Client::getOwnedObject(%client);
	if(%player.outArea == 1) {
		if(!Player::isDead(%player)) {
		  	Player::setDamageFlash(%client,0.1);
			GameBase::setDamageLevel(%player,GameBase::getDamageLevel(%player) + 0.25);
	   	schedule("leaveMissionAreaDamage(" @ %client @ ");",1);
		}
		else { 
			playNextAnim(%client);	
			Client::onKilled(%client, %client);
		}
	}
}
