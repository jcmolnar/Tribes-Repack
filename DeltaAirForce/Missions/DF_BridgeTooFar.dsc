$MDESC::Type = "DELTA FORCE";
$MDESC::Text = "<s3><f1>Mission Type: <f0> VIP Assassination" @
         "\n<f1>Location: <f0> Chad" @
         "\n<f1>Weather: <f0> Dry" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
"\n\n<f1><vServer::teamName0> Briefing:<f0> Your mission is to escort the V.I.P to the missile silo located beyond two canyons, deep within enemy territory. Sending an advance recon team to intercept and eliminate enemy attackers will help ensure your mission completion. The VIP is relying on your team to bring him safely through the hostile lands." @
"\n\n<f1>VIP Briefing:<f0> Your many years of training as a nuclear arms specialist are soon to be tested under extreme circumstances and conditions. The <f1><vServer::teamName0><f0> will escort you to the nuclear silo. Stay with the bodyguards. Latest intelligence indicates the presence of snipers operating in the area. When you reach your destination, disarm the missile by touching the <f2>Control Switch.<f0>" @
"\n\n<f1><vServer::teamName1> Briefing:<f0> Your abilities as a crack-shot are on the line, as a squad of uninvited guests have been spotted descending from the skies, infiltrating your country's soil. Stop the squad from reaching their destination, and you will be hailed as the People's Hero." @


"\n\n<f0>--- For use with the <f1>DELTA FORCE TRIBES<f0> modification. ---" @
"\n<f1>Map Notes:<f0> DF_BridgeTooFar_v0.5  11/11/00." @
"\nRedesigned by:<f1> ATM/NTDF Enigma <f0> Tweaked by:<f1> Thrax-THC-" @
"\n<f1>http://planetstarsiege.com/deltaforce/   <f0>email: <f1>thrax@whoever.com" ;

