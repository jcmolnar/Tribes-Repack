//--- export object end ---//
exec(objectives);
$hostageGame = 0;
exec(misrestart);
$Server::TeamDamageScale = 100;
$Server::timeLimit = 15;
$teamScoreLimit = 1;
$flagToStandTime = 600;	  
$DMScoreLimit = 0;
$Game::missionType = "DMTEAM";
$cdTrack = 10;
$cdPlayMode = 5;

$warmupBackup = $Server::warmupTime;
$Server::warmupTime = 30;

function Game::playerSpawned(%pl, %clientId, %armor)
{	  
   //spawn base Infantry and health kit
   Player::setItemCount(%clientId,$ArmorName[%armor],1);
   Player::setItemCount(%clientId,SOCOM,1);
   Player::setItemCount(%clientId,SOCOMAmmo,50);
   Player::setItemCount(%clientId,OICW,1);
   Player::setItemCount(%clientId,OICWAmmo,150);
   Player::setItemCount(%clientId,RepairKit,1);
   Player::setItemCount(%clientId,Grenade,3);
   Player::setItemCount(%clientId,MineAmmo,2);

	Player::useItem(%pl,OICW);
}

//Trigger message
function GroupTrigger::onEnter(%this, %object)
{
       %clientId = Player::getClient(%object);
       bottomprint(%clientId, "Take the Flag to the <f1>LandingZone<f0> for a successful rendezvous with <f1>Troop Transport Choppers<f0>. The <f1>LandingZone Beacon Flag<f0> must not fall into enemy hands. Failing this mission will prevent the Squad from being extracted safely.", 10);
}



//----------------------------------------
// MissionIntro::init(%clientId);
//---------------------------------------
function MissionIntro::init(%clientId)
{
schedule("centerprint(" @ %clientId @ ", \"<jc><f0>Mission Briefing for: <f1>DF_Ambushed_v0.2  <f0>Mission Type: <f1>Find and Retrieve\", 0);", 0);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 0);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Briefing:<f0> A small squad from the <f1><vServer::teamName0><f0> has become separated from the main platoon on its way to what was a <f1><vServer::teamName0><f0> controlled Landing Zone.\", 0);", 5);
	schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 5);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f0>The <f1><vServer::teamName1><f0> have set up an ambush in hopes of scavenging weapons and supplies from the unsuspecting soldiers.\", 5);", 10);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 10);
schedule("bottomprint(" @ %clientId @ ", \"<jc><f1>Victory Conditions:<f0>  The <f1><vServer::teamName0><f0> need to reach the <f1>Landing Zone<f0> with the <f1>LandingZoneBeacon Flag<f0> within <f1>15 minutes<f0> to rendezvous with Troop Transport Choppers to win the scenario.\", 10);",15);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 15);
schedule("bottomprint(" @ %clientId @ ", \"<jc>The <f1><vServer::teamName1><f0> defeats the rogue squad by intercepting the <f1>LandingZoneBeacon Flag<f0> and placing it in their Outpost Bunker.\", 15);", 20);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 20);
schedule("bottomprint(" @ %clientId @ ", \"<f1><jc> TEAM COOPERATION IS ESSENTIAL!!! \", 20);", 25);
      schedule("Client::sendMessage(" @ %clientId @ ", 0, \"~wshell_click.wav\");", 25);
}

